// A session keeps the model, the tokenizer and the KV cache. It reads requests from one file and
// writes replies to another, usually two named pipes. vxc does not give its standard input to the
// program that it runs, and it keeps the standard output of the program until the program ends.
// So neither can carry a conversation. A request gives the whole prompt as text. The session finds the longest prefix of its
// tokens that the KV cache already holds, and runs only the rest. The requests are:
//
//   generate STEPS BYTES\n and BYTES bytes of prompt text
//       The reply is the generated text, a NUL byte, and one line
//       `done prompt=… reused=… ran=… generated=… prompt_us=… us_per_token=…`.
//       STEPS 0 runs the prompt into the KV cache and generates nothing.
//   save PATH\n   writes the tokens of the KV cache and their rows of K and V, as f16, to a file.
//   load PATH\n   reads such a file back. Both answer `ok tokens=N`.
//
// A request that the session cannot do gets a NUL byte and a line that starts with `error`, and
// the session goes on. The session ends at the end of the file of requests. When it is ready, it
// writes `ready context=N` and a new line to the file of replies.
import core::convert;
import core::ptr;
import core::result;
import std::fs;
import std::libc;
import std::string;
import std::time;
import std::vec;
import qwen::weights;
import qwen::model;
import qwen::prefill;
import qwen::tokenizer;

/// The bytes "VXQKV001" at the start of a cache file, read as one little-endian i64.
const CACHE_MAGIC : i64 = 3544386053929523286;
/// Version 2 has rows of f16 values, as the KV cache holds them. Version 1 had f32.
const CACHE_VERSION : i64 = 2;
/// The i64 words of the header of a cache file.
const CACHE_HEADER_WORDS : i64 = 16;
/// The longest line of a request.
const LINE_BYTES : i64 = 4096;

struct Session {
  input : File,
  output : File,
  tokens : Vec<i32>,
  weights_bytes : i64,
  line : *mut i8,
}

/// The size in bytes of the file at `path`.
fn file_bytes(files : &Files, path : &String) -> i64 {
  let mut file = File::open(files, path, OpenMode::Read).expect("cannot open the weight file");
  return file.seek(0, 2);
}

/// Reads one line of `input` into `line`, without its new line, and ends it with a NUL byte.
/// Gives its length, or -1 at the end of the file.
fn read_line(input : &mut File, line : *mut i8) -> i64 {
  let mut n : i64 = 0;
  while true {
    let got = unsafe {
      input.read_raw(offset_mut(line, n) as *mut u8, 1 as u64)
    };
    if got == 0 as u64 {
      if n == 0 {
        return -1;
      }
      break;
    }
    if unsafe { line[n] } == 10 as i8 {
      break;
    }
    n = n + 1;
    assert(n < LINE_BYTES - 1, "a line of a request is too long");
  }
  unsafe { line[n] = 0 as i8; }
  return n;
}

/// Reads exactly `n` bytes of `input` into `buf`, which has room for `n + 1`, and ends them with a
/// NUL byte.
fn read_bytes(input : &mut File, buf : *mut i8, n : i64) -> void {
  let mut done : i64 = 0;
  while done < n {
    let got = unsafe {
      input.read_raw(offset_mut(buf, done) as *mut u8, (n - done) as u64)
    } as i64;
    assert(got > 0, "the input ended inside the text of a request");
    done = done + got;
  }
  unsafe { buf[n] = 0 as i8; }
  return;
}

/// Whether the C string `line` starts with the C string `word`.
fn starts_with(line : *const i8, word : *const i8) -> bool {
  let mut i : i64 = 0;
  while unsafe { word[i] } != 0 as i8 {
    if unsafe { line[i] } != unsafe { word[i] } {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// The number that starts at line[at], and in `end` the index after it. Asserts that one is there.
fn number_at(line : *const i8, at : i64, end : &mut i64) -> i64 {
  let mut i = at;
  let mut value : i64 = 0;
  let mut digits = 0;
  while unsafe { line[i] } >= 48 as i8 && unsafe { line[i] } <= 57 as i8 {
    value = value * 10 + (i32::from(unsafe { line[i] }) - 48) as i64;
    digits = digits + 1;
    i = i + 1;
  }
  assert(digits > 0, "a request needs a number here");
  *end = i;
  return value;
}

/// Writes the `n` bytes at `bytes` to `out`. Gives false when a write takes none of them.
fn write_bytes(out : &mut File, bytes : *const i8, n : i64) -> bool {
  let mut done : i64 = 0;
  while done < n {
    let wrote = unsafe {
      out.write_raw(offset(bytes, done) as *const u8, (n - done) as u64)
    } as i64;
    if wrote <= 0 {
      return false;
    }
    done = done + wrote;
  }
  return true;
}

/// Writes `n` bytes at `bytes` to the file of replies `out`, all of them.
fn out_bytes(out : &mut File, bytes : *const i8, n : i64) -> void {
  assert(write_bytes(out, bytes, n), "cannot write a reply");
  return;
}

/// Writes the C string `text` to `out`.
fn out_text(out : &mut File, text : *const i8) -> void {
  out_bytes(out, text, unsafe { string_length(text) } as i64);
  return;
}

/// Writes `value` in decimal to `out`.
fn out_number(out : &mut File, value : i64) -> void {
  let digits : *mut i8 = unsafe { malloc(24 as usize) };
  let mut v = value;
  let mut n : i64 = 0;
  if v < 0 {
    out_text(out, "-");
    v = 0 - v;
  }
  while n == 0 || v > 0 {
    unsafe { digits[23 - n] = (48 + (v % 10) as i32) as i8; }
    v = v / 10;
    n = n + 1;
  }
  out_bytes(out, offset(digits as *const i8, 24 - n), n);
  unsafe { free(digits); }
  return;
}

/// Writes the bytes of token `id` to `out`.
fn out_token(out : &mut File, t : &Tokenizer, id : i32) -> void {
  let first = unsafe { t.token_starts[id] } as i64;
  out_bytes(out, offset(t.token_bytes as *const i8, first), token_length(t, id));
  return;
}

/// Writes the NUL byte that ends the text of a reply. Its last line follows.
fn end_reply(out : &mut File) -> void {
  out_bytes(out, "", 1);
  return;
}

/// The length of the longest common prefix of `a` and `b`.
fn common_prefix(a : &Vec<i32>, b : &Vec<i32>) -> i32 {
  let mut n = 0;
  while n < a.len() && n < b.len() && a[n] == b[n] {
    n = n + 1;
  }
  return n;
}

/// The microseconds since `start`.
fn micros(start : &Instant) -> i64 {
  return (start.elapsed().as_secs_f32() * 1000000.0) as i64;
}

fn read_first(t : &Tensor<i32, [?], Memory::HBM>) -> i32 {
  let h = transfer(t, Memory::CPU_DRAM);
  return h[0];
}

/// generate STEPS BYTES: runs the part of the prompt that the KV cache does not hold, and
/// generates up to `steps` tokens.
fn generate(w : &Weights, s : &mut State, p : &mut Prefill, t : &Tokenizer, session : &mut Session, steps : i32, text : *const i8, length : i64) -> void {
  let start = Instant::now();
  let ids = encode(t, text, length);
  let count = ids.len();
  if count == 0 || count + steps > s.max_seq {
    end_reply(&mut session.output);
    out_text(&mut session.output, "error the prompt has ");
    out_number(&mut session.output, count as i64);
    out_text(&mut session.output, " tokens, and with ");
    out_number(&mut session.output, steps as i64);
    out_text(&mut session.output, " steps it does not fit in the context of ");
    out_number(&mut session.output, s.max_seq as i64);
    out_text(&mut session.output, "\n");
    return;
  }
  let mut reused = common_prefix(&session.tokens, &ids);
  // The logits of the last token give the first new token, so it runs again.
  if steps > 0 && reused == count {
    reused = count - 1;
  }
  if reused < count {
    run_prompt(w, s, p, &ids, reused);
  }
  session.tokens = ids;
  let mut next = transfer(Tensor<i32>([1]), Memory::HBM);
  let mut generated = 0;
  // Times in microseconds: an f64 set before the loop below crashes the prover of Vx v0.0.4.
  let mut prompt_us : i64 = 0;
  let mut decode_us : i64 = 0;
  if steps > 0 {
    predict(w, s, &mut next);
    let mut token = read_first(&next);
    prompt_us = micros(&start);
    let decode = Instant::now();
    let mut step = 0;
    while step < steps && !is_special(t, token) && token != w.config.eos_token_id {
      out_token(&mut session.output, t, token);
      generated = generated + 1;
      step = step + 1;
      if step < steps {
        run_layers(w, s, &next, session.tokens.len());
        session.tokens.push(token);
        predict(w, s, &mut next);
        token = read_first(&next);
      }
    }
    decode_us = micros(&decode);
  } else {
    prompt_us = micros(&start);
  }
  let mut per_token_us : i64 = 0;
  if generated > 1 {
    per_token_us = decode_us / (generated - 1) as i64;
  }
  let o = &mut session.output;
  end_reply(o);
  out_text(o, "done prompt=");
  out_number(o, count as i64);
  out_text(o, " reused=");
  out_number(o, reused as i64);
  out_text(o, " ran=");
  out_number(o, (count - reused) as i64);
  out_text(o, " generated=");
  out_number(o, generated as i64);
  out_text(o, " prompt_us=");
  out_number(o, prompt_us);
  out_text(o, " us_per_token=");
  out_number(o, per_token_us);
  out_text(o, "\n");
  return;
}

/// The header of a cache file: what the cache fits, so that a file fits only its model.
fn cache_header(w : &Weights, session : &Session, n : i64) -> Vec<i64> {
  let c = &w.config;
  let mut h = Vec<i64>::new();
  h.push(CACHE_MAGIC);
  h.push(CACHE_VERSION);
  h.push(n);
  h.push(c.num_layers as i64);
  h.push(c.num_kv_heads as i64);
  h.push(c.head_dim as i64);
  h.push(c.hidden_size as i64);
  h.push(c.vocab_size as i64);
  h.push(c.weight_format as i64);
  h.push(c.num_experts as i64);
  h.push(session.weights_bytes);
  while h.len() < CACHE_HEADER_WORDS as i32 {
    h.push(0);
  }
  return h;
}

/// Writes the first n rows of a cache tensor [max_seq, kv_heads, head_dim] to `f`.
fn write_rows(f : &mut File, cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, n : i32, kv_heads : i32, head_dim : i32) -> void {
  let h = transfer(cache, Memory::CPU_DRAM);
  let count = (n as i64) * (kv_heads as i64) * (head_dim as i64);
  let buf : *mut i8 = unsafe { malloc((count * 2) as usize) };
  let values : *mut f16 = buf;
  let mut i : i64 = 0;
  for r in 0..n {
    for k in 0..kv_heads {
      for d in 0..head_dim {
        unsafe { values[i] = h[r][k][d]; }
        i = i + 1;
      }
    }
  }
  assert(write_bytes(f, buf, count * 2), "cannot write the cache file");
  unsafe { free(buf); }
  return;
}

/// save PATH: the header, the tokens, and the rows of K and then V of each layer.
fn save_cache(files : &Files, w : &Weights, s : &State, session : &mut Session, path : &String) -> void {
  let c = &w.config;
  let n = session.tokens.len();
  let opened = File::open(files, path, OpenMode::Write);
  if opened.is_err() {
    end_reply(&mut session.output);
    out_text(&mut session.output, "error cannot open the cache file to write\n");
    return;
  }
  let mut f = opened.unwrap();
  let header = cache_header(w, session, n as i64);
  let words : *mut i8 = unsafe { malloc((CACHE_HEADER_WORDS * 8) as usize) };
  let hw : *mut i64 = words;
  for i in 0..header.len() {
    unsafe { hw[i] = header[i]; }
  }
  assert(write_bytes(&mut f, words, CACHE_HEADER_WORDS * 8), "cannot write the cache file");
  unsafe { free(words); }
  // The tokens, padded to a multiple of 2, so the rows start at a multiple of 8 bytes.
  let padded = (n + 1) / 2 * 2;
  let ids : *mut i8 = unsafe { malloc((padded * 4 + 8) as usize) };
  let iw : *mut i32 = ids;
  for i in 0..padded {
    if i < n {
      unsafe { iw[i] = session.tokens[i]; }
    } else {
      unsafe { iw[i] = 0; }
    }
  }
  assert(write_bytes(&mut f, ids, (padded as i64) * 4), "cannot write the cache file");
  unsafe { free(ids); }
  for cache in s.caches.iter() {
    write_rows(&mut f, &cache.k, n, c.num_kv_heads, c.head_dim);
    write_rows(&mut f, &cache.v, n, c.num_kv_heads, c.head_dim);
  }
  end_reply(&mut session.output);
  out_text(&mut session.output, "ok tokens=");
  out_number(&mut session.output, n as i64);
  out_text(&mut session.output, "\n");
  return;
}

/// A cache tensor [max_seq, kv_heads, head_dim] with the n rows at `values` and zeros after them.
fn read_rows(values : *mut f16, n : i32, max_seq : i32, kv_heads : i32, head_dim : i32) -> Tensor<f16, [?, ?, ?], Memory::HBM> {
  let mut h = Tensor<f16>([max_seq, kv_heads, head_dim]);
  let mut i : i64 = 0;
  for r in 0..n {
    for k in 0..kv_heads {
      for d in 0..head_dim {
        h[r][k][d] = unsafe { values[i] };
        i = i + 1;
      }
    }
  }
  return transfer(h, Memory::HBM);
}

/// load PATH: reads a file of `save_cache` into the KV cache, if it fits this model.
fn load_cache(files : &Files, w : &Weights, s : &mut State, session : &mut Session, path : &String) -> void {
  let c = &w.config;
  let opened = File::open(files, path, OpenMode::Read);
  if opened.is_err() {
    end_reply(&mut session.output);
    out_text(&mut session.output, "error cannot open the cache file to read\n");
    return;
  }
  let map = opened.unwrap().map().expect("cannot map the cache file into memory");
  let length = map.len();
  let base = map.as_ptr() as *mut i8;
  let words : *mut i64 = base;
  if length < CACHE_HEADER_WORDS * 8 || unsafe { words[0] } != CACHE_MAGIC || unsafe {
    words[1]
  } != CACHE_VERSION {
    end_reply(&mut session.output);
    out_text(&mut session.output, "error not a cache file of this version\n");
    return;
  }
  let n = unsafe { words[2] } as i32;
  let expected = cache_header(w, session, n as i64);
  let mut fits = n > 0 && n <= s.max_seq;
  for i in 0..CACHE_HEADER_WORDS as i32 {
    fits = fits && unsafe { words[i] } == expected[i];
  }
  let padded = (n + 1) / 2 * 2;
  let row = (c.num_kv_heads as i64) * (c.head_dim as i64);
  let bytes = CACHE_HEADER_WORDS * 8 + (padded as i64) * 4 + (c.num_layers as i64) * 2 * (n as i64) * row * 2;
  if !fits || length != bytes {
    end_reply(&mut session.output);
    out_text(&mut session.output, "error the cache file was made for another model or context\n");
    return;
  }
  let ids : *mut i32 = offset_mut(base, CACHE_HEADER_WORDS * 8);
  let mut tokens = Vec<i32>::new();
  for i in 0..n {
    tokens.push(unsafe { ids[i] });
  }
  let rows : *mut f16 = offset_mut(base, CACHE_HEADER_WORDS * 8 + (padded as i64) * 4);
  let mut at : i64 = 0;
  for cache in s.caches.iter_mut() {
    cache.k = read_rows(offset_mut(rows, at), n, s.max_seq, c.num_kv_heads, c.head_dim);
    at = at + (n as i64) * row;
    cache.v = read_rows(offset_mut(rows, at), n, s.max_seq, c.num_kv_heads, c.head_dim);
    at = at + (n as i64) * row;
  }
  session.tokens = tokens;
  end_reply(&mut session.output);
  out_text(&mut session.output, "ok tokens=");
  out_number(&mut session.output, n as i64);
  out_text(&mut session.output, "\n");
  return;
}

/// Answers the requests of the file at `requests` until it ends.
pub fn run_session(files : &Files, weights_path : &String, tokenizer_path : &String, requests : &String, replies : &String, context : i32) -> i32 {
  let t = load_tokenizer(files, tokenizer_path);
  let w = load_weights(files, weights_path);
  assert(context > 0 && context <= w.config.max_positions, "--context must be between 1 and the max_positions of the model");
  let mut s = new_state(&w.config, context);
  let mut p = new_prefill(&w.config, context, CHUNK);
  // The first pass over the weights takes seconds, so it runs before the first request. It leaves
  // row 0 of the cache, but no token, so the first request runs from position 0.
  let mut warm = Vec<i32>::new();
  warm.push(0);
  run_prompt(&w, &mut s, &mut p, &warm, 0);
  let mut next = transfer(Tensor<i32>([1]), Memory::HBM);
  predict(&w, &mut s, &mut next);
  let first = read_first(&next);
  assert(first >= 0, "the warm-up gave no token");
  // A named pipe opens when the client opens its other end, so these wait for the client.
  let mut output = File::open(files, replies, OpenMode::Write).expect("cannot open the file of replies");
  out_text(&mut output, "ready context=");
  out_number(&mut output, context as i64);
  out_text(&mut output, "\n");
  let input = File::open(files, requests, OpenMode::Read).expect("cannot open the file of requests");
  let mut session = Session {
    input: input,
    output: output,
    tokens: Vec<i32>::new(),
    weights_bytes: file_bytes(files, weights_path),
    line: unsafe { malloc(LINE_BYTES as usize) },
  };
  while true {
    let n = read_line(&mut session.input, session.line);
    if n < 0 {
      break;
    }
    let line = session.line;
    if starts_with(line, "generate ") {
      let mut end : i64 = 0;
      let steps = number_at(line, 9, &mut end);
      let bytes = number_at(line, end + 1, &mut end);
      let text : *mut i8 = unsafe { malloc((bytes + 1) as usize) };
      read_bytes(&mut session.input, text, bytes);
      generate(&w, &mut s, &mut p, &t, &mut session, steps as i32, text, bytes);
      unsafe { free(text); }
    } else if starts_with(line, "save ") {
      // read_line ends the line with a NUL byte.
      let path = unsafe { String::from_c_str(offset(line as *const i8, 5)) };
      save_cache(files, &w, &s, &mut session, &path);
    } else if starts_with(line, "load ") {
      let path = unsafe { String::from_c_str(offset(line as *const i8, 5)) };
      load_cache(files, &w, &mut s, &mut session, &path);
    } else if n > 0 {
      end_reply(&mut session.output);
      out_text(&mut session.output, "error unknown request: ");
      out_text(&mut session.output, line);
      out_text(&mut session.output, "\n");
    }
  }
  return 0;
}
