//===----------------------------------------------------------------------===//
// Loads the weight file that `scripts/convert.py` writes, and puts each tensor in GPU
// memory once. `scripts/qwen_weights.py` describes the format. A matrix of rows x cols
// is a rank-1 tensor with row r at r * cols, as the kernels of `std::nn` read it.
//
// The file is mapped read-only and shared, and each tensor starts a page of 16 KB. So the
// transfer of a view of a tensor to GPU memory makes no copy: the GPU reads the pages of the file
// cache. The file cache keeps one copy of the weights for all the runs.
import std::libc;
import std::mmap;
import std::vec;
import core::ptr;

extern {
  fn strlen(s : *const i8) -> i64;
  fn strcmp(a : *const i8, b : *const i8) -> i32;
}

/// The bytes "VXQWEN01" at the start of the file, read as one little-endian i64.
const MAGIC : i64 = 3544418966465239126;
// Version 1 has room for 16 config integers, and version 2, which arch 1 uses, for 32.
const VERSION_1 : i64 = 1;
const VERSION_2 : i64 = 2;
// Qwen3.5 MoE, which Qwen3.6 also uses. arch 0 is Qwen2 and Qwen3 MoE.
const ARCH_QWEN35 : i32 = 1;
const ENTRY_WORDS : i64 = 16;
const F32 : i64 = 0;
const BF16 : i64 = 1;
const F8E4M3 : i64 = 2;
const F16 : i64 = 3;
const U4 : i64 = 4;
const U2 : i64 = 5;
/// The dtype of a 6-bit matrix in a `WeightMatrix`. The file holds such a matrix as three tensors:
/// its low 4 bits (U4), its high 2 bits (U2) and its scales (F16).
const U6 : i64 = 6;
/// An fp8 matrix has one f32 scale for each block of BLOCK x BLOCK weights.
const BLOCK : i32 = 128;
/// A Q4_0 or 6-bit matrix has one f16 scale for each GROUP weights of a row.
const GROUP : i32 = 32;
/// The weight formats of a file, as in `qwen_weights.py`.
const FORMAT_BF16 : i32 = 0;
const FORMAT_FP8 : i32 = 1;
const FORMAT_Q4_0 : i32 = 2;
/// As FORMAT_Q4_0, with a 6-bit lm_head.
const FORMAT_Q4_0_Q6 : i32 = 3;

/// The model's sizes and constants, from the header of the weight file.
struct Config {
  hidden_size : i32,
  intermediate_size : i32,
  num_layers : i32,
  num_q_heads : i32,
  num_kv_heads : i32,
  head_dim : i32,
  vocab_size : i32,
  max_positions : i32,
  tied_embeddings : bool,
  qkv_bias : bool,
  eos_token_id : i32,
  weight_format : i32,
  // 0 for a dense model.
  num_experts : i32,
  experts_per_token : i32,
  moe_intermediate_size : i32,
  // Whether an RMSNorm over each head of Q and of K comes before RoPE.
  qk_norm : bool,
  // The fields from here to rotary_dim are in a version 2 file only, and 0 in a version 1 file.
  arch : i32,
  // In arch 1, layer l has full attention when (l + 1) % full_attention_interval is 0, and a
  // Gated DeltaNet otherwise.
  full_attention_interval : i32,
  linear_k_heads : i32,
  linear_v_heads : i32,
  linear_k_dim : i32,
  linear_v_dim : i32,
  conv_width : i32,
  shared_expert_inter : i32,
  // RoPE turns the first rotary_dim values of each head: head_dim in a version 1 file.
  rotary_dim : i32,
  // The MTP layers of an arch 1 model: 0 or 1, and 0 in a file without them.
  mtp_layers : i32,
  rope_theta : f64,
  rms_norm_eps : f64,
}

/// A weight matrix in GPU memory, in the form that `dtype` names:
/// - BF16 fills `bf16`.
/// - F8E4M3 fills `codes`, with 4 codes in each u32 word, and `scales`, with one f32 for each
///   block of 128 x 128.
/// - U4 fills `codes`, with 8 Q4_0 codes in each word, and `group_scales`, with one f16 for each
///   32 weights of a row.
/// - U6 fills `codes` with the low 4 bits of the codes, as U4, `high` with their high 2 bits, 16
///   in each word, from its low bits up, and `group_scales` as U4. A weight is (code - 32) times
///   its scale.
/// The fields that the form does not use hold one row of zeros.
struct WeightMatrix {
  dtype : i64,
  bf16 : Tensor<bf16, [?], Memory::HBM>,
  codes : Tensor<u32, [?], Memory::HBM>,
  high : Tensor<u32, [?], Memory::HBM>,
  scales : Tensor<f32, [?], Memory::HBM>,
  group_scales : Tensor<f16, [?], Memory::HBM>,
}

/// The weights of one decoder layer, in GPU memory. `qkv` has the Q rows, then the K rows,
/// then the V rows, and `gate_up` has the gate rows, then the up rows. A model with no bias on
/// Q, K and V gets a `qkv_bias` of zeros. In a mixture-of-experts model, `router` has one row
/// for each expert, and `gate_up` and `down` hold all the experts, expert e after expert e - 1.
/// The tensors that a model does not have hold one row of zeros.
struct Layer {
  attn_norm : Tensor<bf16, [?], Memory::HBM>,
  qkv : WeightMatrix,
  qkv_bias : Tensor<bf16, [?], Memory::HBM>,
  q_norm : Tensor<bf16, [?], Memory::HBM>,
  k_norm : Tensor<bf16, [?], Memory::HBM>,
  attn_out : WeightMatrix,
  mlp_norm : Tensor<bf16, [?], Memory::HBM>,
  router : Tensor<bf16, [?], Memory::HBM>,
  gate_up : WeightMatrix,
  down : WeightMatrix,
}

/// All the weights of a model, in GPU memory. A model with tied embeddings uses `embed` as its
/// output projection, and its `lm_head` holds only rows of zeros. An fp8 or Q4_0 file has its
/// own `lm_head`, also for such a model.
struct Weights {
  config : Config,
  embed : Tensor<bf16, [?], Memory::HBM>,
  layers : Vec<Layer>,
  final_norm : Tensor<bf16, [?], Memory::HBM>,
  lm_head : WeightMatrix,
}

/// The weights of one layer of an arch 1 model (Qwen3.5 MoE), in GPU memory. Each norm except
/// `linear_norm` holds 1 + w as f32, so that a plain RMSNorm multiplies by it. A layer with full
/// attention fills the fields up to `attn_out`, and a Gated DeltaNet layer the fields from
/// `linear_in` to `linear_out`. The other ones hold one row of zeros.
struct Qwen35Layer {
  full_attention : bool,
  attn_norm : Tensor<f32, [?], Memory::HBM>,
  // The rows of q, k and v, then the rows of the gate of each query head.
  qkv : WeightMatrix,
  q_norm : Tensor<f32, [?], Memory::HBM>,
  k_norm : Tensor<f32, [?], Memory::HBM>,
  attn_out : WeightMatrix,
  // The rows of q, k, v, z, b and a.
  linear_in : WeightMatrix,
  // The causal convolution of q, k and v: channel c at c * conv_width, and its last value
  // multiplies the current token.
  conv : Tensor<f32, [?], Memory::HBM>,
  neg_a : Tensor<f32, [?], Memory::HBM>,
  dt_bias : Tensor<f32, [?], Memory::HBM>,
  // The RMSNorm of each head of the output. It holds w, not 1 + w.
  linear_norm : Tensor<f32, [?], Memory::HBM>,
  linear_out : WeightMatrix,
  mlp_norm : Tensor<f32, [?], Memory::HBM>,
  // One row for each expert, then the gate of the shared expert.
  router : Tensor<bf16, [?], Memory::HBM>,
  gate_up : WeightMatrix,
  down : WeightMatrix,
  shared_gate_up : WeightMatrix,
  shared_down : WeightMatrix,
}

/// The multi-token prediction (MTP) layer of an arch 1 model, which predicts the token after the
/// next one. Its input is the embedding of a token and the hidden state h of the position before
/// it, after final_norm. `fc` takes the two norms, the embedding first, and `layer` has full
/// attention. The norms hold 1 + w, as those of a layer.
struct Mtp35 {
  embed_norm : Tensor<f32, [?], Memory::HBM>,
  hidden_norm : Tensor<f32, [?], Memory::HBM>,
  fc : WeightMatrix,
  layer : Qwen35Layer,
  final_norm : Tensor<f32, [?], Memory::HBM>,
}

/// All the weights of an arch 1 model, in GPU memory. `mtp` has the MTP layer of a file with
/// mtp_layers = 1, and is empty otherwise.
struct Qwen35Weights {
  config : Config,
  embed : Tensor<bf16, [?], Memory::HBM>,
  layers : Vec<Qwen35Layer>,
  final_norm : Tensor<f32, [?], Memory::HBM>,
  lm_head : WeightMatrix,
  mtp : Vec<Mtp35>,
}

/// A weight file mapped into memory, and the position of the next tensor to load.
struct Reader {
  base : *mut i8,
  size : i64,
  table : i64,
  count : i64,
  next : i64,
  fd : i32,
  version : i64,
}

/// The i64 word at `index` of the file.
fn word(r : &Reader, index : i64) -> i64 {
  let words : *mut i64 = r.base;
  return unsafe { words[index] };
}

/// Checks the next tensor and moves past it. Asserts that its name ends with `kind`, that it is
/// of `dtype` with `bits` bits for each value, and that its shape is `rows` x `cols`, or [rows]
/// when `cols` is 0. Returns the byte offset of its data in the file.
fn next_tensor(r : &mut Reader, kind : *const i8, dtype : i64, bits : i64, rows : i32, cols : i32) -> i64 {
  assert(r.next < r.count, "the weight file has fewer tensors than the config needs");
  let entry = r.table / 8 + r.next * ENTRY_WORDS;
  let name : *mut i8 = offset_mut(r.base, entry * 8);
  let length = unsafe { strlen(name) };
  let kind_length = unsafe { strlen(kind) };
  assert(length >= kind_length, "a tensor of the weight file is not the one the config needs next");
  let tail : *mut i8 = offset_mut(name, length - kind_length);
  assert(unsafe { strcmp(tail, kind) } == 0, "a tensor of the weight file is not the one the config needs next");

  let rank : i64 = if cols == 0 {
    1
  } else {
    2
  };
  assert(word(r, entry + 8) == dtype, "a tensor of the weight file has another dtype than the config needs");
  assert(word(r, entry + 9) == rank, "a tensor of the weight file has the wrong rank");
  assert(word(r, entry + 10) == rows as i64, "a tensor of the weight file has the wrong number of rows");
  assert(rank == 1 || word(r, entry + 11) == cols as i64, "a tensor of the weight file has the wrong number of columns");
  let count = values(rows, cols);
  let offset = word(r, entry + 14);
  let bytes = word(r, entry + 15);
  assert(bytes * 8 == count * bits && offset >= 0 && offset + bytes <= r.size, "a tensor of the weight file is outside the file");
  assert(count < 2147483648, "a tensor of the weight file has 2^31 values or more");
  r.next = r.next + 1;
  return offset;
}

/// The number of values of a tensor of `rows` x `cols`, or of [rows] when `cols` is 0.
fn values(rows : i32, cols : i32) -> i64 {
  if cols == 0 {
    return rows as i64;
  }
  return (rows as i64) * (cols as i64);
}

/// Puts the next tensor, of bf16 values, in GPU memory.
fn load_next(r : &mut Reader, kind : *const i8, rows : i32, cols : i32) -> Tensor<bf16, [?], Memory::HBM> {
  let offset = next_tensor(r, kind, BF16, 16, rows, cols);
  let count = values(rows, cols);
  let p : *mut bf16 = offset_mut(r.base, offset);
  let view = unsafe { tensor_view_1d(p as *const bf16, count as i32) };
  return transfer(&view, Memory::HBM);
}

/// Puts the next tensor, of f8e4m3, u4 or u2 codes, in GPU memory as u32 words. Word i holds
/// the 4 codes from 4 * i, one in each byte, the 8 u4 codes from 8 * i, or the 16 u2 codes from
/// 16 * i, from its low bits up.
fn load_codes(r : &mut Reader, kind : *const i8, dtype : i64, rows : i32, cols : i32) -> Tensor<u32, [?], Memory::HBM> {
  let bits : i64 = if dtype == U4 {
    4
  } else if dtype == U2 {
    2
  } else {
    8
  };
  let offset = next_tensor(r, kind, dtype, bits, rows, cols);
  let count = values(rows, cols);
  assert(count * bits % 32 == 0, "a matrix of codes is not a whole number of u32 words");
  let p : *mut u32 = offset_mut(r.base, offset);
  let view = unsafe { tensor_view_1d(p as *const u32, (count * bits / 32) as i32) };
  return transfer(&view, Memory::HBM);
}

/// Puts the next tensor, of f16 values, in GPU memory.
fn load_f16(r : &mut Reader, kind : *const i8, rows : i32, cols : i32) -> Tensor<f16, [?], Memory::HBM> {
  let offset = next_tensor(r, kind, F16, 16, rows, cols);
  let count = values(rows, cols);
  let p : *mut f16 = offset_mut(r.base, offset);
  let view = unsafe { tensor_view_1d(p as *const f16, count as i32) };
  return transfer(&view, Memory::HBM);
}

/// Puts the next tensor, of f32 values, in GPU memory: scales, or a norm or other small tensor
/// of arch 1.
fn load_scales(r : &mut Reader, kind : *const i8, rows : i32, cols : i32) -> Tensor<f32, [?], Memory::HBM> {
  let offset = next_tensor(r, kind, F32, 32, rows, cols);
  let count = values(rows, cols);
  let p : *mut f32 = offset_mut(r.base, offset);
  let view = unsafe { tensor_view_1d(p as *const f32, count as i32) };
  return transfer(&view, Memory::HBM);
}

/// The dtype of the weight matrices of a file in `weight_format`. lm_head is f8e4m3 in a Q4_0 file,
/// and 6-bit in a Q4_0_Q6 file.
fn matrix_dtype(weight_format : i32, lm_head : bool) -> i64 {
  if weight_format == FORMAT_Q4_0_Q6 && lm_head {
    return U6;
  }
  if (weight_format == FORMAT_Q4_0 || weight_format == FORMAT_Q4_0_Q6) && !lm_head {
    return U4;
  }
  if weight_format == FORMAT_BF16 {
    return BF16;
  }
  return F8E4M3;
}

/// Loads the next weight matrix of `rows` x `cols` of `dtype`: bf16 values, or codes and then
/// the tensor `scale_kind` of their scales.
fn load_matrix(r : &mut Reader, dtype : i64, kind : *const i8, scale_kind : *const i8, rows : i32, cols : i32) -> WeightMatrix {
  if dtype == U4 {
    assert(cols % GROUP == 0, "a Q4_0 matrix must have a whole number of groups in each row");
    let codes = load_codes(r, kind, U4, rows, cols);
    let scales = load_f16(r, scale_kind, rows, cols / GROUP);
    return WeightMatrix {
      dtype: U4, bf16: zeros(8), codes: codes, high: zero_words(8), scales: zero_scales(8), group_scales: scales
    };
  }
  if dtype == U6 {
    assert(cols % GROUP == 0, "a 6-bit matrix must have a whole number of groups in each row");
    let codes = load_codes(r, kind, U4, rows, cols);
    let high = load_codes(r, ".high", U2, rows, cols);
    let scales = load_f16(r, scale_kind, rows, cols / GROUP);
    return WeightMatrix {
      dtype: U6, bf16: zeros(8), codes: codes, high: high, scales: zero_scales(8), group_scales: scales
    };
  }
  if dtype == F8E4M3 {
    let codes = load_codes(r, kind, F8E4M3, rows, cols);
    let scales = load_scales(r, scale_kind, (rows + BLOCK - 1) / BLOCK, (cols + BLOCK - 1) / BLOCK);
    return WeightMatrix {
      dtype: F8E4M3, bf16: zeros(8), codes: codes, high: zero_words(8), scales: scales, group_scales: zero_f16(8)
    };
  }
  let values = load_next(r, kind, rows, cols);
  return WeightMatrix {
    dtype: BF16, bf16: values, codes: zero_words(8), high: zero_words(8), scales: zero_scales(8), group_scales: zero_f16(8)
  };
}

/// One row of zeros in GPU memory, for a tensor that a model does not have.
fn zeros(n : i32) -> Tensor<bf16, [?], Memory::HBM> {
  return transfer(Tensor<bf16>([n]), Memory::HBM);
}

/// `zeros` for f8e4m3 codes.
fn zero_words(n : i32) -> Tensor<u32, [?], Memory::HBM> {
  return transfer(Tensor<u32>([n]), Memory::HBM);
}

/// `zeros` for scales.
fn zero_scales(n : i32) -> Tensor<f32, [?], Memory::HBM> {
  return transfer(Tensor<f32>([n]), Memory::HBM);
}

/// `zeros` for f16 scales.
fn zero_f16(n : i32) -> Tensor<f16, [?], Memory::HBM> {
  return transfer(Tensor<f16>([n]), Memory::HBM);
}

/// Whether `p` is MAP_FAILED, the address -1 that mmap gives when it fails.
fn map_failed(p : *mut i8) -> bool {
  let failed : *mut i8 = offset_mut(unsafe { 0 as *mut i8 }, -1);
  return eq(p as *const i8, failed as *const i8);
}

/// Maps the weight file at `path` into memory, and checks its magic word and version.
fn open_weight_file(path : *const i8) -> Reader {
  let fd : i32 = unsafe { open(path, 0) };
  assert(fd >= 0, "cannot open the weight file");
  let size : i64 = unsafe { lseek(fd, 0, 2) };
  assert(size > 0, "cannot read the size of the weight file");
  let base : *mut i8 = unsafe { mmap(0 as *mut i8, size, 1, 1, fd, 0) };
  assert(!map_failed(base), "cannot map the weight file into memory");
  let mut r = Reader {
    base: base, size: size, table: 0, count: 0, next: 0, fd: fd, version: 0
  };
  assert(size >= 4096 && word(&r, 0) == MAGIC, "this is not a weight file of the Qwen app");
  r.version = word(&r, 1);
  assert(r.version == VERSION_1 || r.version == VERSION_2, "the weight file has another format version");
  r.count = word(&r, 2);
  r.table = word(&r, 4);
  return r;
}

/// Unmaps the weight file. The tensors in GPU memory stay.
fn close_weight_file(r : &Reader) -> void {
  unsafe { munmap(r.base, r.size); close(r.fd); }
  return;
}

/// Config integer `index` of a version 2 file, or `otherwise` in a version 1 file, which has no
/// room for it.
fn v2_int(r : &Reader, index : i64, otherwise : i32) -> i32 {
  if r.version == VERSION_1 {
    return otherwise;
  }
  return word(r, 5 + index) as i32;
}

/// The config in the header of the weight file.
fn read_config(r : &Reader) -> Config {
  let floats : *mut f64 = r.base;
  // Words 5 and up hold the config integers, and the two f64 values follow the room for them.
  let floats_at : i64 = if r.version == VERSION_1 {
    5 + 16
  } else {
    5 + 32
  };
  let head_dim = word(r, 10) as i32;
  let config = Config {
    hidden_size: word(r, 5) as i32,
    intermediate_size: word(r, 6) as i32,
    num_layers: word(r, 7) as i32,
    num_q_heads: word(r, 8) as i32,
    num_kv_heads: word(r, 9) as i32,
    head_dim: head_dim,
    vocab_size: word(r, 11) as i32,
    max_positions: word(r, 12) as i32,
    tied_embeddings: word(r, 13) != 0,
    qkv_bias: word(r, 14) != 0,
    eos_token_id: word(r, 15) as i32,
    weight_format: word(r, 16) as i32,
    num_experts: word(r, 17) as i32,
    experts_per_token: word(r, 18) as i32,
    moe_intermediate_size: word(r, 19) as i32,
    qk_norm: word(r, 20) != 0,
    arch: v2_int(r, 16, 0),
    full_attention_interval: v2_int(r, 17, 0),
    linear_k_heads: v2_int(r, 18, 0),
    linear_v_heads: v2_int(r, 19, 0),
    linear_k_dim: v2_int(r, 20, 0),
    linear_v_dim: v2_int(r, 21, 0),
    conv_width: v2_int(r, 22, 0),
    shared_expert_inter: v2_int(r, 24, 0),
    rotary_dim: v2_int(r, 23, head_dim),
    mtp_layers: v2_int(r, 25, 0),
    rope_theta: unsafe { floats[floats_at] },
    rms_norm_eps: unsafe { floats[floats_at + 1] },
  };
  assert(config.weight_format >= FORMAT_BF16 && config.weight_format <= FORMAT_Q4_0_Q6, "the weight file has an unknown weight format");
  assert(config.num_experts == 0 || (config.experts_per_token > 0 && config.experts_per_token <= config.num_experts), "a model must use between 1 and all of its experts for each token");
  assert((r.version == VERSION_2) == (config.arch == ARCH_QWEN35), "an arch 1 model needs a version 2 file, and only it");
  assert(config.mtp_layers == 0 || config.mtp_layers == 1, "a model can have at most one MTP layer");
  return config;
}

/// The arch of the model in the weight file at `path`: 0 for `load_weights`, and 1 for
/// `load_qwen35_weights`. It reads only the header.
fn weight_file_arch(path : *const i8) -> i32 {
  let r = open_weight_file(path);
  let arch = read_config(&r).arch;
  close_weight_file(&r);
  return arch;
}

/// A weight matrix that a layer does not have: one row of bf16 zeros.
fn empty_matrix() -> WeightMatrix {
  return WeightMatrix {
    dtype: BF16, bf16: zeros(8), codes: zero_words(8), high: zero_words(8), scales: zero_scales(8), group_scales: zero_f16(8)
  };
}

/// Loads the weight file at `path`, of an arch 1 model, into GPU memory.
fn load_qwen35_weights(path : *const i8) -> Qwen35Weights {
  let mut r = open_weight_file(path);
  let config = read_config(&r);
  assert(config.arch == ARCH_QWEN35, "this weight file is not of a Qwen3.5 MoE model; use load_weights");
  assert(config.full_attention_interval > 0 && config.num_experts > 0 && config.shared_expert_inter > 0, "a Qwen3.5 MoE model has full attention layers, experts and a shared expert");
  assert(config.linear_k_heads > 0 && config.linear_v_heads % config.linear_k_heads == 0, "each key head of a Gated DeltaNet must serve the same number of value heads");
  assert(!config.tied_embeddings, "a Qwen3.5 MoE weight file has its own lm_head");
  let hidden = config.hidden_size;
  let dtype = matrix_dtype(config.weight_format, false);
  let embed = load_next(&mut r, "embed", config.vocab_size, hidden);
  let mut layers = Vec<Qwen35Layer>::new();
  for l in 0..config.num_layers {
    layers.push(load_qwen35_layer(&mut r, &config, dtype, (l + 1) % config.full_attention_interval == 0));
  }
  let final_norm = load_scales(&mut r, "final_norm", hidden, 0);
  let lm_head = load_matrix(&mut r, matrix_dtype(config.weight_format, true), "lm_head", "lm_head.scale", config.vocab_size, hidden);
  let mut mtp = Vec<Mtp35>::new();
  if config.mtp_layers == 1 {
    let embed_norm = load_scales(&mut r, "mtp.embed_norm", hidden, 0);
    let hidden_norm = load_scales(&mut r, "mtp.hidden_norm", hidden, 0);
    let fc = load_matrix(&mut r, dtype, "mtp.fc", "mtp.fc.scale", hidden, 2 * hidden);
    let layer = load_qwen35_layer(&mut r, &config, dtype, true);
    mtp.push(Mtp35 {
      embed_norm: embed_norm,
      hidden_norm: hidden_norm,
      fc: fc,
      layer: layer,
      final_norm: load_scales(&mut r, "mtp.final_norm", hidden, 0),
    });
  }
  assert(r.next == r.count, "the weight file has more tensors than the config needs");
  close_weight_file(&r);
  return Qwen35Weights {
    config: config, embed: embed, layers: layers, final_norm: final_norm, lm_head: lm_head, mtp: mtp
  };
}

/// Loads the next layer of an arch 1 model, with full attention or a Gated DeltaNet. The tensors
/// come in file order: those of the attention or the Gated DeltaNet, then those of the experts.
fn load_qwen35_layer(r : &mut Reader, config : &Config, dtype : i64, full : bool) -> Qwen35Layer {
  let hidden = config.hidden_size;
  let head_dim = config.head_dim;
  let heads = config.num_q_heads;
  let k_total = config.linear_k_heads * config.linear_k_dim;
  let v_heads = config.linear_v_heads;
  let v_total = v_heads * config.linear_v_dim;
  let experts = config.num_experts;
  let moe_inter = config.moe_intermediate_size;
  let shared = config.shared_expert_inter;
  let attn_norm = load_scales(r, ".attn_norm", hidden, 0);
  let qkv = if full {
    load_matrix(r, dtype, ".qkv", ".qkv.scale", 2 * heads * head_dim + 2 * config.num_kv_heads * head_dim, hidden)
  } else {
    empty_matrix()
  };
  let q_norm = if full {
    load_scales(r, ".q_norm", head_dim, 0)
  } else {
    zero_scales(8)
  };
  let k_norm = if full {
    load_scales(r, ".k_norm", head_dim, 0)
  } else {
    zero_scales(8)
  };
  let attn_out = if full {
    load_matrix(r, dtype, ".attn_out", ".attn_out.scale", hidden, heads * head_dim)
  } else {
    empty_matrix()
  };
  let linear_in = if full {
    empty_matrix()
  } else {
    load_matrix(r, dtype, ".linear_in", ".linear_in.scale", 2 * k_total + 2 * v_total + 2 * v_heads, hidden)
  };
  let conv = if full {
    zero_scales(8)
  } else {
    load_scales(r, ".conv", 2 * k_total + v_total, config.conv_width)
  };
  let neg_a = if full {
    zero_scales(8)
  } else {
    load_scales(r, ".neg_A", v_heads, 0)
  };
  let dt_bias = if full {
    zero_scales(8)
  } else {
    load_scales(r, ".dt_bias", v_heads, 0)
  };
  let linear_norm = if full {
    zero_scales(8)
  } else {
    load_scales(r, ".linear_norm", config.linear_v_dim, 0)
  };
  let linear_out = if full {
    empty_matrix()
  } else {
    load_matrix(r, dtype, ".linear_out", ".linear_out.scale", hidden, v_total)
  };
  let mlp_norm = load_scales(r, ".mlp_norm", hidden, 0);
  let router = load_next(r, ".router", experts + 1, hidden);
  let gate_up = load_matrix(r, dtype, ".experts_gate_up", ".experts_gate_up.scale", experts * 2 * moe_inter, hidden);
  let down = load_matrix(r, dtype, ".experts_down", ".experts_down.scale", experts * hidden, moe_inter);
  let shared_gate_up = load_matrix(r, dtype, ".shared_gate_up", ".shared_gate_up.scale", 2 * shared, hidden);
  let shared_down = load_matrix(r, dtype, ".shared_down", ".shared_down.scale", hidden, shared);
  return Qwen35Layer {
    full_attention: full,
    attn_norm: attn_norm,
    qkv: qkv,
    q_norm: q_norm,
    k_norm: k_norm,
    attn_out: attn_out,
    linear_in: linear_in,
    conv: conv,
    neg_a: neg_a,
    dt_bias: dt_bias,
    linear_norm: linear_norm,
    linear_out: linear_out,
    mlp_norm: mlp_norm,
    router: router,
    gate_up: gate_up,
    down: down,
    shared_gate_up: shared_gate_up,
    shared_down: shared_down,
  };
}

/// Loads the weight file at `path`, of an arch 0 model, into GPU memory.
fn load_weights(path : *const i8) -> Weights {
  let mut r = open_weight_file(path);
  let config = read_config(&r);
  assert(config.arch == 0, "this weight file is of a Qwen3.5 MoE model; use load_qwen35_weights");

  let hidden = config.hidden_size;
  let q_rows = config.num_q_heads * config.head_dim;
  let qkv_rows = q_rows + 2 * config.num_kv_heads * config.head_dim;
  let inter = config.intermediate_size;
  let experts = config.num_experts;
  let moe_inter = config.moe_intermediate_size;
  let dtype = matrix_dtype(config.weight_format, false);
  let embed = load_next(&mut r, "embed", config.vocab_size, hidden);
  let mut layers = Vec<Layer>::new();
  for l in 0..config.num_layers {
    let attn_norm = load_next(&mut r, ".attn_norm", hidden, 0);
    let qkv = load_matrix(&mut r, dtype, ".qkv", ".qkv.scale", qkv_rows, hidden);
    let qkv_bias = if config.qkv_bias {
      load_next(&mut r, ".qkv_bias", qkv_rows, 0)
    } else {
      zeros(qkv_rows)
    };
    let q_norm = if config.qk_norm {
      load_next(&mut r, ".q_norm", config.head_dim, 0)
    } else {
      zeros(8)
    };
    let k_norm = if config.qk_norm {
      load_next(&mut r, ".k_norm", config.head_dim, 0)
    } else {
      zeros(8)
    };
    let attn_out = load_matrix(&mut r, dtype, ".attn_out", ".attn_out.scale", hidden, q_rows);
    let mlp_norm = load_next(&mut r, ".mlp_norm", hidden, 0);
    let router = if experts > 0 {
      load_next(&mut r, ".router", experts, hidden)
    } else {
      zeros(8)
    };
    let gate_up = if experts > 0 {
      load_matrix(&mut r, dtype, ".experts_gate_up", ".experts_gate_up.scale", experts * 2 * moe_inter, hidden)
    } else {
      load_matrix(&mut r, dtype, ".gate_up", ".gate_up.scale", 2 * inter, hidden)
    };
    let down = if experts > 0 {
      load_matrix(&mut r, dtype, ".experts_down", ".experts_down.scale", experts * hidden, moe_inter)
    } else {
      load_matrix(&mut r, dtype, ".down", ".down.scale", hidden, inter)
    };
    layers.push(Layer {
      attn_norm: attn_norm,
      qkv: qkv,
      qkv_bias: qkv_bias,
      q_norm: q_norm,
      k_norm: k_norm,
      attn_out: attn_out,
      mlp_norm: mlp_norm,
      router: router,
      gate_up: gate_up,
      down: down,
    });
  }
  let final_norm = load_next(&mut r, "final_norm", hidden, 0);
  assert(config.weight_format == FORMAT_BF16 || !config.tied_embeddings, "an fp8 or Q4_0 weight file must have its own lm_head");
  let lm_head = if config.tied_embeddings {
    empty_matrix()
  } else {
    load_matrix(&mut r, matrix_dtype(config.weight_format, true), "lm_head", "lm_head.scale", config.vocab_size, hidden)
  };
  assert(r.next == r.count, "the weight file has more tensors than the config needs");
  close_weight_file(&r);
  return Weights {
    config: config, embed: embed, layers: layers, final_norm: final_norm, lm_head: lm_head
  };
}
