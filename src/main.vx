//===----------------------------------------------------------------------===//
// Generates tokens with greedy decoding, on the GPU:
//
//   vxc -O2 src/main.vx --package qwen=src --host default \
//       --machine ~/.vx/current/fleet/m4-uma.vx -- WEIGHTS --tokens 750,75698,1445 --steps 16
//   vxc src/main.vx ... -- WEIGHTS --tokenizer TOKENIZER --prompt "def fibonacci(n):" --steps 64
//   vxc src/main.vx ... -- WEIGHTS --tokenizer TOKENIZER --chat --prompt-file FILE --steps 512
//
// With --tokens, it prints the lines that `scripts/reference.py` prints, without the margin, and
// then the time of a token. `scripts/compare.py` compares the two outputs.
//
// With --tokenizer, a file of `scripts/convert_tokenizer.py`, the prompt is text: --prompt TEXT or
// --prompt-file FILE. The program prints the prompt and the text that it generates. It stops at a
// special token, such as <|im_end|>, or after --steps tokens. --chat puts the prompt in the chat
// format of the Instruct models and prints only the reply. --lines prints the lines of --tokens
// in place of the text. Qwen3.5 and Qwen3.6 think before they reply by default; with --chat, the
// prompt turns the thinking off, as the chat template does with enable_thinking=false, unless
// --think is given.
import core::convert;
import std::time;
import std::vec;
import qwen::weights;
import qwen::model;
import qwen::qwen35;
import qwen::prefill35;
import qwen::prefill;
import qwen::session;
import qwen::speculate;
import qwen::round;
import qwen::round35;
import qwen::tokenizer;

/// The options of the command line.
struct Options {
  weights : *const i8,
  tokens : *const i8,
  tokenizer : *const i8,
  prompt : *const i8,
  prompt_file : *const i8,
  steps : *const i8,
  has_tokens : bool,
  has_tokenizer : bool,
  has_prompt : bool,
  has_prompt_file : bool,
  has_steps : bool,
  context : *const i8,
  has_context : bool,
  requests : *const i8,
  has_requests : bool,
  replies : *const i8,
  has_replies : bool,
  session : bool,
  chat : bool,
  lines : bool,
  draft : *const i8,
  has_draft : bool,
  think : bool,
}

/// The options of `argv`. Asserts that they are complete and that they fit together.
fn parse_options(argc : i32, argv : *mut *mut i8) -> Options {
  assert(argc >= 4, "give: WEIGHTS --tokens 1,2,3 --steps N, or WEIGHTS --tokenizer FILE (--prompt TEXT | --prompt-file FILE) [--chat] [--lines] --steps N");
  let empty : *const i8 = "";
  let mut o = Options {
    weights: unsafe { argv[1] }, tokens: empty, tokenizer: empty, prompt: empty, prompt_file: empty,
    steps: empty, has_tokens: false, has_tokenizer: false, has_prompt: false, has_prompt_file: false,
    has_steps: false, context: empty, has_context: false, requests: empty, has_requests: false, replies: empty, has_replies: false, session: false, chat: false, lines: false, draft: empty, has_draft: false, think: false,
  };
  let mut i = 2;
  while i < argc {
    let name = unsafe { argv[i] };
    if same(name, "--chat") {
      o.chat = true;
      i = i + 1;
    } else if same(name, "--think") {
      o.think = true;
      i = i + 1;
    } else if same(name, "--session") {
      o.session = true;
      i = i + 1;
    } else if same(name, "--lines") {
      o.lines = true;
      i = i + 1;
    } else {
      assert(i + 1 < argc, "give: WEIGHTS --tokens 1,2,3 --steps N, or WEIGHTS --tokenizer FILE (--prompt TEXT | --prompt-file FILE) [--chat] [--lines] --steps N");
      let value = unsafe { argv[i + 1] };
      if same(name, "--tokens") {
        o.tokens = value;
        o.has_tokens = true;
      } else if same(name, "--tokenizer") {
        o.tokenizer = value;
        o.has_tokenizer = true;
      } else if same(name, "--prompt") {
        o.prompt = value;
        o.has_prompt = true;
      } else if same(name, "--prompt-file") {
        o.prompt_file = value;
        o.has_prompt_file = true;
      } else if same(name, "--context") {
        o.context = value;
        o.has_context = true;
      } else if same(name, "--requests") {
        o.requests = value;
        o.has_requests = true;
      } else if same(name, "--replies") {
        o.replies = value;
        o.has_replies = true;
      } else if same(name, "--draft") {
        o.draft = value;
        o.has_draft = true;
      } else {
        assert(same(name, "--steps"), "give: WEIGHTS --tokens 1,2,3 --steps N, or WEIGHTS --tokenizer FILE (--prompt TEXT | --prompt-file FILE) [--chat] [--lines] --steps N");
        o.steps = value;
        o.has_steps = true;
      }
      i = i + 2;
    }
  }
  if o.session {
    assert(o.has_tokenizer && o.has_context && o.has_requests && o.has_replies && !o.has_tokens && !o.has_prompt && !o.has_prompt_file && !o.has_steps, "give: WEIGHTS --tokenizer FILE --session --context N --requests FILE --replies FILE");
    return o;
  }
  assert(o.has_steps, "give: WEIGHTS --tokens 1,2,3 --steps N, or WEIGHTS --tokenizer FILE (--prompt TEXT | --prompt-file FILE) [--chat] [--lines] --steps N");
  let one_text = o.has_prompt != o.has_prompt_file;
  let no_text = !o.has_prompt && !o.has_prompt_file;
  assert((o.has_tokens && no_text) || (o.has_tokenizer && !o.has_tokens && one_text), "give: WEIGHTS --tokens 1,2,3 --steps N, or WEIGHTS --tokenizer FILE (--prompt TEXT | --prompt-file FILE) [--chat] [--lines] --steps N");
  assert(o.has_tokenizer || (!o.chat && !o.lines), "--chat and --lines need --tokenizer");
  assert(o.chat || !o.think, "--think needs --chat");
  return o;
}

/// The comma-separated numbers of `text`. Asserts that it has only digits and commas, and no empty
/// number.
fn parse_numbers(text : *const i8) -> Vec<i32> {
  let mut numbers = Vec<i32>::new();
  let mut value : i32 = 0;
  let mut digits = 0;
  let mut empty = false;
  let mut i : i64 = 0;
  let mut ch = i32::from(unsafe { text[0] });
  while ch != 0 {
    if ch == 44 {
      empty = empty || digits == 0;
      numbers.push(value);
      value = 0;
      digits = 0;
    } else {
      assert(ch >= 48 && ch <= 57, "a list of numbers can have only digits and commas");
      value = value * 10 + (ch - 48);
      digits = digits + 1;
    }
    i = i + 1;
    ch = i32::from(unsafe { text[i] });
  }
  assert(!empty && digits > 0, "an empty number in a comma-separated list");
  numbers.push(value);
  return numbers;
}

/// The number of tokens that text mode runs through the model before it reads them. A read waits
/// for all the work that the GPU was given, and then the GPU has nothing to do until the CPU gives
/// it the next token: about 0.37 ms of a 21.9 ms token on the M4. The input of a token is the
/// argmax of the token before it, in GPU memory, so the GPU can run several tokens without the
/// CPU. Then the GPU waits only once for each AHEAD tokens. Up to AHEAD - 1 tokens after the end
/// of the text are run and thrown away.
const AHEAD : i32 = 8;

/// The GPU tensor of one token.
struct Slot {
  next : Tensor<i32, [?], Memory::HBM>,
}

/// The token in `t`. Reading it waits for the GPU to finish the work before it.
fn read_token(t : &Tensor<i32, [?], Memory::HBM>) -> i32 {
  let h = transfer(t, Memory::CPU_DRAM);
  return h[0];
}

/// The logit `token` of `logits`.
fn read_logit(logits : &Tensor<f32, [?], Memory::HBM>, token : i32) -> f32 {
  let h = transfer(logits, Memory::CPU_DRAM);
  return h[token];
}

/// Whether the C string `a` is `b`.
fn same(a : *const i8, b : *const i8) -> bool {
  return unsafe { strcmp(a, b) } == 0;
}

/// The bytes of `a` and then those of `b`, in new memory.
fn join_text(a : &Text, b : &Text) -> Text {
  let length = a.length + b.length;
  let bytes : *mut i8 = unsafe { malloc((length + 1) as usize) };
  copy_bytes(bytes, a.bytes, a.length);
  copy_bytes(offset_mut(bytes, a.length), b.bytes, b.length);
  return Text {
    bytes: bytes, length: length
  };
}

/// The token ids of the prompt: the numbers of --tokens, or the tokens of the text.
fn prompt_ids(o : &Options, t : &Tokenizer) -> Vec<i32> {
  if o.has_tokens {
    return parse_numbers(o.tokens);
  }
  let text = if o.has_prompt {
    c_text(o.prompt)
  } else {
    read_text_file(o.prompt_file)
  };
  let full = if o.chat && weight_file_arch(o.weights) == 1 {
    // The chat template of Qwen3.5 and Qwen3.6 opens the reply with a <think> block.
    let reply = if o.think {
      c_text("<think>
")
    } else {
      c_text("<think>

</think>

")
    };
    join_text(&chat_text(&text), &reply)
  } else if o.chat {
    chat_text(&text)
  } else {
    text
  };
  let ids = encode(t, full.bytes, full.length);
  assert(ids.len() > 0, "the prompt has no tokens");
  return ids;
}

/// Shows token number `step`, as the loop of `main` does: its text, or a line with its logit.
/// Gives false at the end of the text, where the loop stops.
fn show(t : &Tokenizer, eos : i32, text_mode : bool, step : i32, token : i32, logit : f32) -> bool {
  if text_mode {
    if is_special(t, token) || token == eos {
      return false;
    }
    write_token(t, token);
  } else {
    println!("step={} token={} logit={};", step, token, logit);
  }
  return true;
}

/// The logit `token` of position j of a round.
fn round_logit(logits : &Tensor<f32, [?, ?], Memory::HBM>, j : i32, token : i32) -> f32 {
  let h = transfer(logits, Memory::CPU_DRAM);
  return h[j][token];
}

/// The loop of `main` with speculative decoding (src/speculate.vx). Each step is a round of the
/// last token and a draft from the context, or a plain step when the draft would not pay: when the
/// longest earlier match of the end of the context is shorter than 6 tokens, or after 2 rounds in a
/// row that accepted nothing, until a longer match than theirs appears. A draft has up to `max`
/// tokens. `first` is the first generated token, from the logits in `s.logits`. Shows the same
/// `steps` tokens as the loop of `main`, and gives the number of tokens after the first.
fn generate_with_drafts(w : &Weights, s : &mut State, t : &Tokenizer, text_mode : bool, prompt : &Vec<i32>, first : i32, steps : i32, max : i32, start : &mut Instant) -> i32 {
  assert(can_round(w), "--draft needs a model of Q4_0 experts with QK norms, head_dim 128 and a 6-bit lm_head");
  assert(max >= 1 && max < ROUND_MAX, "--draft must be 1 to ROUND_MAX - 1");
  assert(steps >= ROUND_MAX, "--draft needs --steps of at least ROUND_MAX");
  let mut r = new_round(&w.config);
  // One run of the round kernels for each n to 8, so that their compile time is not in the time
  // of a token: it restarts the clock. Larger rounds use the same kernels. The rounds write rows of
  // the KV cache that the steps write again before they read them.
  let mut warm = Vec<i32>::new();
  for n in 1..9 {
    warm.push(first);
    run_round(w, s, &mut r, &warm, prompt.len(), n);
  }
  let _ready = transfer(&r.next, Memory::CPU_DRAM);
  *start = Instant::now();
  // The tokens of a run of plain steps: token j is in ring[j].
  let mut ring = Vec<Slot>::new();
  for j in 0..AHEAD {
    ring.push(Slot {
      next: transfer(Tensor<i32>([1]), Memory::HBM),
    });
  }
  // The length of the next run of plain steps: 1 after a round, then 2, 4 and up to AHEAD while
  // no draft comes up. The GPU runs the tokens of a run before the CPU reads them. Lines mode
  // prints the logit of each token, so it reads each one.
  let mut run = 1;
  let mut context = Vec<i32>::new();
  for i in 0..prompt.len() {
    context.push(prompt[i]);
  }
  let mut token = first;
  context.push(token);
  // The position of `token`, which is not in the KV cache yet.
  let mut pos = prompt.len();
  let mut step = 0;
  let mut rounds = 0;
  let mut drafted = 0;
  let mut accepted = 0;
  // Rounds in a row that accepted nothing, and the length of the match of the last of them.
  let mut misses = 0;
  let mut missed_length = 0;
  let mut going = show(t, w.config.eos_token_id, text_mode, 0, token, read_logit(&s.logits, token));
  while going && step + 1 < steps {
    let room = steps - step - 1;
    let m = longest_match(&context);
    if misses >= 2 && m.length > missed_length {
      misses = 0;
    }
    let mut k = i32::min(i32::min(draft_length(m.length), max), room - 1);
    if misses >= 2 {
      k = 0;
    }
    let draft = tokens_after(&context, m.end, k);
    k = draft.len();
    if k == 0 {
      // Plain steps, with the kernels of one token each.
      let mut n = 1;
      if text_mode {
        n = i32::min(run, room);
      }
      let mut h = Tensor<i32>([1]);
      h[0] = token;
      let input = transfer(h, Memory::HBM);
      run_layers(w, s, &input, pos);
      predict(w, s, &mut ring[0].next);
      for j in 1..n {
        run_layers(w, s, &ring[j - 1].next, pos + j);
        predict(w, s, &mut ring[j].next);
      }
      let mut j = 0;
      while j < n && going {
        token = read_token(&ring[j].next);
        context.push(token);
        step = step + 1;
        pos = pos + 1;
        let mut logit : f32 = 0.0;
        if !text_mode {
          logit = read_logit(&s.logits, token);
        }
        going = show(t, w.config.eos_token_id, text_mode, step, token, logit);
        j = j + 1;
      }
      run = i32::min(run * 2, AHEAD);
    } else {
      run = 1;
      let mut inputs = Vec<i32>::new();
      inputs.push(token);
      for i in 0..k {
        inputs.push(draft[i]);
      }
      run_round(w, s, &mut r, &inputs, pos, k + 1);
      let choice = transfer(&r.next, Memory::CPU_DRAM);
      rounds = rounds + 1;
      drafted = drafted + k;
      // c0 is the next token; each draft token that equals the choice before it adds the next one.
      let mut j = 0;
      let mut more = true;
      while more && going {
        token = choice[j];
        context.push(token);
        step = step + 1;
        let mut logit : f32 = 0.0;
        if !text_mode {
          logit = round_logit(&r.logits, j, token);
        }
        going = show(t, w.config.eos_token_id, text_mode, step, token, logit);
        more = j < k && draft[j] == token;
        if more {
          accepted = accepted + 1;
          j = j + 1;
        }
      }
      pos = pos + j + 1;
      if j == 0 {
        misses = misses + 1;
        missed_length = m.length;
      } else {
        misses = 0;
      }
    }
  }
  println!("rounds={} drafted={} accepted={};", rounds, drafted, accepted);
  return step;
}

/// `generate_with_drafts` for a Qwen3.5 or Qwen3.6 model (src/round35.vx). After each round,
/// `commit_round35` writes the DeltaNet states of the tokens that the round keeps. The first step
/// is a plain step that compiles the kernels of a token, so the clock starts after it and the
/// count of tokens leaves it out.
fn generate_with_drafts35(w : &Qwen35Weights, s : &mut Qwen35State, t : &Tokenizer, text_mode : bool, prompt : &Vec<i32>, first : i32, steps : i32, max : i32, start : &mut Instant) -> i32 {
  assert(can_round35(w), "--draft needs a model of Q4_0 layers and experts and a 6-bit lm_head");
  assert(max >= 1 && max < ROUND_MAX, "--draft must be 1 to ROUND_MAX - 1");
  assert(steps >= ROUND_MAX, "--draft needs --steps of at least ROUND_MAX");
  let eos = w.config.eos_token_id;
  let mut r = new_round35(&w.config);
  let mut ring = Vec<Slot>::new();
  for j in 0..AHEAD {
    ring.push(Slot {
      next: transfer(Tensor<i32>([1]), Memory::HBM),
    });
  }
  let mut context = Vec<i32>::new();
  for i in 0..prompt.len() {
    context.push(prompt[i]);
  }
  let mut token = first;
  context.push(token);
  // The position of `token`, which is not in the KV cache yet.
  let mut pos = prompt.len();
  let mut step = 0;
  let mut going = show(t, eos, text_mode, 0, token, read_logit(&s.logits, token));
  if going {
    let mut h = Tensor<i32>([1]);
    h[0] = token;
    let input = transfer(h, Memory::HBM);
    run_qwen35_layers(w, s, &input, pos);
    predict_qwen35(w, s, &mut ring[0].next);
    token = read_token(&ring[0].next);
    context.push(token);
    step = 1;
    pos = pos + 1;
    going = show(t, eos, text_mode, step, token, read_logit(&s.logits, token));
  }
  // One run of the round kernels for each n to 8, so that their compile time is not in the time
  // of a token. They write rows of the KV cache that later tokens write again before they read
  // them, and no DeltaNet state.
  let mut warm = Vec<i32>::new();
  for n in 1..9 {
    warm.push(token);
    run_round35(w, s, &mut r, &warm, pos, n);
  }
  let _ready = transfer(&r.next, Memory::CPU_DRAM);
  *start = Instant::now();
  let first_step = step;
  let mut run = 1;
  let mut rounds = 0;
  let mut drafted = 0;
  let mut accepted = 0;
  let mut misses = 0;
  let mut missed_length = 0;
  while going && step + 1 < steps {
    let room = steps - step - 1;
    let m = longest_match(&context);
    if misses >= 2 && m.length > missed_length {
      misses = 0;
    }
    let mut k = i32::min(i32::min(draft_length(m.length), max), room - 1);
    if misses >= 2 {
      k = 0;
    }
    let draft = tokens_after(&context, m.end, k);
    k = draft.len();
    if k == 0 {
      let mut n = 1;
      if text_mode {
        n = i32::min(run, room);
      }
      let mut h = Tensor<i32>([1]);
      h[0] = token;
      let input = transfer(h, Memory::HBM);
      run_qwen35_layers(w, s, &input, pos);
      predict_qwen35(w, s, &mut ring[0].next);
      for j in 1..n {
        run_qwen35_layers(w, s, &ring[j - 1].next, pos + j);
        predict_qwen35(w, s, &mut ring[j].next);
      }
      let mut j = 0;
      while j < n && going {
        token = read_token(&ring[j].next);
        context.push(token);
        step = step + 1;
        pos = pos + 1;
        let mut logit : f32 = 0.0;
        if !text_mode {
          logit = read_logit(&s.logits, token);
        }
        going = show(t, eos, text_mode, step, token, logit);
        j = j + 1;
      }
      run = i32::min(run * 2, AHEAD);
    } else {
      run = 1;
      let mut inputs = Vec<i32>::new();
      inputs.push(token);
      for i in 0..k {
        inputs.push(draft[i]);
      }
      run_round35(w, s, &mut r, &inputs, pos, k + 1);
      let choice = transfer(&r.next, Memory::CPU_DRAM);
      rounds = rounds + 1;
      drafted = drafted + k;
      let mut j = 0;
      let mut more = true;
      while more && going {
        token = choice[j];
        context.push(token);
        step = step + 1;
        let mut logit : f32 = 0.0;
        if !text_mode {
          logit = round_logit(&r.logits, j, token);
        }
        going = show(t, eos, text_mode, step, token, logit);
        more = j < k && draft[j] == token;
        if more {
          accepted = accepted + 1;
          j = j + 1;
        }
      }
      // Inputs 0 to j of the round are kept: the last accepted token and the j draft tokens
      // before the first miss.
      commit_round35(w, s, &r, j + 1);
      pos = pos + j + 1;
      if j == 0 {
        misses = misses + 1;
        missed_length = m.length;
      } else {
        misses = 0;
      }
    }
  }
  println!("rounds={} drafted={} accepted={};", rounds, drafted, accepted);
  return step - first_step;
}


/// `main` for a Qwen3.5 or Qwen3.6 model (weight file v2, arch 1). The prompt runs in chunks
/// (src/prefill35.vx). With --draft, the tokens come from `generate_with_drafts35`. Prints the
/// same lines as `main`.
fn run_qwen35(path : *const i8, t : &Tokenizer, text_mode : bool, chat : bool, prompt : &Vec<i32>, steps : i32, draft : i32) -> i32 {
  let w = load_qwen35_weights(path);
  let count = prompt.len();
  let mut s = new_qwen35_state(&w.config, count + steps);
  for i in 0..count {
    assert(prompt[i] < w.config.vocab_size, "a token of the prompt is not in the vocabulary");
  }
  let ahead = if text_mode {
    AHEAD
  } else {
    1
  };
  let mut slots = Vec<Slot>::new();
  for i in 0..ahead + 1 {
    slots.push(Slot {
      next: transfer(Tensor<i32>([1]), Memory::HBM)
    });
  }
  if text_mode {
    if !chat {
      for i in 0..count {
        write_token(t, prompt[i]);
      }
    }
  } else {
    print!("prompt=");
    for i in 0..count {
      if i > 0 {
        print!(",");
      }
      print!("{}", prompt[i]);
    }
    println!(";");
  }
  let prompt_start = Instant::now();
  prefill_qwen35(&w, &mut s, prompt);
  predict_qwen35(&w, &mut s, &mut slots[0].next);
  let mut tokens = Vec<i32>::new();
  tokens.push(read_token(&slots[0].next));
  let prompt_ms = f64::from(prompt_start.elapsed().as_secs_f32()) * 1000.0;
  let mut start = Instant::now();
  let mut decoded = 0;
  if draft > 0 {
    decoded = generate_with_drafts35(&w, &mut s, t, text_mode, prompt, tokens[0], steps, draft, &mut start);
  }
  for step in 0..steps {
    if draft > 0 {
      break;
    }
    let token = tokens[step];
    if text_mode {
      if is_special(t, token) || token == w.config.eos_token_id {
        break;
      }
      write_token(t, token);
    } else {
      println!("step={} token={} logit={};", step, token, read_logit(&s.logits, token));
    }
    if step == 1 {
      // The tokens of step 0 compile the kernels of a step, so the clock starts after them. (A token
      // cannot run twice to warm up, as in `main`: the DeltaNet would update its state twice.)
      start = Instant::now();
    }
    if step + 1 < steps && tokens.len() == step + 1 {
      let mut n = steps - 1 - step;
      if n > ahead {
        n = ahead;
      }
      for j in 0..n {
        let from = (step + j) % (ahead + 1);
        let to = (step + j + 1) % (ahead + 1);
        run_qwen35_layers(&w, &mut s, &slots[from].next, count + step + j);
        predict_qwen35(&w, &mut s, &mut slots[to].next);
      }
      for j in 0..n {
        tokens.push(read_token(&slots[(step + j + 1) % (ahead + 1)].next));
      }
      if step > 0 {
        decoded = decoded + n;
      }
    }
  }
  if text_mode {
    println!("");
  }
  if decoded > 0 {
    let ms = f64::from(start.elapsed().as_secs_f32()) * 1000.0 / f64::from(decoded);
    println!("time ms_per_token={};", ms);
  }
  println!("time prompt_ms_per_token={};", prompt_ms / f64::from(count));
  return 0;
}

fn main(argc : i32, argv : *mut *mut i8) -> i32 {
  let o = parse_options(argc, argv);
  if o.session {
    let context = parse_numbers(o.context);
    return run_session(o.weights, o.tokenizer, o.requests, o.replies, context[0]);
  }
  let t = if o.has_tokenizer {
    load_tokenizer(o.tokenizer)
  } else {
    no_tokenizer()
  };
  // Text mode prints text. Otherwise the program prints the lines of `reference.py`.
  let text_mode = o.has_tokenizer && !o.lines;
  let prompt = prompt_ids(&o, &t);
  let steps_list = parse_numbers(o.steps);
  let steps = steps_list[0];
  let count = prompt.len();
  assert(steps > 0, "--steps must be at least 1");

  if weight_file_arch(o.weights) == 1 {
    let draft = if o.has_draft {
      parse_numbers(o.draft)[0]
    } else {
      0
    };
    return run_qwen35(o.weights, &t, text_mode, o.chat, &prompt, steps, draft);
  }
  let w = load_weights(o.weights);
  let mut s = new_state(&w.config, count + steps);
  for i in 0..count {
    assert(prompt[i] < w.config.vocab_size, "a token of the prompt is not in the vocabulary");
  }
  // Token i is in slots[i % (ahead + 1)]. Lines mode prints the logit of each token, so it reads
  // each token before it runs the next.
  let ahead = if text_mode {
    AHEAD
  } else {
    1
  };
  let mut slots = Vec<Slot>::new();
  for i in 0..ahead + 1 {
    slots.push(Slot {
      next: transfer(Tensor<i32>([1]), Memory::HBM)
    });
  }

  if text_mode {
    if !o.chat {
      for i in 0..count {
        write_token(&t, prompt[i]);
      }
    }
  } else {
    print!("prompt=");
    for i in 0..count {
      if i > 0 {
        print!(",");
      }
      print!("{}", prompt[i]);
    }
    println!(";");
  }

  let prompt_start = Instant::now();
  prefill(&w, &mut s, &prompt);
  predict(&w, &mut s, &mut slots[0].next);
  // The first token waits for the whole prompt, so the clock of the decoder starts after it, and
  // its time covers only the tokens that the loop decodes.
  let mut tokens = Vec<i32>::new();
  tokens.push(read_token(&slots[0].next));
  let prompt_ms = f64::from(prompt_start.elapsed().as_secs_f32()) * 1000.0;
  // The first run of a kernel compiles it, so the clock starts after one run of the kernels of a
  // token. This run writes the row of position `count` of the KV cache, as the first step does.
  run_layers(&w, &mut s, &slots[0].next, count);
  read_token(&slots[0].next);
  let mut start = Instant::now();
  // The number of tokens that the loop ran through the model.
  let mut decoded = 0;
  if o.has_draft {
    decoded = generate_with_drafts(&w, &mut s, &t, text_mode, &prompt, tokens[0], steps, parse_numbers(o.draft)[0], &mut start);
  }
  for step in 0..steps {
    if o.has_draft {
      break;
    }
    let token = tokens[step];
    if text_mode {
      if is_special(&t, token) || token == w.config.eos_token_id {
        break;
      }
      write_token(&t, token);
    } else {
      println!("step={} token={} logit={};", step, token, read_logit(&s.logits, token));
    }
    if step + 1 < steps && tokens.len() == step + 1 {
      // Run tokens step + 1 to step + n, and then read them all.
      let mut n = steps - 1 - step;
      if n > ahead {
        n = ahead;
      }
      for j in 0..n {
        let from = (step + j) % (ahead + 1);
        let to = (step + j + 1) % (ahead + 1);
        run_layers(&w, &mut s, &slots[from].next, count + step + j);
        predict(&w, &mut s, &mut slots[to].next);
      }
      for j in 0..n {
        tokens.push(read_token(&slots[(step + j + 1) % (ahead + 1)].next));
      }
      decoded = decoded + n;
    }
  }
  if text_mode {
    println!("");
  }
  if decoded > 0 {
    let ms = f64::from(start.elapsed().as_secs_f32()) * 1000.0 / f64::from(decoded);
    println!("time ms_per_token={};", ms);
  }
  println!("time prompt_ms_per_token={};", prompt_ms / f64::from(count));
  return 0;
}
