//===----------------------------------------------------------------------===//
// The Q4_0 products of a generated token, as in std::nn, but with 2 SIMD groups of 4 rows in each
// block in place of one SIMD group of 8 rows. Each row has the same sum as in std::nn, so the
// results are the same bits. With more and smaller SIMD groups, the GPU keeps more reads of the
// weights in flight. On the M4, the expert gate-up products of a token take 6.95 ms in place of
// 7.3 ms (48 layers, the 6.53 ms floor at 104 GB/s, plus 0.37 ms for the read at the end). A
// generated token takes 0.3 to 0.6 ms less with the four products of this file.
import core::num;
import std::nn;

fn qkv_q4_blocks(q : &mut Tensor<f32, [?, ?], Memory::HBM>, k : &mut Tensor<f32, [?, ?], Memory::HBM>, v : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, b : &Tensor<bf16, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, q_heads : i32, kv_heads : i32, head_dim : i32, cols : i32) -> void {
  let heads = q_heads + 2 * kv_heads;
  nn_check_heads(q.extent(0), q.extent(1), q_heads, head_dim);
  nn_check_heads(k.extent(0), k.extent(1), kv_heads, head_dim);
  nn_check_heads(v.extent(0), v.extent(1), kv_heads, head_dim);
  nn_check_q4(w.len(), scales.len(), x.len(), heads * head_dim, cols);
  assert(b.len() >= heads * head_dim, "nn_qkv_q4: the bias has fewer values than rows");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for h in 0..heads across blocks {
      for d8 in 0..head_dim / 8 across blocks {
        let mut part = unsafe {
          Tensor<f32, [2, 4, 32], Memory::SMEM>::uninit()
        };
        // 2 SIMD groups of 4 rows each. The sums over the lanes of a SIMD group need no barrier.
        for s in 0..2 across subgroups {
          let first = h * head_dim + d8 * 8 + s * 4;
          for l in 0..32 across lanes(32) {
            let mut acc = unsafe { Tensor<f32, [4]>::uninit() };
            for j in 0..4 {
              acc[j] = 0.0;
            }
            let mut i = l * 2;
            while i < words {
              let c = i * 8;
              let mut xp = unsafe { Tensor<f32, [16]>::uninit() };
              for t in 0..16 {
                xp[t] = x[c + t];
              }
              let sum8 = 8.0 * (xp[0] + xp[1] + xp[2] + xp[3] + xp[4] + xp[5] + xp[6] + xp[7] + xp[8] + xp[9] + xp[10] + xp[11] + xp[12] + xp[13] + xp[14] + xp[15]);
              xp[1] = xp[1] * 0.0625;
              xp[2] = xp[2] * 0.00390625;
              xp[3] = xp[3] * 0.000244140625;
              xp[4] = xp[4] * 0.0000152587890625;
              xp[5] = xp[5] * 0.00000095367431640625;
              xp[6] = xp[6] * 0.000000059604644775390625;
              xp[7] = xp[7] * 0.0000000037252902984619140625;
              xp[9] = xp[9] * 0.0625;
              xp[10] = xp[10] * 0.00390625;
              xp[11] = xp[11] * 0.000244140625;
              xp[12] = xp[12] * 0.0000152587890625;
              xp[13] = xp[13] * 0.00000095367431640625;
              xp[14] = xp[14] * 0.000000059604644775390625;
              xp[15] = xp[15] * 0.0000000037252902984619140625;
              for j in 0..4 {
                let row = first + j;
                let at = row * words + i;
                let w0 = w[at];
                let w1 = w[at + 1];
                let dot = ((w0 & 15u32) as f32) * xp[0] + ((w0 & 240u32) as f32) * xp[1] + ((w0 & 3840u32) as f32) * xp[2] + ((w0 & 61440u32) as f32) * xp[3] + ((w0 & 983040u32) as f32) * xp[4] + ((w0 & 15728640u32) as f32) * xp[5] + ((w0 & 251658240u32) as f32) * xp[6] + ((w0 & 4026531840u32) as f32) * xp[7] + ((w1 & 15u32) as f32) * xp[8] + ((w1 & 240u32) as f32) * xp[9] + ((w1 & 3840u32) as f32) * xp[10] + ((w1 & 61440u32) as f32) * xp[11] + ((w1 & 983040u32) as f32) * xp[12] + ((w1 & 15728640u32) as f32) * xp[13] + ((w1 & 251658240u32) as f32) * xp[14] + ((w1 & 4026531840u32) as f32) * xp[15];
                acc[j] = acc[j] + (dot - sum8) * (scales[row * groups + i / 4] as f32);
              }
              i = i + 64;
            }
            part[s][0][l] = acc[0];
            part[s][1][l] = acc[1];
            part[s][2][l] = acc[2];
            part[s][3][l] = acc[3];
          }
          let s0 = lanes::sum(&part[s][0], 32);
          let s1 = lanes::sum(&part[s][1], 32);
          let s2 = lanes::sum(&part[s][2], 32);
          let s3 = lanes::sum(&part[s][3], 32);
          let r0 = s0 + (b[first + 0] as f32);
          let r1 = s1 + (b[first + 1] as f32);
          let r2 = s2 + (b[first + 2] as f32);
          let r3 = s3 + (b[first + 3] as f32);
          if h < q_heads {
            q[h][d8 * 8 + s * 4 + 0] = r0;
            q[h][d8 * 8 + s * 4 + 1] = r1;
            q[h][d8 * 8 + s * 4 + 2] = r2;
            q[h][d8 * 8 + s * 4 + 3] = r3;
          } else if h < q_heads + kv_heads {
            k[h - q_heads][d8 * 8 + s * 4 + 0] = r0;
            k[h - q_heads][d8 * 8 + s * 4 + 1] = r1;
            k[h - q_heads][d8 * 8 + s * 4 + 2] = r2;
            k[h - q_heads][d8 * 8 + s * 4 + 3] = r3;
          } else {
            v[h - q_heads - kv_heads][d8 * 8 + s * 4 + 0] = r0;
            v[h - q_heads - kv_heads][d8 * 8 + s * 4 + 1] = r1;
            v[h - q_heads - kv_heads][d8 * 8 + s * 4 + 2] = r2;
            v[h - q_heads - kv_heads][d8 * 8 + s * 4 + 3] = r3;
          }
        }
      }
    }
  }
  return;
}


fn matvec_q4_heads_add_blocks(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, heads : i32, head_dim : i32) -> void {
  let cols = heads * head_dim;
  nn_check_heads(x.extent(0), x.extent(1), heads, head_dim);
  nn_check_q4(w.len(), scales.len(), cols, rows, cols);
  assert(rows % 8 == 0 && y.len() >= rows, "nn q4: rows must be a multiple of 8, and the output needs rows values");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..rows / 8 across blocks {
      let mut part = unsafe {
        Tensor<f32, [2, 4, 32], Memory::SMEM>::uninit()
      };
      // 2 SIMD groups of 4 rows each. The sums over the lanes of a SIMD group need no barrier.
      for s in 0..2 across subgroups {
        for l in 0..32 across lanes(32) {
          let first = rb * 8 + s * 4;
          let mut acc = unsafe { Tensor<f32, [4]>::uninit() };
          for j in 0..4 {
            acc[j] = 0.0;
          }
          let mut i = l * 2;
          while i < words {
            let c = i * 8;
            let mut xp = unsafe { Tensor<f32, [16]>::uninit() };
            // head_dim is a multiple of 8, so each run of 8 values is in one head.
            let h0 = c / head_dim;
            let d0 = c - h0 * head_dim;
            for t in 0..8 {
              xp[t] = x[h0][d0 + t];
            }
            let h1 = (c + 8) / head_dim;
            let d1 = c + 8 - h1 * head_dim;
            for t in 0..8 {
              xp[8 + t] = x[h1][d1 + t];
            }
            let sum8 = 8.0 * (xp[0] + xp[1] + xp[2] + xp[3] + xp[4] + xp[5] + xp[6] + xp[7] + xp[8] + xp[9] + xp[10] + xp[11] + xp[12] + xp[13] + xp[14] + xp[15]);
            xp[1] = xp[1] * 0.0625;
            xp[2] = xp[2] * 0.00390625;
            xp[3] = xp[3] * 0.000244140625;
            xp[4] = xp[4] * 0.0000152587890625;
            xp[5] = xp[5] * 0.00000095367431640625;
            xp[6] = xp[6] * 0.000000059604644775390625;
            xp[7] = xp[7] * 0.0000000037252902984619140625;
            xp[9] = xp[9] * 0.0625;
            xp[10] = xp[10] * 0.00390625;
            xp[11] = xp[11] * 0.000244140625;
            xp[12] = xp[12] * 0.0000152587890625;
            xp[13] = xp[13] * 0.00000095367431640625;
            xp[14] = xp[14] * 0.000000059604644775390625;
            xp[15] = xp[15] * 0.0000000037252902984619140625;
            for j in 0..4 {
              let row = first + j;
              let at = row * words + i;
              let w0 = w[at];
              let w1 = w[at + 1];
              let dot = ((w0 & 15u32) as f32) * xp[0] + ((w0 & 240u32) as f32) * xp[1] + ((w0 & 3840u32) as f32) * xp[2] + ((w0 & 61440u32) as f32) * xp[3] + ((w0 & 983040u32) as f32) * xp[4] + ((w0 & 15728640u32) as f32) * xp[5] + ((w0 & 251658240u32) as f32) * xp[6] + ((w0 & 4026531840u32) as f32) * xp[7] + ((w1 & 15u32) as f32) * xp[8] + ((w1 & 240u32) as f32) * xp[9] + ((w1 & 3840u32) as f32) * xp[10] + ((w1 & 61440u32) as f32) * xp[11] + ((w1 & 983040u32) as f32) * xp[12] + ((w1 & 15728640u32) as f32) * xp[13] + ((w1 & 251658240u32) as f32) * xp[14] + ((w1 & 4026531840u32) as f32) * xp[15];
              acc[j] = acc[j] + (dot - sum8) * (scales[row * groups + i / 4] as f32);
            }
            i = i + 64;
          }
          part[s][0][l] = acc[0];
          part[s][1][l] = acc[1];
          part[s][2][l] = acc[2];
          part[s][3][l] = acc[3];
        }
        let s0 = lanes::sum(&part[s][0], 32);
        let s1 = lanes::sum(&part[s][1], 32);
        let s2 = lanes::sum(&part[s][2], 32);
        let s3 = lanes::sum(&part[s][3], 32);
        y[rb * 8 + s * 4 + 0] = y[rb * 8 + s * 4 + 0] + s0;
        y[rb * 8 + s * 4 + 1] = y[rb * 8 + s * 4 + 1] + s1;
        y[rb * 8 + s * 4 + 2] = y[rb * 8 + s * 4 + 2] + s2;
        y[rb * 8 + s * 4 + 3] = y[rb * 8 + s * 4 + 3] + s3;
      }
    }
  }
  return;
}


fn moe_swiglu_q4_blocks(out : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, ids : &Tensor<i32, [?], Memory::HBM>, x : &Tensor<f32, [?], Memory::HBM>, k : i32, rows : i32, cols : i32, experts : i32) -> void {
  assert(k > 0 && ids.len() >= k && out.extent(0) >= k && out.extent(1) >= rows, "nn_moe_swiglu_q4: `ids` needs k values, and `out` a row of rows values for each");
  assert(rows % 8 == 0, "nn_moe_swiglu_q4: rows must be a multiple of 8");
  nn_check_q4(w.len(), scales.len(), x.len(), experts * 2 * rows, cols);
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for e in 0..k across blocks {
      for rb in 0..rows / 8 across blocks {
        let mut part = unsafe {
          Tensor<f32, [2, 8, 32], Memory::SMEM>::uninit()
        };
        // 2 SIMD groups of 4 rows each. The sums over the lanes of a SIMD group need no barrier.
        for s in 0..2 across subgroups {
          for l in 0..32 across lanes(32) {
            // acc[0..4] are the gate rows, and acc[4..8] the up rows that pair with them.
            let mut acc = unsafe { Tensor<f32, [8]>::uninit() };
            for j in 0..8 {
              acc[j] = 0.0;
            }
            let id = ids[e];
            assert(id >= 0 && id < experts, "nn_moe_swiglu_q4: an id is not the number of an expert");
            let first = id * 2 * rows + rb * 8 + s * 4;
            let mut i = l * 2;
            while i < words {
              let c = i * 8;
              let mut xp = unsafe { Tensor<f32, [16]>::uninit() };
              for t in 0..16 {
                xp[t] = x[c + t];
              }
              let sum8 = 8.0 * (xp[0] + xp[1] + xp[2] + xp[3] + xp[4] + xp[5] + xp[6] + xp[7] + xp[8] + xp[9] + xp[10] + xp[11] + xp[12] + xp[13] + xp[14] + xp[15]);
              xp[1] = xp[1] * 0.0625;
              xp[2] = xp[2] * 0.00390625;
              xp[3] = xp[3] * 0.000244140625;
              xp[4] = xp[4] * 0.0000152587890625;
              xp[5] = xp[5] * 0.00000095367431640625;
              xp[6] = xp[6] * 0.000000059604644775390625;
              xp[7] = xp[7] * 0.0000000037252902984619140625;
              xp[9] = xp[9] * 0.0625;
              xp[10] = xp[10] * 0.00390625;
              xp[11] = xp[11] * 0.000244140625;
              xp[12] = xp[12] * 0.0000152587890625;
              xp[13] = xp[13] * 0.00000095367431640625;
              xp[14] = xp[14] * 0.000000059604644775390625;
              xp[15] = xp[15] * 0.0000000037252902984619140625;
              for j in 0..8 {
                let row = first + j % 4 + (j / 4) * rows;
                let at = row * words + i;
                let w0 = w[at];
                let w1 = w[at + 1];
                let dot = ((w0 & 15u32) as f32) * xp[0] + ((w0 & 240u32) as f32) * xp[1] + ((w0 & 3840u32) as f32) * xp[2] + ((w0 & 61440u32) as f32) * xp[3] + ((w0 & 983040u32) as f32) * xp[4] + ((w0 & 15728640u32) as f32) * xp[5] + ((w0 & 251658240u32) as f32) * xp[6] + ((w0 & 4026531840u32) as f32) * xp[7] + ((w1 & 15u32) as f32) * xp[8] + ((w1 & 240u32) as f32) * xp[9] + ((w1 & 3840u32) as f32) * xp[10] + ((w1 & 61440u32) as f32) * xp[11] + ((w1 & 983040u32) as f32) * xp[12] + ((w1 & 15728640u32) as f32) * xp[13] + ((w1 & 251658240u32) as f32) * xp[14] + ((w1 & 4026531840u32) as f32) * xp[15];
                acc[j] = acc[j] + (dot - sum8) * (scales[row * groups + i / 4] as f32);
              }
              i = i + 64;
            }
            part[s][0][l] = acc[0];
            part[s][1][l] = acc[1];
            part[s][2][l] = acc[2];
            part[s][3][l] = acc[3];
            part[s][4][l] = acc[4];
            part[s][5][l] = acc[5];
            part[s][6][l] = acc[6];
            part[s][7][l] = acc[7];
          }
          let g0 = lanes::sum(&part[s][0], 32);
          let u0 = lanes::sum(&part[s][4], 32);
          out[e][rb * 8 + s * 4 + 0] = g0 / (1.0 + (0.0 - g0).fast_exp()) * u0;
          let g1 = lanes::sum(&part[s][1], 32);
          let u1 = lanes::sum(&part[s][5], 32);
          out[e][rb * 8 + s * 4 + 1] = g1 / (1.0 + (0.0 - g1).fast_exp()) * u1;
          let g2 = lanes::sum(&part[s][2], 32);
          let u2 = lanes::sum(&part[s][6], 32);
          out[e][rb * 8 + s * 4 + 2] = g2 / (1.0 + (0.0 - g2).fast_exp()) * u2;
          let g3 = lanes::sum(&part[s][3], 32);
          let u3 = lanes::sum(&part[s][7], 32);
          out[e][rb * 8 + s * 4 + 3] = g3 / (1.0 + (0.0 - g3).fast_exp()) * u3;
        }
      }
    }
  }
  return;
}


fn moe_down_q4_add_blocks(y : &mut Tensor<f32, [?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, ids : &Tensor<i32, [?], Memory::HBM>, weights : &Tensor<f32, [?], Memory::HBM>, h : &Tensor<f32, [?, ?], Memory::HBM>, k : i32, rows : i32, cols : i32, experts : i32) -> void {
  assert(k > 0 && ids.len() >= k && weights.len() >= k && h.extent(0) >= k && h.extent(1) >= cols, "nn_moe_down_q4_add: `ids` and `weights` need k values, and `h` a row of cols values for each");
  nn_check_q4(w.len(), scales.len(), cols, experts * rows, cols);
  assert(rows % 8 == 0 && y.len() >= rows, "nn q4: rows must be a multiple of 8, and the output needs rows values");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..rows / 8 across blocks {
      let mut part = unsafe {
        Tensor<f32, [2, 4, 32], Memory::SMEM>::uninit()
      };
      // 2 SIMD groups of 4 rows each. The sums over the lanes of a SIMD group need no barrier.
      for s in 0..2 across subgroups {
        for l in 0..32 across lanes(32) {
          let mut acc = unsafe { Tensor<f32, [4]>::uninit() };
          for j in 0..4 {
            acc[j] = 0.0;
          }
          // Step n of the block takes 2 words of each row of expert n / pairs.
          let pairs = words / 2;
          let mut n = l;
          while n < k * pairs {
            let e = n / pairs;
            let i = (n - e * pairs) * 2;
            let id = ids[e];
            assert(id >= 0 && id < experts, "nn_moe_down_q4_add: an id is not the number of an expert");
            let first = id * rows + rb * 8 + s * 4;
            let we = weights[e];
            let c = i * 8;
            let mut xp = unsafe { Tensor<f32, [16]>::uninit() };
            for t in 0..16 {
              xp[t] = h[e][c + t];
            }
            let sum8 = 8.0 * (xp[0] + xp[1] + xp[2] + xp[3] + xp[4] + xp[5] + xp[6] + xp[7] + xp[8] + xp[9] + xp[10] + xp[11] + xp[12] + xp[13] + xp[14] + xp[15]);
            xp[1] = xp[1] * 0.0625;
            xp[2] = xp[2] * 0.00390625;
            xp[3] = xp[3] * 0.000244140625;
            xp[4] = xp[4] * 0.0000152587890625;
            xp[5] = xp[5] * 0.00000095367431640625;
            xp[6] = xp[6] * 0.000000059604644775390625;
            xp[7] = xp[7] * 0.0000000037252902984619140625;
            xp[9] = xp[9] * 0.0625;
            xp[10] = xp[10] * 0.00390625;
            xp[11] = xp[11] * 0.000244140625;
            xp[12] = xp[12] * 0.0000152587890625;
            xp[13] = xp[13] * 0.00000095367431640625;
            xp[14] = xp[14] * 0.000000059604644775390625;
            xp[15] = xp[15] * 0.0000000037252902984619140625;
            for j in 0..4 {
              let row = first + j;
              let at = row * words + i;
              let w0 = w[at];
              let w1 = w[at + 1];
              let dot = ((w0 & 15u32) as f32) * xp[0] + ((w0 & 240u32) as f32) * xp[1] + ((w0 & 3840u32) as f32) * xp[2] + ((w0 & 61440u32) as f32) * xp[3] + ((w0 & 983040u32) as f32) * xp[4] + ((w0 & 15728640u32) as f32) * xp[5] + ((w0 & 251658240u32) as f32) * xp[6] + ((w0 & 4026531840u32) as f32) * xp[7] + ((w1 & 15u32) as f32) * xp[8] + ((w1 & 240u32) as f32) * xp[9] + ((w1 & 3840u32) as f32) * xp[10] + ((w1 & 61440u32) as f32) * xp[11] + ((w1 & 983040u32) as f32) * xp[12] + ((w1 & 15728640u32) as f32) * xp[13] + ((w1 & 251658240u32) as f32) * xp[14] + ((w1 & 4026531840u32) as f32) * xp[15];
              acc[j] = acc[j] + we * (dot - sum8) * (scales[row * groups + i / 4] as f32);
            }
            n = n + 32;
          }
          part[s][0][l] = acc[0];
          part[s][1][l] = acc[1];
          part[s][2][l] = acc[2];
          part[s][3][l] = acc[3];
        }
        let s0 = lanes::sum(&part[s][0], 32);
        let s1 = lanes::sum(&part[s][1], 32);
        let s2 = lanes::sum(&part[s][2], 32);
        let s3 = lanes::sum(&part[s][3], 32);
        y[rb * 8 + s * 4 + 0] = y[rb * 8 + s * 4 + 0] + s0;
        y[rb * 8 + s * 4 + 1] = y[rb * 8 + s * 4 + 1] + s1;
        y[rb * 8 + s * 4 + 2] = y[rb * 8 + s * 4 + 2] + s2;
        y[rb * 8 + s * 4 + 3] = y[rb * 8 + s * 4 + 3] + s3;
      }
    }
  }
  return;
}

