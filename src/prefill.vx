            %r1_24 = gpu.subgroup_mma_compute %ma0_24, %mb1_24, %r1_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r2_24 = gpu.subgroup_mma_compute %ma0_24, %mb2_24, %r2_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r3_24 = gpu.subgroup_mma_compute %ma0_24, %mb3_24, %r3_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r4_24 = gpu.subgroup_mma_compute %ma1_24, %mb0_24, %r4_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r5_24 = gpu.subgroup_mma_compute %ma1_24, %mb1_24, %r5_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r6_24 = gpu.subgroup_mma_compute %ma1_24, %mb2_24, %r6_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            %r7_24 = gpu.subgroup_mma_compute %ma1_24, %mb3_24, %r7_16 : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
            scf.yield %r0_24, %r1_24, %r2_24, %r3_24, %r4_24, %r5_24, %r6_24, %r7_24 : !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">, !gpu.mma_matrix<8x8xf32, "COp">
          }
          %th16 = arith.muli %th, %k16 : index
          %yr0 = arith.addi %tb32, %th16 : index
          %yr1 = arith.addi %yr0, %k8 : index
          %yc0 = arith.addi %rb64, %rh32 : index
          %yc1 = arith.addi %yc0, %k8 : index
          %yc2 = arith.addi %yc0, %k16 : index
          %yc3 = arith.addi %yc0, %k24 : index
          gpu.subgroup_mma_store_matrix %res#0, %y[%yr0, %yc0] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#1, %y[%yr0, %yc1] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#2, %y[%yr0, %yc2] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#3, %y[%yr0, %yc3] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#4, %y[%yr1, %yc0] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#5, %y[%yr1, %yc1] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#6, %y[%yr1, %yc2] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          gpu.subgroup_mma_store_matrix %res#7, %y[%yr1, %yc3] {leadDimension = 0 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<?x?xf32>
          macro.yield %tb : i32
        };
      }
    }
  }
  return;
}

/// The product of a Q4_0 matrix, in the format of `nn_matvec_q4`: a weight is (code - 8) times
/// the f16 scale of its 32 columns. The weights go to shared memory as [column][row], and the
/// inputs as [token][column], so that the lanes of a subgroup write consecutive words, and the
/// matmul gives [token][row].
fn pf_mm_q4(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  if !use_bias && !add {
    if rows % 64 == 0 {
      pf_mm_q4_mlir(y, w, scales, x, list, bases, stride, rows, cols, tiles);
    } else {
      pf_mm_q4_set(y, w, scales, x, list, bases, stride, rows, cols, tiles);
    }
    return;
  }
  assert(cols % 32 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_q4: cols must be a multiple of 32, and list and bases need the tiles");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sw = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sx = unsafe {
          Tensor<f32, [1, 16, 32], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 16, 32], Memory::SMEM>::uninit()
        };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            for t in 0..16 {
              acc[sg][t][l] = 0.0;
            }
          }
        }
        // A tile after those of the last expert has the base -1, and only gets zeros.
        let live = (bases[tb] + 1048576) / 1048576;
        for g in 0..groups * live {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let row = bases[tb] * stride + r;
                let at = row * words + g * 4;
                let sc = scales[row * groups + g] as f32;
                let m = -8.0 * sc;
                for i in 0..4 {
                  let word = w[at + i];
                  sw[sg][i * 8][l] = ((word & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 1][l] = (((word >> 4u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 2][l] = (((word >> 8u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 3][l] = (((word >> 12u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 4][l] = (((word >> 16u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 5][l] = (((word >> 20u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 6][l] = (((word >> 24u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 7][l] = (((word >> 28u32) & 15u32) as f32) * sc + m;
                }
              } else {
                for k in 0..32 {
                  sw[sg][k][l] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sx[0][sg * 4 + q][l] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sx[0] @ sw[sg];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][t][l];
                } else {
                  y[tb * 16 + t][r] = acc[sg][t][l] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The product of `m`, with the kernel for its dtype.
fn pf_mm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, m : &WeightMatrix, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  if m.dtype == U4 {
    pf_mm_q4(y, &m.codes, &m.group_scales, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  } else if m.dtype == F8E4M3 {
    pf_mm_fp8(y, &m.codes, &m.scales, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  } else {
    pf_mm_bf16(y, &m.bf16, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  }
  return;
}

// ------------------------------------------------------------------ the other kernels ---

/// x[t] = row tokens[t] of `table`, for t below n.
fn pf_embed(x : &mut Tensor<f32, [?, ?], Memory::HBM>, table : &Tensor<bf16, [?], Memory::HBM>, tokens : &Tensor<i32, [?], Memory::HBM>, n : i32, dim : i32) -> void {
  let rows = table.len() / dim;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let token = tokens[t];
            assert(token >= 0 && token < rows, "pf_embed: a token is not a row of the table");
            x[t][i] = table[token * dim + i] as f32;
          }
        }
      }
    }
  }
  return;
}

/// y[t] = the RMSNorm of x[t] times w, as `nn_rms_norm`, for t below n.
fn pf_rms_norm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<bf16, [?], Memory::HBM>, n : i32, dim : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
      for l in 0..1024 across lanes {
        let mut s : f32 = 0.0;
        let mut i = l;
        while i < dim {
          s = s + x[t][i] * x[t][i];
          i = i + 1024;
        }
        part[l] = s;
      }
      let ss = lanes::sum(&part, 1024);
      let inv = 1.0 / (ss / (dim as f32) + eps).sqrt();
      for l in 0..1024 across lanes {
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            y[t][i] = x[t][i] * inv * (w[i] as f32);
          }
        }
      }
    }
  }
  return;
}

/// x[t] += y[t], and then y[t] = the RMSNorm of the new x[t] times w, for t below n: the sum of
/// the residual and a product, and the norm of the next part of the layer, in one pass.
fn pf_add_rms_norm(x : &mut Tensor<f32, [?, ?], Memory::HBM>, y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<bf16, [?], Memory::HBM>, n : i32, dim : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
      for l in 0..1024 across lanes {
        let mut s : f32 = 0.0;
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            let v = x[t][i] + y[t][i];
            x[t][i] = v;
            s = s + v * v;
          }
        }
        part[l] = s;
      }
      let ss = lanes::sum(&part, 1024);
      let inv = 1.0 / (ss / (dim as f32) + eps).sqrt();
      for l in 0..1024 across lanes {
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            y[t][i] = x[t][i] * inv * (w[i] as f32);
          }
        }
      }
    }
  }
  return;
}

/// RoPE for the tokens of the chunk, as `nn_rope_and_store`: token t is at position start + t.
/// The heads of q, k and v are one after another in qkv[t].
fn pf_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, qkv : &Tensor<f32, [?, ?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  assert(start + n <= k_cache.extent(0) && start + n <= cos.extent(0), "pf_rope_and_store: the chunk goes past the end of the KV cache");
  let half = head_dim / 2;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        for i in 0..128 across lanes {
          if i < head_dim {
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let pos = start + t;
            let c = cos[pos][j];
            let s = sin[pos][j];
            let base = h * head_dim;
            if h < q_heads {
              q_out[t][h][i] = qkv[t][base + i] * c + sign * qkv[t][base + partner] * s;
            } else {
              k_cache[start + t][h - q_heads][i] = (qkv[t][base + i] * c + sign * qkv[t][base + partner] * s) as f16;
              v_cache[start + t][h - q_heads][i] = qkv[t][base + kv_heads * head_dim + i] as f16;
            }
          }
        }
      }
    }
  }
  return;
}

/// As `pf_rope_and_store`, after the RMSNorm of each head of q and k, as `nn_norm_rope_and_store`.
fn pf_norm_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, qkv : &Tensor<f32, [?, ?], Memory::HBM>, q_norm : &Tensor<bf16, [?], Memory::HBM>, k_norm : &Tensor<bf16, [?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32, eps : f32) -> void {
  assert(start + n <= k_cache.extent(0) && start + n <= cos.extent(0), "pf_norm_rope_and_store: the chunk goes past the end of the KV cache");
  let half = head_dim / 2;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        let mut x = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        for i in 0..128 across lanes {
          let mut a : f32 = 0.0;
          if i < head_dim {
            a = qkv[t][h * head_dim + i];
          }
          x[i] = a;
          part[i] = a * a;
        }
        let ss = lanes::sum(&part, 128);
        let inv = 1.0 / (ss / (head_dim as f32) + eps).sqrt();
        for i in 0..128 across lanes {
          if i < head_dim {
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let pos = start + t;
            let c = cos[pos][j];
            let s = sin[pos][j];
            if h < q_heads {
              let a = x[i] * inv * (q_norm[i] as f32);
              let b = x[partner] * inv * (q_norm[partner] as f32);
              q_out[t][h][i] = a * c + sign * b * s;
            } else {
              let a = x[i] * inv * (k_norm[i] as f32);
              let b = x[partner] * inv * (k_norm[partner] as f32);
              k_cache[start + t][h - q_heads][i] = (a * c + sign * b * s) as f16;
              v_cache[start + t][h - q_heads][i] = qkv[t][(h + kv_heads) * head_dim + i] as f16;
            }
          }
        }
      }
    }
  }
  return;
}

/// The scores of attention, for the n tokens of a slice from token `first` of the chunk, at
/// positions start to start + n - 1: scores[g * 1024 + t * 8 + j][p] = (query head g * group + j
/// of token first + t) . (key p of head g) / sqrt(head_dim), for n up to ATTENTION_TOKENS. A block
/// does four tokens, the 32 rows of their query heads, against 128 positions, as a matmul of f16
/// tiles with the sums in registers. It skips the positions that none of the four tokens sees,
/// and the tokens after n, and writes zeros there.
fn pf_scores(scores : &mut Tensor<f32, [?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, first : i32, start : i32, n : i32, group : i32, head_dim : i32) -> void {
  assert(group <= 8 && head_dim <= 128, "pf_scores: at most 8 query heads for each key-value head, and head_dim at most 128");
  let kv_heads = scores.extent(0) / 1024;
  let end = start + n;
  assert(n <= ATTENTION_TOKENS && first + n <= q.extent(0), "pf_scores: at most ATTENTION_TOKENS tokens, and q needs first + n");
  assert(scores.extent(1) >= (end + 127) / 128 * 128 && end <= k_cache.extent(0), "pf_scores: `scores` needs start + n positions rounded up to 128, and the cache start + n");
  let scale = 1.0 / (head_dim as f32).sqrt();
  let dims = (head_dim + 31) / 32;
  spawn on(Topology::Device) {
    for g in 0..kv_heads across blocks {
      for tb in 0..32 across blocks {
        for pb in 0..(end + 127) / 128 across blocks {
          let mut sk = unsafe { Tensor<f16, [4, 32, 32], Memory::SMEM>::uninit() };
          let mut sq = unsafe { Tensor<f32, [1, 32, 32], Memory::SMEM>::uninit() };
          let mut acc = unsafe { Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit() };
          for sg in 0..4 across subgroups {
            lanes::fill(&mut acc[sg], 0.0);
          }
          // The last token of the four is at most at start + 4 tb + 3. 1 when it sees position
          // pb * 128 and the first token is below n, else 0: (x + K) / (K + 1) is
          // min(max(x, 0), 1) for |x| up to K.
          let steps = dims * ((start + tb * 4 + 4 - pb * 128 + 1048576) / 1048577) * ((n - tb * 4 + 1048576) / 1048577);
          for kc in 0..steps {
            for sg in 0..4 across subgroups {
              for l in 0..32 across lanes(32) {
                let p = pb * 128 + sg * 32 + l;
                for k in 0..32 {
                  let d = kc * 32 + k;
                  let mut v : f32 = 0.0;
                  if p < end && d < head_dim {
                    v = k_cache[p][g][d] as f32;
                  }
                  sk[sg][k][l] = v as f16;
                }
                let t = tb * 4 + sg;
                for j in 0..8 {
                  let d = kc * 32 + l;
                  let mut v : f32 = 0.0;
                  if t < n && j < group && d < head_dim {
                    v = q[first + t][g * group + j][d] * scale;
                  }
                  sq[0][sg * 8 + j][l] = v;
                }
              }
            }
            for sg in 0..4 across subgroups {
              acc[sg] = acc[sg] + sq[0] @ (sk[sg] as f32);
            }
          }
          for sg in 0..4 across subgroups {
            lanes::copy(scores, &acc[sg], [g * 1024 + tb * 32, pb * 128 + sg * 32]);
          }
        }
      }
    }
  }
  return;
}

/// probs[g * 1024 + t * 8 + j][p] = the softmax of the scores of that row over the positions up to
/// start + t, the position of token t, for j below group. The positions after it, up to `width`,
/// get 0, so that `pf_weigh_values` can read them. One pass finds the largest score and the sum of
/// the exponentials, and a second writes the weights. The blocks are those of ATTENTION_TOKENS
/// tokens, so that the row of a token is known to fit an i32; those from n on do nothing.
fn pf_softmax(probs : &mut Tensor<f32, [?, ?], Memory::HBM>, scores : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, group : i32, width : i32) -> void {
  let kv_heads = scores.extent(0) / 1024;
  assert(scores.extent(1) >= width && probs.extent(1) >= width && width >= start + n, "pf_softmax: `scores` and `probs` need `width` positions");
  spawn on(Topology::Device) {
    for t in 0..128 across blocks {
      for g in 0..kv_heads across blocks {
        let mut top = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
        let mut sums = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
        let pos = start + t;
        for j in 0..8 across subgroups {
          for l in 0..32 across lanes(32) {
            let mut m : f32 = -3.0e38;
            let mut s : f32 = 0.0;
            if j < group && t < n {
              for b in 0..(pos + 32) / 32 {
                let p = b * 32 + l;
                if p <= pos {
                  let x = scores[g * 1024 + t * 8 + j][p];
                  if s == 0.0 {
                    m = x;
                    s = 1.0;
                  } else if x > m {
                    s = s * (m - x).fast_exp() + 1.0;
                    m = x;
                  } else {
                    s = s + (x - m).fast_exp();
                  }
                }
              }
            }
            top[j][l] = m;
            sums[j][l] = s;
          }
          let big = lanes::max(&top[j], 32);
          for l in 0..32 across lanes(32) {
            let mut s : f32 = 0.0;
            if sums[j][l] > 0.0 {
              s = sums[j][l] * (top[j][l] - big).fast_exp();
            }
            sums[j][l] = s;
          }
          let total = lanes::sum(&sums[j], 32);
          for l in 0..32 across lanes(32) {
            if j < group && t < n {
              let inv = 1.0 / total;
              for b in 0..(width + 31) / 32 {
                let p = b * 32 + l;
                if p <= pos {
                  probs[g * 1024 + t * 8 + j][p] = (scores[g * 1024 + t * 8 + j][p] - big).fast_exp() * inv;
                } else if p < width {
                  probs[g * 1024 + t * 8 + j][p] = 0.0;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// out[g * 1024 + t * 8 + j] = the sum of the rows p of V of head g, each times its weight
/// probs[g * 1024 + t * 8 + j][p], over the positions that token t sees, for the n tokens of a
/// slice. Token t is at position start + t. A block does the 32 rows of four tokens, for all the
/// values of a head, as a matmul of f16 tiles with the sums in registers. It reads the weights
/// below `width`, so those after start + t must be 0, as `pf_softmax` leaves them.
fn pf_weigh_values(out : &mut Tensor<f32, [?, ?], Memory::HBM>, probs : &Tensor<f32, [?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32, group : i32, head_dim : i32, width : i32) -> void {
  let kv_heads = probs.extent(0) / 1024;
  let end = start + n;
  assert(probs.extent(1) >= width && width >= end && head_dim <= 128 && out.extent(1) == 128 && out.extent(0) == probs.extent(0) && n <= ATTENTION_TOKENS, "pf_weigh_values: `probs` needs `width` positions, `out` the rows of `probs` of 128 values, and n at most ATTENTION_TOKENS");
  spawn on(Topology::Device) {
    for g in 0..kv_heads across blocks {
      for tb in 0..32 across blocks {
        let mut sv = unsafe { Tensor<f16, [4, 32, 32], Memory::SMEM>::uninit() };
        let mut sp = unsafe { Tensor<f32, [1, 32, 32], Memory::SMEM>::uninit() };
        let mut acc = unsafe { Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit() };
        for sg in 0..4 across subgroups {
          lanes::fill(&mut acc[sg], 0.0);
        }
        // The last token of the four sees at most start + 4 tb + 4 positions, and none when the
        // first is not below n.
        let seen = (start + tb * 4 + 4) * ((n - tb * 4 + 1048576) / 1048577);
        for kc in 0..(seen + 31) / 32 {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let d = sg * 32 + l;
              for k in 0..32 {
                let p = kc * 32 + k;
                let mut v : f32 = 0.0;
                if p < end && d < head_dim {
                  v = v_cache[p][g][d] as f32;
                }
                sv[sg][k][l] = v as f16;
              }
              let t = tb * 4 + sg;
              let p = kc * 32 + l;
              for j in 0..8 {
                let mut v : f32 = 0.0;
                if t < n && j < group && p < width {
                  v = probs[g * 1024 + t * 8 + j][p];
                }
                sp[0][sg * 8 + j][l] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sp[0] @ (sv[sg] as f32);
          }
        }
        for sg in 0..4 across subgroups {
          lanes::copy(out, &acc[sg], [g * 1024 + tb * 32, sg * 32]);
        }
      }
    }
  }
  return;
}

/// att[t][h * 128 + d] = attention of query head h of token t (at position start + t) over the
/// positions up to start + t, for t below n. A threadgroup does 8 tokens of one query head, in steps of
/// 64 positions, as llama.cpp's kernel_flash_attn_ext. The caches are [position, kv_heads, 128] f16,
/// with a multiple of 64 positions. K and V go from the cache straight into simdgroup matrices, K
/// transposed; Q (as f16), the scores, the weights (as f16) and the sums of the 8 tokens are in
/// shared memory. The softmax is online, in all the lanes of a subgroup.
///
/// The design is that of llama.cpp (ggml/src/ggml-metal/kernels/fa_common.metal), MIT License,
/// Copyright (c) 2023-2026 The ggml authors.
///
/// scripts/mlir_kernels/flash_attention.py writes this function: change that script, not the MLIR.
fn pf_flash_attention(att : &mut Tensor<f32, [?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, group : i32, scale : f32) -> void {
  assert(q.extent(2) == 128 && k_cache.extent(2) == 128 && k_cache.extent(0) % 64 == 0 && start + n <= k_cache.extent(0), "pf_flash_attention: head_dim 128, and a KV cache of a multiple of 64 positions");
  spawn on(Topology::Device) {
    for qb in 0..(n + 7) / 8 across blocks {
      for h in 0..q_heads across blocks {
        let mut sq = unsafe { Tensor<f16, [1024], Memory::SMEM>::uninit() };
        let mut so = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
        let mut ss = unsafe { Tensor<f32, [512], Memory::SMEM>::uninit() };
        let mut sp = unsafe { Tensor<f16, [512], Memory::SMEM>::uninit() };
        let _d = mlir!( threads : 128, inputs : (%sq = &mut sq : memref<1024xf16, 3>, %so = &mut so : memref<1024xf32, 3>, %ss = &mut ss : memref<512xf32, 3>, %sp = &mut sp : memref<512xf16, 3>, %att = att : memref<?x?xf32>, %q = q : memref<?x?x?xf32>, %k3 = k_cache : memref<?x?x?xf16>, %v3 = v_cache : memref<?x?x?xf16>, %start = start : i32, %n = n : i32, %group = group : i32, %scale = scale : f32, %qb = qb : i32, %h = h : i32), returns : i32, dialects : ["arith", "memref", "scf", "gpu", "vector", "math"], ensures : [writes_only(sq), writes_only(so), writes_only(ss), writes_only(sp), reads_only(q), reads_only(k_cache), reads_only(v_cache), writes_only(att[qb * 8..qb * 8 + 8][h * 128..h * 128 + 128])]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c4 = arith.constant 4 : index
          %c8 = arith.constant 8 : index
          %c16 = arith.constant 16 : index
          %c32 = arith.constant 32 : index
          %c64 = arith.constant 64 : index
          %c128 = arith.constant 128 : index
          %c512 = arith.constant 512 : index
          %tid = gpu.thread_id x
          %sg = arith.divui %tid, %c32 : index
          %l = arith.remui %tid, %c32 : index
          %qbi = arith.index_cast %qb : i32 to index
          %hi = arith.index_cast %h : i32 to index
          %ni = arith.index_cast %n : i32 to index
          %starti = arith.index_cast %start : i32 to index
          %groupi = arith.index_cast %group : i32 to index
          %g = arith.divui %hi, %groupi : index
          %g128 = arith.muli %g, %c128 : index
          %P = memref.dim %k3, %c0 : memref<?x?x?xf16>
          %KH = memref.dim %k3, %c1 : memref<?x?x?xf16>
          %Wd = arith.muli %KH, %c128 : index
          %k = memref.reinterpret_cast %k3 to offset: [0], sizes: [%P, %Wd], strides: [%Wd, 1] : memref<?x?x?xf16> to memref<?x?xf16, strided<[?, 1]>>
          %v = memref.reinterpret_cast %v3 to offset: [0], sizes: [%P, %Wd], strides: [%Wd, 1] : memref<?x?x?xf16> to memref<?x?xf16, strided<[?, 1]>>
          %t0 = arith.muli %qbi, %c8 : index
          %qj = arith.divui %tid, %c16 : index
          %qm = arith.remui %tid, %c16 : index
          %qc = arith.muli %qm, %c8 : index
          %qc4 = arith.addi %qc, %c4 : index
          %qt = arith.addi %t0, %qj : index
          %nm1 = arith.subi %ni, %c1 : index
          %qtc = arith.minui %qt, %nm1 : index
          %qlive = arith.cmpi ult, %qt, %ni : index
          %vz4 = arith.constant dense<0.0> : vector<4xf32>
          %q0r = vector.load %q[%qtc, %hi, %qc] {alignment = 16} : memref<?x?x?xf32>, vector<4xf32>
          %q1r = vector.load %q[%qtc, %hi, %qc4] {alignment = 16} : memref<?x?x?xf32>, vector<4xf32>
          %q0 = arith.select %qlive, %q0r, %vz4 : vector<4xf32>
          %q1 = arith.select %qlive, %q1r, %vz4 : vector<4xf32>
          %q0h = arith.truncf %q0 : vector<4xf32> to vector<4xf16>
          %q1h = arith.truncf %q1 : vector<4xf32> to vector<4xf16>
          %sqo = arith.muli %qj, %c128 : index
          %sqa = arith.addi %sqo, %qc : index
          %sqb = arith.addi %sqa, %c4 : index
          vector.store %q0h, %sq[%sqa] : memref<1024xf16, 3>, vector<4xf16>
          vector.store %q1h, %sq[%sqb] : memref<1024xf16, 3>, vector<4xf16>
          vector.store %vz4, %so[%sqa] : memref<1024xf32, 3>, vector<4xf32>
          vector.store %vz4, %so[%sqb] : memref<1024xf32, 3>, vector<4xf32>
          gpu.barrier
          %tl = arith.addi %t0, %c8 : index
          %tlc = arith.minui %tl, %ni : index
          %lastq = arith.subi %tlc, %c1 : index
          %lastp = arith.addi %starti, %lastq : index
          %nblk0 = arith.divui %lastp, %c64 : index
          %nblk = arith.addi %nblk0, %c1 : index
          %j0 = arith.addi %sg, %c0 : index
          %j1 = arith.addi %sg, %c4 : index
          %qt0 = arith.addi %t0, %j0 : index
          %qp0 = arith.addi %starti, %qt0 : index
          %qt1 = arith.addi %t0, %j1 : index
          %qp1 = arith.addi %starti, %qt1 : index
          %neg = arith.constant -3.0e38 : f32
          %zero = arith.constant 0.0 : f32
