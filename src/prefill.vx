              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd2] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o2, %so[%dv2] {leadDimension = 128 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<1024xf32, 3>
            %dv3a = arith.muli %sg, %c8 : index
            %dv3b = arith.constant 96 : index
            %dv3 = arith.addi %dv3a, %dv3b : index
            %o3i = gpu.subgroup_mma_load_matrix %so[%dv3] {leadDimension = 128 : index} : memref<1024xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd3 = arith.addi %g128, %dv3 : index
            %o3 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o3i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd3] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o3, %so[%dv3] {leadDimension = 128 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<1024xf32, 3>
            gpu.barrier
            scf.yield %Mn0, %Sn0, %Mn1, %Sn1 : f32, f32, f32, f32
          }
          %h128 = arith.muli %hi, %c128 : index
          %one = arith.constant 1.0 : f32
          %inv0 = arith.divf %one, %st#1 : f32
          %iv0 = vector.broadcast %inv0 : f32 to vector<4xf32>
          %fr0 = arith.muli %j0, %c128 : index
          %fi0 = arith.addi %fr0, %l4 : index
          %fv0 = vector.load %so[%fi0] : memref<1024xf32, 3>, vector<4xf32>
          %fw0 = arith.mulf %fv0, %iv0 : vector<4xf32>
          %live0 = arith.cmpi ult, %qt0, %ni : index
          %ac0 = arith.addi %h128, %l4 : index
          scf.if %live0 {
            vector.store %fw0, %att[%qt0, %ac0] {alignment = 16} : memref<?x?xf32>, vector<4xf32>
          }
          %inv1 = arith.divf %one, %st#3 : f32
          %iv1 = vector.broadcast %inv1 : f32 to vector<4xf32>
          %fr1 = arith.muli %j1, %c128 : index
          %fi1 = arith.addi %fr1, %l4 : index
          %fv1 = vector.load %so[%fi1] : memref<1024xf32, 3>, vector<4xf32>
          %fw1 = arith.mulf %fv1, %iv1 : vector<4xf32>
          %live1 = arith.cmpi ult, %qt1, %ni : index
          %ac1 = arith.addi %h128, %l4 : index
          scf.if %live1 {
            vector.store %fw1, %att[%qt1, %ac1] {alignment = 16} : memref<?x?xf32>, vector<4xf32>
          }
          macro.yield %qb : i32
        };
      }
    }
  }
  return;
}

/// Attention of each token of the chunk over the positions up to its own, as `nn_attention`: att[t]
/// = the query heads of token t one after another, the input of the output projection. Token t is
/// at position start + t. The tokens go in slices of up to ATTENTION_TOKENS tokens.
fn pf_attention(att : &mut Tensor<f32, [?, ?], Memory::HBM>, heads : &mut Tensor<f32, [?, ?], Memory::HBM>, scores : &mut Tensor<f32, [?, ?], Memory::HBM>, probs : &mut Tensor<f32, [?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  assert(q_heads % kv_heads == 0 && scores.extent(0) == kv_heads * 1024, "pf_attention: q_heads must be a multiple of kv_heads, and `scores` needs 1024 rows for each key-value head");
  let group = q_heads / kv_heads;
  let mut first = 0;
  while first < n {
    let m = i32::min(ATTENTION_TOKENS, n - first);
    let at = start + first;
    let width = (at + m + 31) / 32 * 32;
    pf_scores(scores, q, k_cache, first, at, m, group, head_dim);
    pf_softmax(probs, scores, at, m, group, width);
    pf_weigh_values(heads, probs, v_cache, at, m, group, head_dim, width);
    pf_flatten_heads(att, heads, first, m, q_heads, group, head_dim);
    first = first + m;
  }
  return;
}

/// y[first + t] = the query heads of token t of a slice one after another, for t below n. Head
/// g * group + j is x[g * 1024 + t * 8 + j], as `pf_weigh_values` writes it.
fn pf_flatten_heads(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, first : i32, n : i32, heads : i32, group : i32, head_dim : i32) -> void {
  let dim = heads * head_dim;
  spawn on(Topology::Device) {
    for t in 0..128 across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim && t < n {
            let h = i / head_dim;
            y[first + t][i] = x[(h / group) * 1024 + t * 8 + h % group][i % head_dim];
          }
        }
      }
    }
  }
  return;
}

/// out[r][i] = silu(gu[r][i]) * gu[r][rows + i], for r below n: the SwiGLU of each row.
fn pf_silu_mul(out : &mut Tensor<f32, [?, ?], Memory::HBM>, gu : &Tensor<f32, [?, ?], Memory::HBM>, n : i32, rows : i32) -> void {
  spawn on(Topology::Device) {
    for r in 0..n across blocks {
      for b in 0..(rows + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < rows {
            let g = gu[r][i];
            out[r][i] = g / (1.0 + (0.0 - g).fast_exp()) * gu[r][rows + i];
          }
        }
      }
    }
  }
  return;
}

/// The experts of each token of the chunk, as `nn_top_k` does for one token.
fn pf_top_k(ids : &mut Tensor<i32, [?, ?], Memory::HBM>, weights : &mut Tensor<f32, [?, ?], Memory::HBM>, logits : &Tensor<f32, [?, ?], Memory::HBM>, n_tokens : i32, n : i32, k : i32) -> void {
  assert(n > 0 && n <= 256 && k > 0 && k <= n, "pf_top_k: n must be 1 to 256, and k must be 1 to n");
  spawn on(Topology::Device) {
    for t in 0..n_tokens across blocks {
      let mut keys = unsafe { Tensor<i64, [256], Memory::SMEM>::uninit() };
      for l in 0..256 across lanes {
        if l < n {
          let bits = logits[t][l].to_bits() as i32;
          let mut order = bits;
          if bits < 0 {
            order = bits ^ 2147483647;
          }
          keys[l] = (order as i64) * 4294967296 + ((255 - l) as i64);
        }
      }
      lanes::sort_descending(&mut keys, n);
      for l in 0..256 across lanes {
        if l < k {
          let m = logits[t][255 - ((keys[0] & 255) as i32)];
          let mut total : f32 = 0.0;
          for j in 0..k {
            total = total + (logits[t][255 - ((keys[j] & 255) as i32)] - m).fast_exp();
          }
          let id = 255 - ((keys[l] & 255) as i32);
          ids[t][l] = id;
          weights[t][l] = (logits[t][id] - m).fast_exp() / total;
        }
      }
    }
  }
  return;
}

/// x[t] += the sum over j of weights[t][j] * out[slot[t * k + j]], for t below n: the experts of
/// each token, each times its weight, in the order of j.
fn pf_combine(x : &mut Tensor<f32, [?, ?], Memory::HBM>, out : &Tensor<f32, [?, ?], Memory::HBM>, weights : &Tensor<f32, [?, ?], Memory::HBM>, slot : &Tensor<i32, [?], Memory::HBM>, n : i32, k : i32, dim : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let mut s : f32 = 0.0;
            for j in 0..k {
              s = s + weights[t][j] * out[slot[t * k + j]][i];
            }
            x[t][i] = x[t][i] + s;
          }
        }
      }
    }
  }
  return;
}

/// y = x[t], a row of the chunk.
fn pf_take_row(y : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, t : i32, dim : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(dim + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < dim {
          y[i] = x[t][i];
        }
      }
    }
  }
  return;
}

// -------------------------------------------------------------------------- the chunk ---

/// For each expert e, the number of its choices among the n tokens of the chunk: e_counts[e], and
/// e_lane_counts[e * 32 + l] for the tokens of lane l of the sort, l * span to l * span + span - 1.
fn pf_count_experts(counts : &mut Tensor<i32, [?], Memory::HBM>, lane_counts : &mut Tensor<i32, [?], Memory::HBM>, ids : &Tensor<i32, [?, ?], Memory::HBM>, n : i32, k : i32, experts : i32) -> void {
  let span = (n + 31) / 32;
  spawn on(Topology::Device) {
    for e in 0..experts across blocks {
      let mut part = unsafe { Tensor<i32, [32], Memory::SMEM>::uninit() };
      for l in 0..32 across lanes {
        let mut c = 0;
        for i in 0..span {
          let t = l * span + i;
          if t < n {
            for j in 0..k {
              if ids[t][j] == e {
                c = c + 1;
              }
            }
          }
        }
        lane_counts[e * 32 + l] = c;
        part[l] = c;
      }
      for l in 0..32 across lanes {
        if l == 0 {
          let mut total = 0;
          for i in 0..32 {
            total = total + part[i];
          }
          counts[e] = total;
        }
      }
    }
  }
  return;
}

/// Places the choices of the chunk by expert: the tokens of expert e come after those of expert
/// e - 1, in the order of the tokens, and padding with -1 makes each expert a whole number of tiles
/// of 16. Each lane of the block of an expert places the choices of its tokens. The rows of
/// different tokens go to positions that the race proof cannot follow, so the stores are atomic
/// (vx-lang/Vx#3450).
fn pf_place_experts(rows : &Tensor<i32, [?], Memory::HBM>, slot : &Tensor<i32, [?], Memory::HBM>, counts : &Tensor<i32, [?], Memory::HBM>, lane_counts : &Tensor<i32, [?], Memory::HBM>, ids : &Tensor<i32, [?, ?], Memory::HBM>, n : i32, k : i32, experts : i32) -> void {
  let span = (n + 31) / 32;
  spawn on(Topology::Device) {
    for e in 0..experts across blocks {
      for l in 0..32 across lanes {
        let mut first = 0;
        for f in 0..e {
          first = first + (counts[f] + 31) / 32 * 32;
        }
        let mut at = first;
        for i in 0..l {
          at = at + lane_counts[e * 32 + i];
        }
        for i in 0..span {
          let t = l * span + i;
          if t < n {
            for j in 0..k {
              if ids[t][j] == e {
                atomic_store_i32(rows, at, t, AtomicOrdering::Relaxed);
                atomic_store_i32(slot, t * k + j, at, AtomicOrdering::Relaxed);
                at = at + 1;
              }
            }
          }
        }
        if l == 31 {
          let end = first + (counts[e] + 31) / 32 * 32;
          while at < end {
            atomic_store_i32(rows, at, -1, AtomicOrdering::Relaxed);
            at = at + 1;
          }
        }
      }
    }
  }
  return;
}

/// bases[tb] = the expert of tile tb, for each of the `tiles` tiles of the positions. The tiles
/// after those of the last expert get -1, and the products skip them.
fn pf_expert_bases(bases : &mut Tensor<i32, [?], Memory::HBM>, counts : &Tensor<i32, [?], Memory::HBM>, experts : i32, tiles : i32) -> void {
  spawn on(Topology::Device) {
    for tb in 0..tiles across blocks {
      for l in 0..1 across lanes {
        let mut end = 0;
        let mut base = -1;
        for e in 0..experts {
          end = end + (counts[e] + 31) / 32 * 32;
          if base < 0 && tb * 16 < end {
            base = e;
          }
        }
        bases[tb + l] = base;
      }
    }
  }
  return;
}

/// Sorts the choices of the chunk by expert, on the GPU, so that the CPU does not wait for the
/// router (#44). Gives the number of tiles of the products: all the tiles of the positions, because
/// the CPU does not know how many the experts use. The products skip the tiles after those of the
/// last expert.
fn pf_sort_by_expert(p : &mut Prefill, n : i32, k : i32, experts : i32) -> i32 {
  let tiles = p.e_rows.len() / 16;
  pf_count_experts(&mut p.e_counts, &mut p.e_lane_counts, &p.ids, n, k, experts);
  pf_place_experts(&p.e_rows, &p.slot, &p.e_counts, &p.e_lane_counts, &p.ids, n, k, experts);
  pf_expert_bases(&mut p.e_bases, &p.e_counts, experts, tiles);
  return tiles;
}

/// The mixture of experts of a layer, for the n tokens of the chunk: x += the experts of each
/// token, for the norm of x in xn.
fn pf_experts(p : &mut Prefill, layer : &Layer, c : &Config, n : i32, tiles : i32) -> void {
  let k = c.experts_per_token;
  let inter = c.moe_intermediate_size;
  pf_mm_bf16(&mut p.router, &layer.router, &p.xn, &p.rows, &p.zeros, 0, &p.no_bias, false, false, c.num_experts, c.hidden_size, tiles);
  pf_top_k(&mut p.ids, &mut p.wts, &p.router, n, c.num_experts, k);
  let e_tiles = pf_sort_by_expert(p, n, k, c.num_experts);
  pf_mm(&mut p.e_gu, &layer.gate_up, &p.xn, &p.e_rows, &p.e_bases, 2 * inter, &p.no_bias, false, false, 2 * inter, c.hidden_size, e_tiles);
  pf_silu_mul(&mut p.e_h, &p.e_gu, e_tiles * 16, inter);
  pf_mm(&mut p.e_out, &layer.down, &p.e_h, &p.e_ident, &p.e_bases, c.hidden_size, &p.no_bias, false, false, c.hidden_size, inter, e_tiles);
  pf_combine(&mut p.x, &p.e_out, &p.wts, &p.slot, n, k, c.hidden_size);
  return;
}

/// Runs tokens start to start + n - 1 of the prompt, in `p.tokens`, through every layer. Their
/// keys and values go to the caches, and their hidden states to p.x.
fn pf_chunk(w : &Weights, s : &mut State, p : &mut Prefill, start : i32, n : i32) -> void {
  let c = &w.config;
  let eps = c.rms_norm_eps as f32;
  let tiles = (n + 15) / 16;
  let qkv_rows = (c.num_q_heads + 2 * c.num_kv_heads) * c.head_dim;
  pf_embed(&mut p.x, &w.embed, &p.tokens, n, c.hidden_size);
  let mut l = 0;
  for cache in s.caches.iter_mut() {
    let layer = &w.layers[l];
    pf_rms_norm(&mut p.xn, &p.x, &layer.attn_norm, n, c.hidden_size, eps);
    pf_mm(&mut p.qkv, &layer.qkv, &p.xn, &p.rows, &p.zeros, 0, &layer.qkv_bias, c.qkv_bias, false, qkv_rows, c.hidden_size, tiles);
    if c.qk_norm {
      pf_norm_rope_and_store(&mut p.q, &mut cache.k, &mut cache.v, &p.qkv, &layer.q_norm, &layer.k_norm, &s.cos, &s.sin, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim, eps);
    } else {
      pf_rope_and_store(&mut p.q, &mut cache.k, &mut cache.v, &p.qkv, &s.cos, &s.sin, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim);
    }
    if c.head_dim == 128 {
      pf_flash_attention(&mut p.att, &p.q, &cache.k, &cache.v, start, n, c.num_q_heads, c.num_q_heads / c.num_kv_heads, 1.0 / (128.0 as f32).sqrt());
    } else {
      pf_attention(&mut p.att, &mut p.heads, &mut p.scores, &mut p.probs, &p.q, &cache.k, &cache.v, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim);
    }
    // The product goes to xn, which is free until the norm, so that it is not an add: the kernel
    // of a product with no add keeps its sums in registers.
    pf_mm(&mut p.xn, &layer.attn_out, &p.att, &p.rows, &p.zeros, 0, &p.no_bias, false, false, c.hidden_size, c.num_q_heads * c.head_dim, tiles);
    pf_add_rms_norm(&mut p.x, &mut p.xn, &layer.mlp_norm, n, c.hidden_size, eps);
    if c.num_experts > 0 {
      pf_experts(p, layer, c, n, tiles);
    } else {
      pf_mm(&mut p.gu, &layer.gate_up, &p.xn, &p.rows, &p.zeros, 0, &p.no_bias, false, false, 2 * c.intermediate_size, c.hidden_size, tiles);
      pf_silu_mul(&mut p.h, &p.gu, n, c.intermediate_size);
      pf_mm(&mut p.x, &layer.down, &p.h, &p.rows, &p.zeros, 0, &p.no_bias, false, true, c.hidden_size, c.intermediate_size, tiles);
    }
    l = l + 1;
  }
  return;
}

/// Runs tokens `first` to the end of `tokens` through every layer, in chunks of up to `p.chunk`
/// tokens. Token i goes to position i of the KV cache, so the cache must already hold the rows of
/// positions below `first`. The hidden state of the last token is then in `s.x`, as after
/// `run_layers`, so `predict` gives the next token.
fn run_prompt(w : &Weights, s : &mut State, p : &mut Prefill, tokens : &Vec<i32>, first : i32) -> void {
  let c = &w.config;
  let count = tokens.len();
  assert(first >= 0 && first < count && count <= s.max_seq, "run_prompt: the tokens must end after `first` and fit in the KV cache");
  let chunk = p.chunk;
  let mut start = first;
  let mut last = 0;
  while start < count {
    let n = i32::min(chunk, count - start);
    let mut ids = Tensor<i32>([chunk]);
    let mut rows = Tensor<i32>([p.rows.len()]);
    for t in 0..p.rows.len() {
      rows[t] = -1;
      if t < n {
        rows[t] = t;
      }
    }
    for t in 0..chunk {
      if t < n {
        ids[t] = tokens[start + t];
      } else {
        ids[t] = 0;
      }
    }
    p.tokens = transfer(ids, Memory::HBM);
    p.rows = transfer(rows, Memory::HBM);
    pf_chunk(w, s, p, start, n);
    last = n;
    start = start + n;
  }
  pf_take_row(&mut s.x, &p.x, last - 1, c.hidden_size);
  return;
}

/// Runs the prompt through every layer, in chunks of up to `chunk` tokens, from position 0.
fn prefill_in_chunks(w : &Weights, s : &mut State, prompt : &Vec<i32>, chunk : i32) -> void {
  let mut p = new_prefill(&w.config, s.max_seq, chunk);
  run_prompt(w, s, &mut p, prompt, 0);
  return;
}

/// `prefill_in_chunks` with chunks of up to CHUNK tokens, or fewer for a shorter prompt.
fn prefill(w : &Weights, s : &mut State, prompt : &Vec<i32>) -> void {
  let chunk = i32::min(CHUNK, (prompt.len() + 15) / 16 * 16);
  prefill_in_chunks(w, s, prompt, chunk);
  return;
}
