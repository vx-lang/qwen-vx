//===----------------------------------------------------------------------===//
// The prompt in chunks of up to CHUNK tokens. A token of the decoder reads every weight of a
// layer to make one product, so it waits for memory. A chunk reads each weight once for many
// tokens. The kernels here do for a chunk what the kernels of `std::nn` do for one token:
//
// - A matrix product is a list of tiles of 16 rows of the input. A list of input rows names the
//   row of each tile row, and -1 gives a row of zeros. For a dense layer the list is the tokens of
//   the chunk. For the experts of a layer, the CPU sorts the tokens by expert, so that each tile
//   has the tokens of one expert, and `bases` names that expert. A block of the product does 128
//   rows of the matrix for one tile. For each 32 columns, its lanes decode the weights and copy the
//   inputs into shared memory once, and each subgroup adds a matmul of tiles.
// - Attention is three passes over a scratch tensor of scores, [chunk, kv_heads, 8, positions]:
//   the scores, as a matmul of the queries and the keys of the cache; their softmax; and the sum
//   of the values with those weights, as a matmul of the weights and the values. The query heads
//   of a key-value head, at most 8, are the rows of the matmuls, so a tile of the cache serves
//   them all and two tokens. The matmuls skip the positions after the tokens of their tile.
import core::convert;
import core::num;
import std::nn;
import std::vec;
import qwen::weights;
import qwen::model;

/// The most tokens of a chunk, unless the caller gives another number. A multiple of 16. A bigger
/// chunk gives each expert more tokens, so each expert reads its weights fewer times and its tiles
/// of 16 tokens have less padding. Chunks of 2048 tokens make a prompt of 2000 to 8000 tokens 6 to
/// 10% faster than chunks of 512 (#42), and need about 320 MB more for the tensors of a chunk.
const CHUNK : i32 = 2048;

/// The most tokens of a chunk that attention takes at a time. The scratch tensor of the scores
/// has a row of positions for each of them, so it does not grow with the chunk.
const ATTENTION_TOKENS : i32 = 128;

/// The tensors of a chunk, made once. `rows` is the list of input rows of the dense products:
/// row t for a token of the chunk, and -1 after the last one. `zeros` gives the expert 0 to each
/// tile of a dense product. The `e_` tensors are those of the experts, in the order of the CPU's
/// sort: position p of `e_rows` is a token, or -1 for padding, and `slot[t][j]` is the position of
/// expert j of token t.
struct Prefill {
  chunk : i32,
  tokens : Tensor<i32, [?], Memory::HBM>,
  rows : Tensor<i32, [?], Memory::HBM>,
  zeros : Tensor<i32, [?], Memory::HBM>,
  no_bias : Tensor<bf16, [?], Memory::HBM>,
  x : Tensor<f32, [?, ?], Memory::HBM>,
  xn : Tensor<f32, [?, ?], Memory::HBM>,
  qkv : Tensor<f32, [?, ?], Memory::HBM>,
  q : Tensor<f32, [?, ?, ?], Memory::HBM>,
  heads : Tensor<f32, [?, ?, ?, ?], Memory::HBM>,
  att : Tensor<f32, [?, ?], Memory::HBM>,
  scores : Tensor<f32, [?, ?, ?, ?], Memory::HBM>,
  gu : Tensor<f32, [?, ?], Memory::HBM>,
  h : Tensor<f32, [?, ?], Memory::HBM>,
  router : Tensor<f32, [?, ?], Memory::HBM>,
  ids : Tensor<i32, [?, ?], Memory::HBM>,
  wts : Tensor<f32, [?, ?], Memory::HBM>,
  e_rows : Tensor<i32, [?], Memory::HBM>,
  e_ident : Tensor<i32, [?], Memory::HBM>,
  e_bases : Tensor<i32, [?], Memory::HBM>,
  slot : Tensor<i32, [?, ?], Memory::HBM>,
  e_gu : Tensor<f32, [?, ?], Memory::HBM>,
  e_h : Tensor<f32, [?, ?], Memory::HBM>,
  e_out : Tensor<f32, [?, ?], Memory::HBM>,
}

/// The positions of the experts of a chunk: one for each of its chunk * k choices, and up to 15 of
/// padding for each expert. A multiple of 16.
fn expert_positions(c : &Config, chunk : i32) -> i32 {
  let k = i32::max(c.experts_per_token, 1);
  let experts = i32::max(c.num_experts, 1);
  return (chunk * k + experts * 15 + 15) / 16 * 16;
}

/// The tensors for chunks of up to `chunk` tokens, at up to `max_seq` positions.
fn new_prefill(c : &Config, max_seq : i32, chunk : i32) -> Prefill {
  assert(chunk > 0 && chunk % 16 == 0, "new_prefill: the chunk must be a multiple of 16");
  let qkv_rows = (c.num_q_heads + 2 * c.num_kv_heads) * c.head_dim;
  let moe = c.num_experts > 0;
  let k = i32::max(c.experts_per_token, 1);
  let experts = i32::max(c.num_experts, 1);
  let positions = expert_positions(c, chunk);
  let mut ident = Tensor<i32>([positions]);
  for p in 0..positions {
    ident[p] = p;
  }
  // A dense model uses no tensor of the experts, and a model of experts no dense MLP.
  let mut dense_rows = 1;
  let mut moe_rows = 1;
  if moe {
    moe_rows = positions;
  } else {
    dense_rows = chunk;
  }
  let inter = i32::max(c.intermediate_size, 1);
  let moe_inter = i32::max(c.moe_intermediate_size, 1);
  return Prefill {
    chunk: chunk,
    tokens: transfer(Tensor<i32>([chunk]), Memory::HBM),
    rows: transfer(Tensor<i32>([chunk]), Memory::HBM),
    zeros: transfer(Tensor<i32>([chunk / 16]), Memory::HBM),
    no_bias: transfer(Tensor<bf16>([1]), Memory::HBM),
    x: transfer(Tensor<f32>([chunk, c.hidden_size]), Memory::HBM),
    xn: transfer(Tensor<f32>([chunk, c.hidden_size]), Memory::HBM),
    qkv: transfer(Tensor<f32>([chunk, qkv_rows]), Memory::HBM),
    q: transfer(Tensor<f32>([chunk, c.num_q_heads, c.head_dim]), Memory::HBM),
    heads: transfer(Tensor<f32>([chunk, c.num_kv_heads, 8, c.head_dim]), Memory::HBM),
    att: transfer(Tensor<f32>([chunk, c.num_q_heads * c.head_dim]), Memory::HBM),
    scores: transfer(Tensor<f32>([i32::min(chunk, ATTENTION_TOKENS), c.num_kv_heads, 8, (max_seq + 31) / 32 * 32]), Memory::HBM),
    gu: transfer(Tensor<f32>([dense_rows, 2 * inter]), Memory::HBM),
    h: transfer(Tensor<f32>([dense_rows, inter]), Memory::HBM),
    router: transfer(Tensor<f32>([chunk, experts]), Memory::HBM),
    ids: transfer(Tensor<i32>([chunk, k]), Memory::HBM),
    wts: transfer(Tensor<f32>([chunk, k]), Memory::HBM),
    e_rows: transfer(Tensor<i32>([positions]), Memory::HBM),
    e_ident: transfer(ident, Memory::HBM),
    e_bases: transfer(Tensor<i32>([positions / 16]), Memory::HBM),
    slot: transfer(Tensor<i32>([chunk, k]), Memory::HBM),
    e_gu: transfer(Tensor<f32>([moe_rows, 2 * moe_inter]), Memory::HBM),
    e_h: transfer(Tensor<f32>([moe_rows, moe_inter]), Memory::HBM),
    e_out: transfer(Tensor<f32>([moe_rows, c.hidden_size]), Memory::HBM),
  };
}

// ----------------------------------------------------------------------------- products ---
//
// y[16b + t][r] = (row bases[b] * stride + r of w) . x[list[16b + t]], for r below `rows`, and
// each tile b below `tiles`. With `use_bias`, b[r] is added. With `add`, y gets the product added
// instead. `cols` must be a multiple of 32.

/// The product of a bf16 matrix.
fn pf_mm_bf16(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<bf16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  assert(cols % 32 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_bf16: cols must be a multiple of 32, and list and bases need the tiles");
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sa = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe {
          Tensor<f32, [1, 32, 16], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 32, 16], Memory::SMEM>::uninit()
        };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            for t in 0..16 {
              acc[sg][l][t] = 0.0;
            }
          }
        }
        for g in 0..groups {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let at = (bases[tb] * stride + r) * cols + g * 32;
                for k in 0..32 {
                  sa[sg][l][k] = w[at + k] as f32;
                }
              } else {
                for k in 0..32 {
                  sa[sg][l][k] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sb[0][l][sg * 4 + q] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sa[sg] @ sb[0];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][l][t];
                } else {
                  y[tb * 16 + t][r] = acc[sg][l][t] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The product of an fp8 matrix, in the format of `nn_matvec_fp8`: each code decodes through a
/// table of 256 values in shared memory, times the scale of its block of 128 x 128.
fn pf_mm_fp8(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  assert(cols % 128 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_fp8: cols must be a multiple of 128, and list and bases need the tiles");
  let groups = cols / 32;
  let words = cols / 4;
  let blocks_per_row = cols / 128;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sa = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe {
          Tensor<f32, [1, 32, 16], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 32, 16], Memory::SMEM>::uninit()
        };
        let mut lut = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            // As in `nn_matvec_fp8`: e = 0 gives m * 2^-9, else the bits with 120 added to the
            // exponent are the value in f32.
            let mag = (sg * 32 + l) as u32;
            let mut value = f32::from_bits((mag << 20u32) + 1006632960u32);
            if mag < 8u32 {
              value = (mag as f32) * 0.001953125;
            }
            lut[sg * 32 + l] = value;
            lut[sg * 32 + l + 128] = 0.0 - value;
            for t in 0..16 {
              acc[sg][l][t] = 0.0;
            }
          }
        }
        for g in 0..groups {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let row = bases[tb] * stride + r;
                let at = row * words + g * 8;
                let scale = scales[(row / 128) * blocks_per_row + g / 4];
                for i in 0..8 {
                  let word = w[at + i];
                  sa[sg][l][i * 4] = lut[(word & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 1] = lut[((word >> 8u32) & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 2] = lut[((word >> 16u32) & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 3] = lut[(word >> 24u32) as i32] * scale;
                }
              } else {
                for k in 0..32 {
                  sa[sg][l][k] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sb[0][l][sg * 4 + q] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sa[sg] @ sb[0];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][l][t];
                } else {
                  y[tb * 16 + t][r] = acc[sg][l][t] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The product of a Q4_0 matrix, in the format of `nn_matvec_q4`: a weight is (code - 8) times
/// the f16 scale of its 32 columns. The weights go to shared memory as [column][row], and the
/// inputs as [token][column], so that the lanes of a subgroup write consecutive words, and the
/// matmul gives [token][row].
fn pf_mm_q4(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  assert(cols % 32 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_q4: cols must be a multiple of 32, and list and bases need the tiles");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sw = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sx = unsafe {
          Tensor<f32, [1, 16, 32], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 16, 32], Memory::SMEM>::uninit()
        };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            for t in 0..16 {
              acc[sg][t][l] = 0.0;
            }
          }
        }
        for g in 0..groups {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let row = bases[tb] * stride + r;
                let at = row * words + g * 4;
                let sc = scales[row * groups + g] as f32;
                let m = -8.0 * sc;
                for i in 0..4 {
                  let word = w[at + i];
                  sw[sg][i * 8][l] = ((word & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 1][l] = (((word >> 4u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 2][l] = (((word >> 8u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 3][l] = (((word >> 12u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 4][l] = (((word >> 16u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 5][l] = (((word >> 20u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 6][l] = (((word >> 24u32) & 15u32) as f32) * sc + m;
                  sw[sg][i * 8 + 7][l] = (((word >> 28u32) & 15u32) as f32) * sc + m;
                }
              } else {
                for k in 0..32 {
                  sw[sg][k][l] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sx[0][sg * 4 + q][l] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sx[0] @ sw[sg];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][t][l];
                } else {
                  y[tb * 16 + t][r] = acc[sg][t][l] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The product of `m`, with the kernel for its dtype.
fn pf_mm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, m : &WeightMatrix, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  if m.dtype == U4 {
    pf_mm_q4(y, &m.codes, &m.group_scales, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  } else if m.dtype == F8E4M3 {
    pf_mm_fp8(y, &m.codes, &m.scales, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  } else {
    pf_mm_bf16(y, &m.bf16, x, list, bases, stride, bias, use_bias, add, rows, cols, tiles);
  }
  return;
}

// ------------------------------------------------------------------ the other kernels ---

/// x[t] = row tokens[t] of `table`, for t below n.
fn pf_embed(x : &mut Tensor<f32, [?, ?], Memory::HBM>, table : &Tensor<bf16, [?], Memory::HBM>, tokens : &Tensor<i32, [?], Memory::HBM>, n : i32, dim : i32) -> void {
  let rows = table.len() / dim;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let token = tokens[t];
            assert(token >= 0 && token < rows, "pf_embed: a token is not a row of the table");
            x[t][i] = table[token * dim + i] as f32;
          }
        }
      }
    }
  }
  return;
}

/// y[t] = the RMSNorm of x[t] times w, as `nn_rms_norm`, for t below n.
fn pf_rms_norm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<bf16, [?], Memory::HBM>, n : i32, dim : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
      for l in 0..1024 across lanes {
        let mut s : f32 = 0.0;
        let mut i = l;
        while i < dim {
          s = s + x[t][i] * x[t][i];
          i = i + 1024;
        }
        part[l] = s;
      }
      let ss = lanes::sum(&part, 1024);
      let inv = 1.0 / (ss / (dim as f32) + eps).sqrt();
      for l in 0..1024 across lanes {
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            y[t][i] = x[t][i] * inv * (w[i] as f32);
          }
        }
      }
    }
  }
  return;
}

/// RoPE for the tokens of the chunk, as `nn_rope_and_store`: token t is at position start + t.
/// The heads of q, k and v are one after another in qkv[t].
fn pf_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, qkv : &Tensor<f32, [?, ?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  assert(start + n <= k_cache.extent(0) && start + n <= cos.extent(0), "pf_rope_and_store: the chunk goes past the end of the KV cache");
  let half = head_dim / 2;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        for i in 0..128 across lanes {
          if i < head_dim {
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let pos = start + t;
            let c = cos[pos][j];
            let s = sin[pos][j];
            let base = h * head_dim;
            if h < q_heads {
              q_out[t][h][i] = qkv[t][base + i] * c + sign * qkv[t][base + partner] * s;
            } else {
              k_cache[start + t][h - q_heads][i] = (qkv[t][base + i] * c + sign * qkv[t][base + partner] * s) as f16;
              v_cache[start + t][h - q_heads][i] = qkv[t][base + kv_heads * head_dim + i] as f16;
            }
          }
        }
      }
    }
  }
  return;
}

/// As `pf_rope_and_store`, after the RMSNorm of each head of q and k, as `nn_norm_rope_and_store`.
fn pf_norm_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, qkv : &Tensor<f32, [?, ?], Memory::HBM>, q_norm : &Tensor<bf16, [?], Memory::HBM>, k_norm : &Tensor<bf16, [?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32, eps : f32) -> void {
  assert(start + n <= k_cache.extent(0) && start + n <= cos.extent(0), "pf_norm_rope_and_store: the chunk goes past the end of the KV cache");
  let half = head_dim / 2;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        let mut x = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        for i in 0..128 across lanes {
          let mut a : f32 = 0.0;
          if i < head_dim {
            a = qkv[t][h * head_dim + i];
          }
          x[i] = a;
          part[i] = a * a;
        }
        let ss = lanes::sum(&part, 128);
        let inv = 1.0 / (ss / (head_dim as f32) + eps).sqrt();
        for i in 0..128 across lanes {
          if i < head_dim {
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let pos = start + t;
            let c = cos[pos][j];
            let s = sin[pos][j];
            if h < q_heads {
              let a = x[i] * inv * (q_norm[i] as f32);
              let b = x[partner] * inv * (q_norm[partner] as f32);
              q_out[t][h][i] = a * c + sign * b * s;
            } else {
              let a = x[i] * inv * (k_norm[i] as f32);
              let b = x[partner] * inv * (k_norm[partner] as f32);
              k_cache[start + t][h - q_heads][i] = (a * c + sign * b * s) as f16;
              v_cache[start + t][h - q_heads][i] = qkv[t][(h + kv_heads) * head_dim + i] as f16;
            }
          }
        }
      }
    }
  }
  return;
}

/// The scores of attention, for the n tokens of a chunk from token `first`, at positions start to
/// start + n - 1: scores[t][g][j][p] = (query head g * group + j of token first + t) . (key p of
/// head g) / sqrt(head_dim). A block does two tokens, the 16 rows of their query heads, against
/// 128 positions, as a matmul of tiles. It skips the positions that neither token sees, and so
/// writes the scores of p up to start + t + 1 at least, but not those of p at start + n or after.
fn pf_scores(scores : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, first : i32, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  assert(q_heads % kv_heads == 0 && q_heads / kv_heads <= 8 && head_dim <= 128, "pf_scores: q_heads must be a multiple of kv_heads, and at most 8 times it, and head_dim at most 128");
  let group = q_heads / kv_heads;
  let end = start + n;
  assert(scores.extent(0) >= n && first + n <= q.extent(0), "pf_scores: `scores` needs n tokens, and q first + n");
  assert(scores.extent(3) >= end && end <= k_cache.extent(0), "pf_scores: `scores` and the cache need start + n positions");
  let scale = 1.0 / (head_dim as f32).sqrt();
  let dims = (head_dim + 31) / 32;
  spawn on(Topology::Device) {
    for g in 0..kv_heads across blocks {
      for tp in 0..(n + 1) / 2 across blocks {
        for pb in 0..(end + 127) / 128 across blocks {
          let mut sk = unsafe { Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit() };
          let mut sq = unsafe { Tensor<f32, [1, 16, 32], Memory::SMEM>::uninit() };
          let mut acc = unsafe { Tensor<f32, [4, 16, 32], Memory::SMEM>::uninit() };
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              for m in 0..16 {
                acc[sg][m][l] = 0.0;
              }
            }
          }
          // The second token of the pair sees the positions up to start + 2 tp + 1.
          // 1 when the pair sees position pb * 128, else 0: (x + K) / (K + 1) is min(max(x, 0), 1)
          // for |x| up to K.
          let steps = dims * ((start + tp * 2 + 2 - pb * 128 + 1048576) / 1048577);
          for kc in 0..steps {
            for sg in 0..4 across subgroups {
              for l in 0..32 across lanes(32) {
                let p = pb * 128 + sg * 32 + l;
                for k in 0..32 {
                  let d = kc * 32 + k;
                  let mut v : f32 = 0.0;
                  if p < end && d < head_dim {
                    v = k_cache[p][g][d] as f32;
                  }
                  sk[sg][k][l] = v;
                }
                for i in 0..4 {
                  let t = tp * 2 + sg / 2;
                  let j = (sg % 2) * 4 + i;
                  let d = kc * 32 + l;
                  let mut v : f32 = 0.0;
                  if t < n && j < group && d < head_dim {
                    v = q[first + t][g * group + j][d] * scale;
                  }
                  sq[0][sg * 4 + i][l] = v;
                }
              }
            }
            for sg in 0..4 across subgroups {
              acc[sg] = acc[sg] + sq[0] @ sk[sg];
            }
          }
          if steps > 0 {
            for sg in 0..4 across subgroups {
              for l in 0..32 across lanes(32) {
                let p = pb * 128 + sg * 32 + l;
                if p < end {
                  for m2 in 0..2 {
                    for j in 0..8 {
                      if tp * 2 + m2 < n && j < group {
                        scores[tp * 2 + m2][g][j][p] = acc[sg][m2 * 8 + j][l];
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The softmax of the scores of each token t over the positions up to its own, start + t, in
/// place. The positions after it, up to `width`, get 0, so that `pf_weigh_values` can read them.
fn pf_softmax(scores : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, start : i32, n : i32, kv_heads : i32, group : i32, width : i32) -> void {
  assert(scores.extent(3) >= width && width >= start + n, "pf_softmax: `scores` needs `width` positions");
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for g in 0..kv_heads across blocks {
        let mut top = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
        let mut sums = unsafe { Tensor<f32, [8, 32], Memory::SMEM>::uninit() };
        let pos = start + t;
        for j in 0..8 across subgroups {
          for l in 0..32 across lanes(32) {
            let mut m : f32 = -3.0e38;
            if j < group {
              for b in 0..(pos + 32) / 32 {
                let p = b * 32 + l;
                if p <= pos {
                  m = m.max(scores[t][g][j][p]);
                }
              }
            }
            top[j][l] = m;
          }
          let big = lanes::max(&top[j], 32);
          for l in 0..32 across lanes(32) {
            let mut s : f32 = 0.0;
            if j < group {
              for b in 0..(pos + 32) / 32 {
                let p = b * 32 + l;
                if p <= pos {
                  let e = (scores[t][g][j][p] - big).fast_exp();
                  scores[t][g][j][p] = e;
                  s = s + e;
                }
              }
            }
            sums[j][l] = s;
          }
          let total = lanes::sum(&sums[j], 32);
          for l in 0..32 across lanes(32) {
            if j < group {
              let inv = 1.0 / total;
              for b in 0..(width + 31) / 32 {
                let p = b * 32 + l;
                if p <= pos {
                  scores[t][g][j][p] = scores[t][g][j][p] * inv;
                } else if p < width {
                  scores[t][g][j][p] = 0.0;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// out[first + t][g][j] = the sum of the rows p of V of head g, each times its weight
/// scores[t][g][j][p], over the positions that token t sees, for t below n. Token t is at position
/// start + t. A block does the 16 rows of two tokens, for all the
/// values of a head, as a matmul of tiles. It reads the weights up to a multiple of 32, so those
/// after start + t must be 0, as `pf_softmax` leaves them.
fn pf_weigh_values(out : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, scores : &Tensor<f32, [?, ?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, first : i32, start : i32, n : i32, kv_heads : i32, group : i32, head_dim : i32) -> void {
  let end = start + n;
  assert(scores.extent(3) >= (end + 31) / 32 * 32 && head_dim <= 128, "pf_weigh_values: `scores` needs start + n positions, rounded up to 32");
  assert(first + n <= out.extent(0), "pf_weigh_values: `out` needs first + n tokens");
  spawn on(Topology::Device) {
    for g in 0..kv_heads across blocks {
      for tp in 0..(n + 1) / 2 across blocks {
        let mut sv = unsafe { Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit() };
        let mut sp = unsafe { Tensor<f32, [1, 16, 32], Memory::SMEM>::uninit() };
        let mut acc = unsafe { Tensor<f32, [4, 16, 32], Memory::SMEM>::uninit() };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            for m in 0..16 {
              acc[sg][m][l] = 0.0;
            }
          }
        }
        // The second token of the pair sees start + 2 tp + 2 positions.
        // min(start + tp * 2 + 2, end), as tp * 2 + 2 is at most n + 1.
        let seen = start + tp * 2 + 2 - (tp * 2 + 2) / (n + 1);
        for kc in 0..(seen + 31) / 32 {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let d = sg * 32 + l;
              for k in 0..32 {
                let p = kc * 32 + k;
                let mut v : f32 = 0.0;
                if p < end && d < head_dim {
                  v = v_cache[p][g][d] as f32;
                }
                sv[sg][k][l] = v;
              }
              for i in 0..4 {
                let t = tp * 2 + sg / 2;
                let j = (sg % 2) * 4 + i;
                let mut v : f32 = 0.0;
                if t < n && j < group {
                  v = scores[t][g][j][kc * 32 + l];
                }
                sp[0][sg * 4 + i][l] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sp[0] @ sv[sg];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let d = sg * 32 + l;
            if d < head_dim {
              for m2 in 0..2 {
                for j in 0..8 {
                  if tp * 2 + m2 < n && j < group {
                    out[first + tp * 2 + m2][g][j][d] = acc[sg][m2 * 8 + j][l];
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// Attention of each token of the chunk over the positions up to its own, as `nn_attention`. Token
/// t is at position start + t. Query head g * group + j of token t goes to out[t][g][j]. The
/// tokens go in slices of as many tokens as `scores` has rows for.
fn pf_attention(out : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, scores : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  let group = q_heads / kv_heads;
  let slice = scores.extent(0);
  let mut first = 0;
  while first < n {
    let m = i32::min(slice, n - first);
    let at = start + first;
    pf_scores(scores, q, k_cache, first, at, m, q_heads, kv_heads, head_dim);
    pf_softmax(scores, at, m, kv_heads, group, (at + m + 31) / 32 * 32);
    pf_weigh_values(out, scores, v_cache, first, at, m, kv_heads, group, head_dim);
    first = first + m;
  }
  return;
}

/// y[t] = the query heads of x[t] one after another, for t below n: the input of the output
/// projection. Head g * group + j is x[t][g][j], as `pf_attention` writes it.
fn pf_flatten_heads(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?, ?, ?], Memory::HBM>, n : i32, heads : i32, group : i32, head_dim : i32) -> void {
  let dim = heads * head_dim;
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let h = i / head_dim;
            y[t][i] = x[t][h / group][h % group][i % head_dim];
          }
        }
      }
    }
  }
  return;
}

/// out[r][i] = silu(gu[r][i]) * gu[r][rows + i], for r below n: the SwiGLU of each row.
fn pf_silu_mul(out : &mut Tensor<f32, [?, ?], Memory::HBM>, gu : &Tensor<f32, [?, ?], Memory::HBM>, n : i32, rows : i32) -> void {
  spawn on(Topology::Device) {
    for r in 0..n across blocks {
      for b in 0..(rows + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < rows {
            let g = gu[r][i];
            out[r][i] = g / (1.0 + (0.0 - g).fast_exp()) * gu[r][rows + i];
          }
        }
      }
    }
  }
  return;
}

/// The experts of each token of the chunk, as `nn_top_k` does for one token.
fn pf_top_k(ids : &mut Tensor<i32, [?, ?], Memory::HBM>, weights : &mut Tensor<f32, [?, ?], Memory::HBM>, logits : &Tensor<f32, [?, ?], Memory::HBM>, n_tokens : i32, n : i32, k : i32) -> void {
  assert(n > 0 && n <= 256 && k > 0 && k <= n, "pf_top_k: n must be 1 to 256, and k must be 1 to n");
  spawn on(Topology::Device) {
    for t in 0..n_tokens across blocks {
      let mut keys = unsafe { Tensor<i64, [256], Memory::SMEM>::uninit() };
      for l in 0..256 across lanes {
        if l < n {
          let bits = logits[t][l].to_bits() as i32;
          let mut order = bits;
          if bits < 0 {
            order = bits ^ 2147483647;
          }
          keys[l] = (order as i64) * 4294967296 + ((255 - l) as i64);
        }
      }
      lanes::sort_descending(&mut keys, n);
      for l in 0..256 across lanes {
        if l < k {
          let m = logits[t][255 - ((keys[0] & 255) as i32)];
          let mut total : f32 = 0.0;
          for j in 0..k {
            total = total + (logits[t][255 - ((keys[j] & 255) as i32)] - m).fast_exp();
          }
          let id = 255 - ((keys[l] & 255) as i32);
          ids[t][l] = id;
          weights[t][l] = (logits[t][id] - m).fast_exp() / total;
        }
      }
    }
  }
  return;
}

/// x[t] += the sum over j of weights[t][j] * out[slot[t][j]], for t below n: the experts of each
/// token, each times its weight, in the order of j.
fn pf_combine(x : &mut Tensor<f32, [?, ?], Memory::HBM>, out : &Tensor<f32, [?, ?], Memory::HBM>, weights : &Tensor<f32, [?, ?], Memory::HBM>, slot : &Tensor<i32, [?, ?], Memory::HBM>, n : i32, k : i32, dim : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let mut s : f32 = 0.0;
            for j in 0..k {
              s = s + weights[t][j] * out[slot[t][j]][i];
            }
            x[t][i] = x[t][i] + s;
          }
        }
      }
    }
  }
  return;
}

/// y = x[t], a row of the chunk.
fn pf_take_row(y : &mut Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, t : i32, dim : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(dim + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < dim {
          y[i] = x[t][i];
        }
      }
    }
  }
  return;
}

// -------------------------------------------------------------------------- the chunk ---

/// Sorts the choices of the chunk by expert, on the CPU: the tokens of expert e come after those
/// of expert e - 1, in the order of the tokens, and padding with -1 makes each expert a whole
/// number of tiles of 16. Gives the number of tiles.
fn sort_by_expert(p : &mut Prefill, n : i32, k : i32, experts : i32) -> i32 {
  let ids = transfer(&p.ids, Memory::CPU_DRAM);
  let positions = p.e_rows.len();
  let mut rows = Tensor<i32>([positions]);
  let mut bases = Tensor<i32>([positions / 16]);
  let mut slot = Tensor<i32>([p.chunk, k]);
  let mut at = 0;
  for e in 0..experts {
    let first = at;
    for t in 0..n {
      for j in 0..k {
        if ids[t][j] == e {
          rows[at] = t;
          slot[t][j] = at;
          at = at + 1;
        }
      }
    }
    while at % 16 != 0 {
      rows[at] = -1;
      at = at + 1;
    }
    let mut b = first / 16;
    while b < at / 16 {
      bases[b] = e;
      b = b + 1;
    }
  }
  assert(at <= positions, "sort_by_expert: more positions than the chunk has");
  p.e_rows = transfer(rows, Memory::HBM);
  p.e_bases = transfer(bases, Memory::HBM);
  p.slot = transfer(slot, Memory::HBM);
  return at / 16;
}

/// The mixture of experts of a layer, for the n tokens of the chunk: x += the experts of each
/// token, for the norm of x in xn.
fn pf_experts(p : &mut Prefill, layer : &Layer, c : &Config, n : i32, tiles : i32) -> void {
  let k = c.experts_per_token;
  let inter = c.moe_intermediate_size;
  pf_mm_bf16(&mut p.router, &layer.router, &p.xn, &p.rows, &p.zeros, 0, &p.no_bias, false, false, c.num_experts, c.hidden_size, tiles);
  pf_top_k(&mut p.ids, &mut p.wts, &p.router, n, c.num_experts, k);
  let e_tiles = sort_by_expert(p, n, k, c.num_experts);
  pf_mm(&mut p.e_gu, &layer.gate_up, &p.xn, &p.e_rows, &p.e_bases, 2 * inter, &p.no_bias, false, false, 2 * inter, c.hidden_size, e_tiles);
  pf_silu_mul(&mut p.e_h, &p.e_gu, e_tiles * 16, inter);
  pf_mm(&mut p.e_out, &layer.down, &p.e_h, &p.e_ident, &p.e_bases, c.hidden_size, &p.no_bias, false, false, c.hidden_size, inter, e_tiles);
  pf_combine(&mut p.x, &p.e_out, &p.wts, &p.slot, n, k, c.hidden_size);
  return;
}

/// Runs tokens start to start + n - 1 of the prompt, in `p.tokens`, through every layer. Their
/// keys and values go to the caches, and their hidden states to p.x.
fn pf_chunk(w : &Weights, s : &mut State, p : &mut Prefill, start : i32, n : i32) -> void {
  let c = &w.config;
  let eps = c.rms_norm_eps as f32;
  let tiles = (n + 15) / 16;
  let qkv_rows = (c.num_q_heads + 2 * c.num_kv_heads) * c.head_dim;
  pf_embed(&mut p.x, &w.embed, &p.tokens, n, c.hidden_size);
  let mut l = 0;
  for cache in s.caches.iter_mut() {
    let layer = &w.layers[l];
    pf_rms_norm(&mut p.xn, &p.x, &layer.attn_norm, n, c.hidden_size, eps);
    pf_mm(&mut p.qkv, &layer.qkv, &p.xn, &p.rows, &p.zeros, 0, &layer.qkv_bias, true, false, qkv_rows, c.hidden_size, tiles);
    if c.qk_norm {
      pf_norm_rope_and_store(&mut p.q, &mut cache.k, &mut cache.v, &p.qkv, &layer.q_norm, &layer.k_norm, &s.cos, &s.sin, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim, eps);
    } else {
      pf_rope_and_store(&mut p.q, &mut cache.k, &mut cache.v, &p.qkv, &s.cos, &s.sin, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim);
    }
    pf_attention(&mut p.heads, &mut p.scores, &p.q, &cache.k, &cache.v, start, n, c.num_q_heads, c.num_kv_heads, c.head_dim);
    pf_flatten_heads(&mut p.att, &p.heads, n, c.num_q_heads, c.num_q_heads / c.num_kv_heads, c.head_dim);
    pf_mm(&mut p.x, &layer.attn_out, &p.att, &p.rows, &p.zeros, 0, &p.no_bias, false, true, c.hidden_size, c.num_q_heads * c.head_dim, tiles);
    pf_rms_norm(&mut p.xn, &p.x, &layer.mlp_norm, n, c.hidden_size, eps);
    if c.num_experts > 0 {
      pf_experts(p, layer, c, n, tiles);
    } else {
      pf_mm(&mut p.gu, &layer.gate_up, &p.xn, &p.rows, &p.zeros, 0, &p.no_bias, false, false, 2 * c.intermediate_size, c.hidden_size, tiles);
      pf_silu_mul(&mut p.h, &p.gu, n, c.intermediate_size);
      pf_mm(&mut p.x, &layer.down, &p.h, &p.rows, &p.zeros, 0, &p.no_bias, false, true, c.hidden_size, c.intermediate_size, tiles);
    }
    l = l + 1;
  }
  return;
}

/// Runs tokens `first` to the end of `tokens` through every layer, in chunks of up to `p.chunk`
/// tokens. Token i goes to position i of the KV cache, so the cache must already hold the rows of
/// positions below `first`. The hidden state of the last token is then in `s.x`, as after
/// `run_layers`, so `predict` gives the next token.
fn run_prompt(w : &Weights, s : &mut State, p : &mut Prefill, tokens : &Vec<i32>, first : i32) -> void {
  let c = &w.config;
  let count = tokens.len();
  assert(first >= 0 && first < count && count <= s.max_seq, "run_prompt: the tokens must end after `first` and fit in the KV cache");
  let chunk = p.chunk;
  let mut start = first;
  let mut last = 0;
  while start < count {
    let n = i32::min(chunk, count - start);
    let mut ids = Tensor<i32>([chunk]);
    let mut rows = Tensor<i32>([chunk]);
    for t in 0..chunk {
      if t < n {
        ids[t] = tokens[start + t];
        rows[t] = t;
      } else {
        ids[t] = 0;
        rows[t] = -1;
      }
    }
    p.tokens = transfer(ids, Memory::HBM);
    p.rows = transfer(rows, Memory::HBM);
    pf_chunk(w, s, p, start, n);
    last = n;
    start = start + n;
  }
  pf_take_row(&mut s.x, &p.x, last - 1, c.hidden_size);
  return;
}

/// Runs the prompt through every layer, in chunks of up to `chunk` tokens, from position 0.
fn prefill_in_chunks(w : &Weights, s : &mut State, prompt : &Vec<i32>, chunk : i32) -> void {
  let mut p = new_prefill(&w.config, s.max_seq, chunk);
  run_prompt(w, s, &mut p, prompt, 0);
  return;
}

/// `prefill_in_chunks` with chunks of up to CHUNK tokens, or fewer for a shorter prompt.
fn prefill(w : &Weights, s : &mut State, prompt : &Vec<i32>) -> void {
  let chunk = i32::min(CHUNK, (prompt.len() + 15) / 16 * 16);
  prefill_in_chunks(w, s, prompt, chunk);
  return;
}
