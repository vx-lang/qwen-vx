//===----------------------------------------------------------------------===//
// The prompt in chunks of up to CHUNK tokens. A token of the decoder reads every weight of a
// layer to make one product, so it waits for memory. A chunk reads each weight once for many
// tokens. The kernels here do for a chunk what the kernels of `std::nn` do for one token:
//
// - A matrix product is a list of tiles of 16 rows of the input. A list of input rows names the
//   row of each tile row, and -1 gives a row of zeros. For a dense layer the list is the tokens of
//   the chunk. For the experts of a layer, the CPU sorts the tokens by expert, so that each tile
//   has the tokens of one expert, and `bases` names that expert. A block of the product does 128
//   rows of the matrix for one tile. For each 32 columns, its lanes decode the weights and copy the
//   inputs into shared memory once, and each subgroup adds a matmul of tiles.
// - Attention is three passes over scratch tensors of scores, with 1024 rows for each key-value
//   head (8 for each of ATTENTION_TOKENS tokens) and a column for each position: the scores, as a
//   matmul of the queries and the keys of the cache; their softmax; and the sum of the values with
//   those weights, as a matmul of the weights and the values. The query heads of a key-value head,
//   at most 8, are the rows of the matmuls, so a tile of the cache serves them all and four
//   tokens. The matmuls keep their sums in registers, and skip the positions after the tokens of
//   their tile. The queries and the weights stay f32; the keys and values are f16, as in the cache.
import core::convert;
import core::num;
import core::sync::atomic;
import std::nn;
import std::vec;
import qwen::weights;
import qwen::model;

/// The most tokens of a chunk, unless the caller gives another number. A multiple of 16. A bigger
/// chunk gives each expert more tokens, so each expert reads its weights fewer times and its tiles
/// of 16 tokens have less padding. Chunks of 2048 tokens make a prompt of 2000 to 8000 tokens 6 to
/// 10% faster than chunks of 512 (#42), and need about 320 MB more for the tensors of a chunk.
const CHUNK : i32 = 2048;

/// The most tokens of a chunk that attention takes at a time. The scratch tensors of the scores
/// have a row of positions for each query head of each of them, 1024 rows for each key-value head,
/// so they do not grow with the chunk. The kernels take it as 32 tiles of 4 tokens.
const ATTENTION_TOKENS : i32 = 128;

/// The tensors of a chunk, made once. `rows` is the list of input rows of the dense products:
/// row t for a token of the chunk, and -1 after the last one. `zeros` gives the expert 0 to each
/// tile of a dense product. The `e_` tensors are those of the experts, in the order of the sort
/// (`pf_sort_by_expert`): position p of `e_rows` is a token, or -1 for padding, and
/// `slot[t * k + j]` is the position of expert j of token t. `e_counts[e]` is the number of choices
/// of expert e, and `e_lane_counts[e * 32 + l]` those in the tokens of lane l of the sort.
struct Prefill {
  chunk : i32,
  tokens : Tensor<i32, [?], Memory::HBM>,
  rows : Tensor<i32, [?], Memory::HBM>,
  zeros : Tensor<i32, [?], Memory::HBM>,
  no_bias : Tensor<bf16, [?], Memory::HBM>,
  x : Tensor<f32, [?, ?], Memory::HBM>,
  xn : Tensor<f32, [?, ?], Memory::HBM>,
  qkv : Tensor<f32, [?, ?], Memory::HBM>,
  q : Tensor<f32, [?, ?, ?], Memory::HBM>,
  heads : Tensor<f32, [?, ?], Memory::HBM>,
  att : Tensor<f32, [?, ?], Memory::HBM>,
  scores : Tensor<f32, [?, ?], Memory::HBM>,
  probs : Tensor<f32, [?, ?], Memory::HBM>,
  gu : Tensor<f32, [?, ?], Memory::HBM>,
  h : Tensor<f32, [?, ?], Memory::HBM>,
  router : Tensor<f32, [?, ?], Memory::HBM>,
  ids : Tensor<i32, [?, ?], Memory::HBM>,
  wts : Tensor<f32, [?, ?], Memory::HBM>,
  e_rows : Tensor<i32, [?], Memory::HBM>,
  e_ident : Tensor<i32, [?], Memory::HBM>,
  e_bases : Tensor<i32, [?], Memory::HBM>,
  slot : Tensor<i32, [?], Memory::HBM>,
  e_counts : Tensor<i32, [?], Memory::HBM>,
  e_lane_counts : Tensor<i32, [?], Memory::HBM>,
  e_gu : Tensor<f32, [?, ?], Memory::HBM>,
  e_h : Tensor<f32, [?, ?], Memory::HBM>,
  e_out : Tensor<f32, [?, ?], Memory::HBM>,
}

/// The positions of the experts of a chunk: one for each of its chunk * k choices, and up to 15 of
/// padding for each expert. A multiple of 16.
fn expert_positions(c : &Config, chunk : i32) -> i32 {
  let k = i32::max(c.experts_per_token, 1);
  let experts = i32::max(c.num_experts, 1);
  return (chunk * k + experts * 31 + 31) / 32 * 32;
}

/// The tensors for chunks of up to `chunk` tokens, at up to `max_seq` positions.
fn new_prefill(c : &Config, max_seq : i32, chunk : i32) -> Prefill {
  assert(chunk > 0 && chunk % 16 == 0, "new_prefill: the chunk must be a multiple of 16");
  let qkv_rows = (c.num_q_heads + 2 * c.num_kv_heads) * c.head_dim;
  let moe = c.num_experts > 0;
  let k = i32::max(c.experts_per_token, 1);
  let experts = i32::max(c.num_experts, 1);
  let positions = expert_positions(c, chunk);
  // The products of Q4_0 matrices take 32 rows at a time.
  let cap = (chunk + 31) / 32 * 32;
  let mut ident = Tensor<i32>([positions]);
  for p in 0..positions {
    ident[p] = p;
  }
  // A dense model uses no tensor of the experts, and a model of experts no dense MLP.
  let mut dense_rows = 1;
  let mut moe_rows = 1;
  if moe {
    moe_rows = positions;
  } else {
    dense_rows = cap;
  }
  let inter = i32::max(c.intermediate_size, 1);
  let moe_inter = i32::max(c.moe_intermediate_size, 1);
  return Prefill {
    chunk: chunk,
    tokens: transfer(Tensor<i32>([chunk]), Memory::HBM),
    rows: transfer(Tensor<i32>([cap]), Memory::HBM),
    zeros: transfer(Tensor<i32>([cap / 16]), Memory::HBM),
    no_bias: transfer(Tensor<bf16>([1]), Memory::HBM),
    x: transfer(Tensor<f32>([cap, c.hidden_size]), Memory::HBM),
    xn: transfer(Tensor<f32>([cap, c.hidden_size]), Memory::HBM),
    qkv: transfer(Tensor<f32>([cap, qkv_rows]), Memory::HBM),
    q: transfer(Tensor<f32>([chunk, c.num_q_heads, c.head_dim]), Memory::HBM),
    heads: transfer(Tensor<f32>([c.num_kv_heads * 1024, 128]), Memory::HBM),
    att: transfer(Tensor<f32>([chunk, c.num_q_heads * c.head_dim]), Memory::HBM),
    scores: transfer(Tensor<f32>([c.num_kv_heads * 1024, (max_seq + 127) / 128 * 128]), Memory::HBM),
    probs: transfer(Tensor<f32>([c.num_kv_heads * 1024, (max_seq + 127) / 128 * 128]), Memory::HBM),
    gu: transfer(Tensor<f32>([dense_rows, 2 * inter]), Memory::HBM),
    h: transfer(Tensor<f32>([dense_rows, inter]), Memory::HBM),
    router: transfer(Tensor<f32>([chunk, experts]), Memory::HBM),
    ids: transfer(Tensor<i32>([chunk, k]), Memory::HBM),
    wts: transfer(Tensor<f32>([chunk, k]), Memory::HBM),
    e_rows: transfer(Tensor<i32>([positions]), Memory::HBM),
    e_ident: transfer(ident, Memory::HBM),
    e_bases: transfer(Tensor<i32>([positions / 16]), Memory::HBM),
    slot: transfer(Tensor<i32>([chunk * k]), Memory::HBM),
    e_counts: transfer(Tensor<i32>([experts]), Memory::HBM),
    e_lane_counts: transfer(Tensor<i32>([experts * 32]), Memory::HBM),
    e_gu: transfer(Tensor<f32>([moe_rows, 2 * moe_inter]), Memory::HBM),
    e_h: transfer(Tensor<f32>([moe_rows, moe_inter]), Memory::HBM),
    e_out: transfer(Tensor<f32>([moe_rows, c.hidden_size]), Memory::HBM),
  };
}

// ----------------------------------------------------------------------------- products ---
//
// y[16b + t][r] = (row bases[b] * stride + r of w) . x[list[16b + t]], for r below `rows`, and
// each tile b below `tiles`. With `use_bias`, b[r] is added. With `add`, y gets the product added
// instead. `cols` must be a multiple of 32.

/// The product of a bf16 matrix.
fn pf_mm_bf16(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<bf16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  assert(cols % 32 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_bf16: cols must be a multiple of 32, and list and bases need the tiles");
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sa = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe {
          Tensor<f32, [1, 32, 16], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 32, 16], Memory::SMEM>::uninit()
        };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            for t in 0..16 {
              acc[sg][l][t] = 0.0;
            }
          }
        }
        // A tile after those of the last expert has the base -1, and only gets zeros.
        let live = (bases[tb] + 1048576) / 1048576;
        for g in 0..groups * live {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let at = (bases[tb] * stride + r) * cols + g * 32;
                for k in 0..32 {
                  sa[sg][l][k] = w[at + k] as f32;
                }
              } else {
                for k in 0..32 {
                  sa[sg][l][k] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sb[0][l][sg * 4 + q] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sa[sg] @ sb[0];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][l][t];
                } else {
                  y[tb * 16 + t][r] = acc[sg][l][t] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The product of an fp8 matrix, in the format of `nn_matvec_fp8`: each code decodes through a
/// table of 256 values in shared memory, times the scale of its block of 128 x 128.
fn pf_mm_fp8(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f32, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, bias : &Tensor<bf16, [?], Memory::HBM>, use_bias : bool, add : bool, rows : i32, cols : i32, tiles : i32) -> void {
  assert(cols % 128 == 0 && tiles > 0 && list.len() >= tiles * 16 && bases.len() >= tiles, "pf_mm_fp8: cols must be a multiple of 128, and list and bases need the tiles");
  let groups = cols / 32;
  let words = cols / 4;
  let blocks_per_row = cols / 128;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 127) / 128 across blocks {
      for tb in 0..tiles across blocks {
        let mut sa = unsafe {
          Tensor<f32, [4, 32, 32], Memory::SMEM>::uninit()
        };
        let mut sb = unsafe {
          Tensor<f32, [1, 32, 16], Memory::SMEM>::uninit()
        };
        let mut acc = unsafe {
          Tensor<f32, [4, 32, 16], Memory::SMEM>::uninit()
        };
        let mut lut = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            // As in `nn_matvec_fp8`: e = 0 gives m * 2^-9, else the bits with 120 added to the
            // exponent are the value in f32.
            let mag = (sg * 32 + l) as u32;
            let mut value = f32::from_bits((mag << 20u32) + 1006632960u32);
            if mag < 8u32 {
              value = (mag as f32) * 0.001953125;
            }
            lut[sg * 32 + l] = value;
            lut[sg * 32 + l + 128] = 0.0 - value;
            for t in 0..16 {
              acc[sg][l][t] = 0.0;
            }
          }
        }
        // A tile after those of the last expert has the base -1, and only gets zeros.
        let live = (bases[tb] + 1048576) / 1048576;
        for g in 0..groups * live {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 128 + sg * 32 + l;
              if r < rows {
                let row = bases[tb] * stride + r;
                let at = row * words + g * 8;
                let scale = scales[(row / 128) * blocks_per_row + g / 4];
                for i in 0..8 {
                  let word = w[at + i];
                  sa[sg][l][i * 4] = lut[(word & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 1] = lut[((word >> 8u32) & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 2] = lut[((word >> 16u32) & 255u32) as i32] * scale;
                  sa[sg][l][i * 4 + 3] = lut[(word >> 24u32) as i32] * scale;
                }
              } else {
                for k in 0..32 {
                  sa[sg][l][k] = 0.0;
                }
              }
              for q in 0..4 {
                let from = list[tb * 16 + sg * 4 + q];
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + l];
                }
                sb[0][l][sg * 4 + q] = v;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + sa[sg] @ sb[0];
          }
        }
        for sg in 0..4 across subgroups {
          for l in 0..32 across lanes(32) {
            let r = rb * 128 + sg * 32 + l;
            if r < rows {
              let mut b : f32 = 0.0;
              if use_bias {
                b = bias[r] as f32;
              }
              for t in 0..16 {
                if add {
                  y[tb * 16 + t][r] = y[tb * 16 + t][r] + acc[sg][l][t];
                } else {
                  y[tb * 16 + t][r] = acc[sg][l][t] + b;
                }
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// y = the product of a Q4_0 matrix, as `pf_mm_q4` with no bias and no `add`. The tile of the
/// weights is f16, half the shared memory of an f32 tile. `lanes::fill` starts the sums and
/// `lanes::copy` writes them to `y`, and nothing else reads them, so on the Apple GPU they stay in
/// the simdgroup matrices of the subgroups, with no tile in shared memory. A weight is (code - 8)
/// times its scale, rounded to f16. The inputs stay f32: with f16 inputs, the logits of the tiny
/// model of experts moved 20 times as much, for 2% less time.
fn pf_mm_q4_set(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, rows : i32, cols : i32, tiles : i32) -> void {
  // A block takes 32 tokens: two tiles of 16, which must have the same base.
  let pairs = (tiles + 1) / 2;
  assert(cols % 32 == 0 && tiles > 0 && list.len() >= pairs * 32 && bases.len() >= 2 * pairs - 1, "pf_mm_q4_set: cols must be a multiple of 32, and list and bases need the tiles of 32 tokens");
  let words = cols / 8;
  let groups = cols / 32;
  spawn on(Topology::Device) {
    for rb in 0..(rows + 63) / 64 across blocks {
      for tb in 0..pairs across blocks {
        // sw[sg]: columns (sg % 2) * 16 to + 15 of rows (sg / 2) * 32 to + 31 of the block, as
        // [column][row]. sx[sg]: tokens (sg / 2) * 16 to + 15 of the block, columns (sg % 2) * 16 to
        // + 15. Subgroup sg makes tokens (sg / 2) * 16 to + 15 and rows (sg % 2) * 32 to + 31.
        let mut sw = unsafe { Tensor<f16, [4, 16, 32], Memory::SMEM>::uninit() };
        let mut sx = unsafe { Tensor<f16, [4, 16, 16], Memory::SMEM>::uninit() };
        let mut acc = unsafe { Tensor<f32, [4, 16, 32], Memory::SMEM>::uninit() };
        for sg in 0..4 across subgroups {
          lanes::fill(&mut acc[sg], 0.0);
        }
        // A tile after those of the last expert has the base -1, and only gets zeros.
        let base = bases[tb * 2];
        let live = (base + 1048576) / 1048576;
        for g in 0..groups * live {
          for sg in 0..4 across subgroups {
            for l in 0..32 across lanes(32) {
              let r = rb * 64 + (sg / 2) * 32 + l;
              if r < rows {
                let row = base * stride + r;
                let at = row * words + g * 4 + (sg % 2) * 2;
                let sc = scales[row * groups + g] as f32;
                let m = -8.0 * sc;
                for i in 0..2 {
                  let word = w[at + i];
                  sw[sg][i * 8][l] = (((word & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 1][l] = ((((word >> 4u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 2][l] = ((((word >> 8u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 3][l] = ((((word >> 12u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 4][l] = ((((word >> 16u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 5][l] = ((((word >> 20u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 6][l] = ((((word >> 24u32) & 15u32) as f32) * sc + m) as f16;
                  sw[sg][i * 8 + 7][l] = ((((word >> 28u32) & 15u32) as f32) * sc + m) as f16;
                }
              } else {
                for k in 0..16 {
                  sw[sg][k][l] = 0.0 as f16;
                }
              }
              // Lane l copies 8 columns of token l / 2 of the tile of subgroup sg.
              let from = list[tb * 32 + (sg / 2) * 16 + l / 2];
              for j in 0..8 {
                let mut v : f32 = 0.0;
                if from >= 0 {
                  v = x[from][g * 32 + (sg % 2) * 16 + (l % 2) * 8 + j];
                }
                sx[sg][l / 2][(l % 2) * 8 + j] = v as f16;
              }
            }
          }
          for sg in 0..4 across subgroups {
            acc[sg] = acc[sg] + (sx[(sg / 2) * 2] as f32) @ (sw[(sg % 2) * 2] as f32);
            acc[sg] = acc[sg] + (sx[(sg / 2) * 2 + 1] as f32) @ (sw[(sg % 2) * 2 + 1] as f32);
          }
        }
        for sg in 0..4 across subgroups {
          lanes::copy(y, &acc[sg], [tb * 32 + (sg / 2) * 16, rb * 64 + (sg % 2) * 32]);
        }
      }
    }
  }
  return;
}

/// pf_mm_q4_set as one threadgroup `mlir!` block, after llama.cpp's kernel_mul_mm_id: blocks of 64
/// rows x 32 tokens, one [32 columns][64 rows] tile of weights and one [32 tokens][32 columns] tile
/// of inputs in shared memory, two lanes for each row of weights and four for each token. Each step
/// loads and decodes into registers before the barrier, the sums stay in simdgroup matrices through
/// the loop over K, the loads are vector loads, and the multiplies of a step are unrolled, with
/// `vx.subgroup_schedule_barrier` between the loads and the multiplies, as llama.cpp's
/// `simdgroup_barrier(mem_flags::mem_none)`. Rows must be a multiple of 64. A tile with the base -1
/// skips the loop over K and gets zeros.
///
/// The design is that of llama.cpp (ggml/src/ggml-metal/kernels/mul_mm.metal), MIT License,
/// Copyright (c) 2023-2026 The ggml authors.
///
/// scripts/mlir_kernels/expert_product.py writes this function: change that script, not the MLIR.
fn pf_mm_q4_mlir(y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<u32, [?], Memory::HBM>, scales : &Tensor<f16, [?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, bases : &Tensor<i32, [?], Memory::HBM>, stride : i32, rows : i32, cols : i32, tiles : i32) -> void {
  spawn on(Topology::Device) {
    for rb in 0..rows / 64 across blocks {
      for tb in 0..(tiles + 1) / 2 across blocks {
        let mut sw = unsafe { Tensor<f16, [2048], Memory::SMEM>::uninit() };
        let mut sx = unsafe { Tensor<f16, [1024], Memory::SMEM>::uninit() };
        let _d = mlir!( threads : 128, inputs : (%sw = &mut sw : memref<2048xf16, 3>, %sx = &mut sx : memref<1024xf16, 3>, %y = y : memref<?x?xf32>, %w = w : memref<?xi32>, %sc = scales : memref<?xf16>, %x = x : memref<?x?xf32>, %list = list : memref<?xi32>, %bases = bases : memref<?xi32>, %stride = stride : i32, %cols = cols : i32, %rb = rb : i32, %tb = tb : i32), returns : i32, dialects : ["arith", "memref", "scf", "gpu", "vector", "vx"], ensures : [writes_only(sw), writes_only(sx), reads_only(w), reads_only(scales), reads_only(x), reads_only(list), reads_only(bases), writes_only(y[tb * 32..tb * 32 + 32][rb * 64..rb * 64 + 64])]) {
          %k0 = arith.constant 0 : index
          %k1 = arith.constant 1 : index
          %k2 = arith.constant 2 : index
          %k4 = arith.constant 4 : index
          %k8 = arith.constant 8 : index
          %k16 = arith.constant 16 : index
          %k24 = arith.constant 24 : index
          %k32 = arith.constant 32 : index
          %k64 = arith.constant 64 : index
          %k128 = arith.constant 128 : index
          %k192 = arith.constant 192 : index
          %k256 = arith.constant 256 : index
          %k264 = arith.constant 264 : index
          %k272 = arith.constant 272 : index
          %k280 = arith.constant 280 : index
          %k320 = arith.constant 320 : index
          %k384 = arith.constant 384 : index
          %k448 = arith.constant 448 : index
          %k512 = arith.constant 512 : index
          %k520 = arith.constant 520 : index
          %k528 = arith.constant 528 : index
          %k536 = arith.constant 536 : index
          %k576 = arith.constant 576 : index
          %k640 = arith.constant 640 : index
          %k704 = arith.constant 704 : index
          %k768 = arith.constant 768 : index
          %k832 = arith.constant 832 : index
          %k896 = arith.constant 896 : index
          %k960 = arith.constant 960 : index
          %k1024 = arith.constant 1024 : index
          %k1032 = arith.constant 1032 : index
          %k1040 = arith.constant 1040 : index
          %k1048 = arith.constant 1048 : index
          %k1536 = arith.constant 1536 : index
          %k1544 = arith.constant 1544 : index
          %k1552 = arith.constant 1552 : index
          %k1560 = arith.constant 1560 : index
