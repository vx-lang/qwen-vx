//===----------------------------------------------------------------------===//
// The byte-level BPE tokenizer of the Qwen2 and Qwen3 models. It reads the tokenizer file that
// `scripts/convert_tokenizer.py` writes, and that script describes the file and the steps of
// `encode`. The tables stay in the mapped file, and every lookup is a binary search in them.
import core::convert;
import core::ptr;
import std::libc;
import std::mmap;
import std::vec;

extern {
  fn strlen(s : *const i8) -> i64;
  fn write(fd : i32, buf : *const i8, n : i64) -> i64;
}

/// The bytes "VXQTOK01" at the start of the file, read as one little-endian i64.
const TOKENIZER_MAGIC : i64 = 3544415710829697110;
const TOKENIZER_VERSION : i64 = 1;
/// The first Hangul syllable, and the numbers of the Unicode algorithm for Hangul.
const HANGUL_S : i32 = 44032;
const HANGUL_L : i32 = 4352;
const HANGUL_V : i32 = 4449;
const HANGUL_T : i32 = 4519;
const HANGUL_COUNT : i32 = 11172;
const HANGUL_V_COUNT : i32 = 21;
const HANGUL_T_COUNT : i32 = 28;
const HANGUL_N_COUNT : i32 = 588;

/// A tokenizer file mapped into memory. Each pointer is a table of the file.
struct Tokenizer {
  base : *mut i8,
  size : i64,
  n_tokens : i32,
  n_merges : i32,
  n_added : i32,
  n_letters : i32,
  n_numbers : i32,
  n_spaces : i32,
  n_decomposed : i32,
  n_combining : i32,
  n_compositions : i32,
  byte_tokens : *mut i32,
  token_starts : *mut i32,
  token_bytes : *mut i8,
  merge_pairs : *mut i64,
  merge_ranks : *mut i32,
  merge_tokens : *mut i32,
  added_tokens : *mut i32,
  added_special : *mut i32,
  letters : *mut i32,
  numbers : *mut i32,
  spaces : *mut i32,
  decomposed : *mut i32,
  decomposition_starts : *mut i32,
  decompositions : *mut i32,
  combining : *mut i32,
  combining_class : *mut i32,
  composition_pairs : *mut i64,
  compositions : *mut i32,
}

/// Whether `p` is MAP_FAILED, the address -1 that mmap gives when it fails.
fn tokenizer_map_failed(p : *mut i8) -> bool {
  let failed : *mut i8 = offset_mut(unsafe { 0 as *mut i8 }, -1);
  return eq(p as *const i8, failed as *const i8);
}

/// The i64 word at `index` of the header.
fn header_word(base : *mut i8, index : i64) -> i64 {
  let words : *mut i64 = base;
  return unsafe { words[index] };
}

/// The table whose offset is in header word `index`, as a pointer into the file.
fn table(base : *mut i8, size : i64, index : i64) -> *mut i8 {
  let at = header_word(base, index);
  assert(at >= 256 && at <= size && at % 8 == 0, "a table of the tokenizer file is outside the file");
  return offset_mut(base, at);
}

/// Maps the tokenizer file at `path` into memory.
fn load_tokenizer(path : *const i8) -> Tokenizer {
  let fd : i32 = unsafe { open(path, 0) };
  assert(fd >= 0, "cannot open the tokenizer file");
  let size : i64 = unsafe { lseek(fd, 0, 2) };
  assert(size >= 256, "the tokenizer file is too short");
  let base : *mut i8 = unsafe { mmap(0 as *mut i8, size, 1, 1, fd, 0) };
  assert(!tokenizer_map_failed(base), "cannot map the tokenizer file into memory");
  unsafe { close(fd); }
  assert(header_word(base, 0) == TOKENIZER_MAGIC, "this is not a tokenizer file of the Qwen app");
  assert(header_word(base, 1) == TOKENIZER_VERSION, "the tokenizer file has another format version");
  return Tokenizer {
    base: base,
    size: size,
    n_tokens: header_word(base, 2) as i32,
    n_merges: header_word(base, 3) as i32,
    n_added: header_word(base, 4) as i32,
    n_letters: header_word(base, 5) as i32,
    n_numbers: header_word(base, 6) as i32,
    n_spaces: header_word(base, 7) as i32,
    n_decomposed: header_word(base, 8) as i32,
    n_combining: header_word(base, 10) as i32,
    n_compositions: header_word(base, 11) as i32,
    byte_tokens: table(base, size, 13),
    token_starts: table(base, size, 14),
    token_bytes: table(base, size, 15),
    merge_pairs: table(base, size, 16),
    merge_ranks: table(base, size, 17),
    merge_tokens: table(base, size, 18),
    added_tokens: table(base, size, 19),
    added_special: table(base, size, 20),
    letters: table(base, size, 21),
    numbers: table(base, size, 22),
    spaces: table(base, size, 23),
    decomposed: table(base, size, 24),
    decomposition_starts: table(base, size, 25),
    decompositions: table(base, size, 26),
    combining: table(base, size, 27),
    combining_class: table(base, size, 28),
    composition_pairs: table(base, size, 29),
    compositions: table(base, size, 30),
  };
}

/// A tokenizer with no tokens, for a program that does not load one.
fn no_tokenizer() -> Tokenizer {
  let none : *mut i8 = unsafe { 0 as *mut i8 };
  return Tokenizer {
    base: none, size: 0, n_tokens: 0, n_merges: 0, n_added: 0, n_letters: 0, n_numbers: 0,
    n_spaces: 0, n_decomposed: 0, n_combining: 0, n_compositions: 0,
    byte_tokens: none, token_starts: none, token_bytes: none, merge_pairs: none,
    merge_ranks: none, merge_tokens: none, added_tokens: none, added_special: none,
    letters: none, numbers: none, spaces: none, decomposed: none, decomposition_starts: none,
    decompositions: none, combining: none, combining_class: none, composition_pairs: none,
    compositions: none,
  };
}

// ----------------------------------------------------------- lookups ---

/// Whether `c` is in one of the `count` sorted ranges [first, last] of `ranges`.
fn in_ranges(ranges : *mut i32, count : i32, c : i32) -> bool {
  let mut lo = 0;
  let mut hi = count - 1;
  while lo <= hi {
    let mid = (lo + hi) / 2;
    let first = unsafe { ranges[2 * mid] };
    let last = unsafe { ranges[2 * mid + 1] };
    if c < first {
      hi = mid - 1;
    } else if c > last {
      lo = mid + 1;
    } else {
      return true;
    }
  }
  return false;
}

/// The index of `key` in the `count` sorted values of `keys`, or -1.
fn find_i32(keys : *mut i32, count : i32, key : i32) -> i32 {
  let mut lo = 0;
  let mut hi = count - 1;
  while lo <= hi {
    let mid = (lo + hi) / 2;
    let k = unsafe { keys[mid] };
    if key < k {
      hi = mid - 1;
    } else if key > k {
      lo = mid + 1;
    } else {
      return mid;
    }
  }
  return -1;
}

/// `find_i32` for keys of i64.
fn find_i64(keys : *mut i64, count : i32, key : i64) -> i32 {
  let mut lo = 0;
  let mut hi = count - 1;
  while lo <= hi {
    let mid = (lo + hi) / 2;
    let k = unsafe { keys[mid] };
    if key < k {
      hi = mid - 1;
    } else if key > k {
      lo = mid + 1;
    } else {
      return mid;
    }
  }
  return -1;
}

/// Whether `c` is a letter, \p{L}.
fn is_letter(t : &Tokenizer, c : i32) -> bool {
  if c < 128 {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
  }
  return in_ranges(t.letters, t.n_letters, c);
}

/// Whether `c` is a number, \p{N}.
fn is_number(t : &Tokenizer, c : i32) -> bool {
  if c < 128 {
    return c >= 48 && c <= 57;
  }
  return in_ranges(t.numbers, t.n_numbers, c);
}

/// Whether `c` is white space, \s.
fn is_space(t : &Tokenizer, c : i32) -> bool {
  if c < 128 {
    return c == 32 || (c >= 9 && c <= 13);
  }
  return in_ranges(t.spaces, t.n_spaces, c);
}

/// Whether `c` is \r or \n.
fn is_newline(c : i32) -> bool {
  return c == 10 || c == 13;
}

/// Whether `c` is none of white space, a letter and a number, as [^\s\p{L}\p{N}].
fn is_other(t : &Tokenizer, c : i32) -> bool {
  return !is_space(t, c) && !is_letter(t, c) && !is_number(t, c);
}

/// The canonical combining class of `c`.
fn combining_class(t : &Tokenizer, c : i32) -> i32 {
  if c < 768 {
    return 0;
  }
  let i = find_i32(t.combining, t.n_combining, c);
  if i < 0 {
    return 0;
  }
  return unsafe { t.combining_class[i] };
}

/// The code point that `first` and `second` compose to, or -1.
fn compose(t : &Tokenizer, first : i32, second : i32) -> i32 {
  if first >= HANGUL_L && first < HANGUL_L + 19 && second >= HANGUL_V && second < HANGUL_V + HANGUL_V_COUNT {
    return HANGUL_S + ((first - HANGUL_L) * HANGUL_V_COUNT + (second - HANGUL_V)) * HANGUL_T_COUNT;
  }
  if first >= HANGUL_S && first < HANGUL_S + HANGUL_COUNT && (first - HANGUL_S) % HANGUL_T_COUNT == 0 && second > HANGUL_T && second < HANGUL_T + HANGUL_T_COUNT {
    return first + (second - HANGUL_T);
  }
  let key = ((first as i64) << 21) | (second as i64);
  let i = find_i64(t.composition_pairs, t.n_compositions, key);
  if i < 0 {
    return -1;
  }
  return unsafe { t.compositions[i] };
}

// --------------------------------------------------------------- NFC ---

/// The code points of the UTF-8 bytes text[start..end]. Asserts that the bytes are UTF-8.
fn decode_utf8(text : *const i8, start : i64, end : i64) -> Vec<i32> {
  let mut out = Vec<i32>::new();
  let mut i = start;
  while i < end {
    let b0 : i32 = i32::from(unsafe { text[i] });
    let b = b0 & 255;
    let mut n : i64 = 1;
    let mut c = b;
    if b >= 240 {
      n = 4;
      c = b & 7;
    } else if b >= 224 {
      n = 3;
      c = b & 15;
    } else if b >= 192 {
      n = 2;
      c = b & 31;
    } else {
      assert(b < 128, "the text is not UTF-8");
    }
    assert(i + n <= end, "the text ends inside a UTF-8 character");
    let mut k : i64 = 1;
    while k < n {
      let raw : i32 = i32::from(unsafe { text[i + k] });
      let next = raw & 255;
      assert(next >= 128 && next < 192, "the text is not UTF-8");
      c = c * 64 + (next & 63);
      k = k + 1;
    }
    out.push(c);
    i = i + n;
  }
  return out;
}

/// Appends the UTF-8 bytes of the code point `c` to `out`.
fn push_utf8(out : &mut Vec<i32>, c : i32) -> void {
  if c < 128 {
    out.push(c);
  } else if c < 2048 {
    out.push(192 + c / 64);
    out.push(128 + c % 64);
  } else if c < 65536 {
    out.push(224 + c / 4096);
    out.push(128 + (c / 64) % 64);
    out.push(128 + c % 64);
  } else {
    out.push(240 + c / 262144);
    out.push(128 + (c / 4096) % 64);
    out.push(128 + (c / 64) % 64);
    out.push(128 + c % 64);
  }
  return;
}

/// Appends the full canonical decomposition of `c` to `out`.
fn push_decomposition(t : &Tokenizer, out : &mut Vec<i32>, c : i32) -> void {
  if c >= HANGUL_S && c < HANGUL_S + HANGUL_COUNT {
    let s = c - HANGUL_S;
    out.push(HANGUL_L + s / HANGUL_N_COUNT);
    out.push(HANGUL_V + (s % HANGUL_N_COUNT) / HANGUL_T_COUNT);
    if s % HANGUL_T_COUNT != 0 {
      out.push(HANGUL_T + s % HANGUL_T_COUNT);
    }
    return;
  }
  let i = if c < 192 {
    -1
  } else {
    find_i32(t.decomposed, t.n_decomposed, c)
  };
  if i < 0 {
    out.push(c);
    return;
  }
  let first = unsafe { t.decomposition_starts[i] };
  let last = unsafe { t.decomposition_starts[i + 1] };
  for k in first..last {
    out.push(unsafe { t.decompositions[k] });
  }
  return;
}

/// The NFC form of the code points `cps`: their canonical decomposition, the combining marks in
/// canonical order, and then the canonical composition, as in Unicode Standard Annex 15.
fn nfc(t : &Tokenizer, cps : &Vec<i32>) -> Vec<i32> {
  let mut d = Vec<i32>::new();
  for i in 0..cps.len() {
    push_decomposition(t, &mut d, cps.get(i));
  }
  // Canonical order: a stable sort of each run of marks by their combining class.
  let n = d.len();
  for i in 1..n {
    let mut j = i;
    while j > 0 && combining_class(t, d.get(j)) != 0 && combining_class(t, d.get(j - 1)) > combining_class(t, d.get(j)) {
      let a = d.get(j - 1);
      d.set(j - 1, d.get(j));
      d.set(j, a);
      j = j - 1;
    }
  }
  let mut out = Vec<i32>::new();
  if n == 0 {
    return out;
  }
  let mut starter = d.get(0);
  let mut starter_at = 0;
  let mut last_class = combining_class(t, starter);
  if last_class != 0 {
    // A first mark composes with nothing before it.
    last_class = 256;
  }
  out.push(starter);
  for i in 1..n {
    let c = d.get(i);
    let class = combining_class(t, c);
    let composite = compose(t, starter, c);
    if composite >= 0 && (last_class < class || last_class == 0) {
      out.set(starter_at, composite);
      starter = composite;
    } else {
      if class == 0 {
        starter_at = out.len();
        starter = c;
      }
      last_class = class;
      out.push(c);
    }
  }
  return out;
}

// ------------------------------------------------------- pre-tokenizer ---

/// The lowercase of an ASCII letter, and of the long s (U+017F), which case-folds to s.
fn fold(c : i32) -> i32 {
  if c >= 65 && c <= 90 {
    return c + 32;
  }
  if c == 383 {
    return 115;
  }
  return c;
}

/// The end of the piece that starts at `i` of the `n` code points `c`. It is the match of the
/// first alternative of the regex that matches at `i`:
///   1. (?i:'s|'t|'re|'ve|'m|'ll|'d)
///   2. [^\r\n\p{L}\p{N}]?\p{L}+
///   3. \p{N}
///   4.  ?[^\s\p{L}\p{N}]+[\r\n]*
///   5. \s*[\r\n]+
///   6. \s+(?!\S)
///   7. \s+
fn piece_end(t : &Tokenizer, c : &Vec<i32>, i : i32, n : i32) -> i32 {
  let first = c.get(i);
  // 1. A contraction.
  if first == 39 && i + 1 < n {
    let a = fold(c.get(i + 1));
    if a == 115 || a == 116 || a == 109 || a == 100 {
      return i + 2;
    }
    if i + 2 < n {
      let b = fold(c.get(i + 2));
      if (a == 114 && b == 101) || (a == 118 && b == 101) || (a == 108 && b == 108) {
        return i + 3;
      }
    }
  }
  // 2. Letters, maybe after one character that is not \r, \n, a letter or a number.
  let mut letters_from = -1;
  if is_letter(t, first) {
    letters_from = i;
  } else if !is_newline(first) && !is_number(t, first) && i + 1 < n && is_letter(t, c.get(i + 1)) {
    letters_from = i + 1;
  }
  if letters_from >= 0 {
    let mut j = letters_from;
    while j < n && is_letter(t, c.get(j)) {
      j = j + 1;
    }
    return j;
  }
  // 3. One number.
  if is_number(t, first) {
    return i + 1;
  }
  // 4. Other characters, maybe after a space, and then any \r and \n.
  let mut other_from = -1;
  if is_other(t, first) {
    other_from = i;
  } else if first == 32 && i + 1 < n && is_other(t, c.get(i + 1)) {
    other_from = i + 1;
  }
  if other_from >= 0 {
    let mut j = other_from;
    while j < n && is_other(t, c.get(j)) {
      j = j + 1;
    }
    while j < n && is_newline(c.get(j)) {
      j = j + 1;
    }
    return j;
  }
  // The character is white space. `run` is the end of its run of white space.
  let mut run = i;
  let mut last_newline = -1;
  while run < n && is_space(t, c.get(run)) {
    if is_newline(c.get(run)) {
      last_newline = run;
    }
    run = run + 1;
  }
  // 5. White space up to its last \r or \n.
  if last_newline >= 0 {
    return last_newline + 1;
  }
  // 6. White space that the end of the text or more white space follows.
  if run == n {
    return run;
  }
  if run - i >= 2 {
    return run - 1;
  }
  // 7. One character of white space before the next piece.
  return run;
}

// --------------------------------------------------------------- BPE ---

/// The index of the merge of the pair `left`, `right` in the merge tables, or -1.
fn find_merge(t : &Tokenizer, left : i32, right : i32) -> i32 {
  let key = ((left as i64) << 20) | (right as i64);
  return find_i64(t.merge_pairs, t.n_merges, key);
}

/// The rank of merge `m`, or a rank above all ranks when `m` is -1.
fn rank_of(t : &Tokenizer, m : i32) -> i32 {
  if m < 0 {
    return 2147483647;
  }
  return unsafe { t.merge_ranks[m] };
}

/// Appends the tokens of one piece, whose UTF-8 bytes are `bytes`, to `out`.
fn bpe(t : &Tokenizer, bytes : &Vec<i32>, out : &mut Vec<i32>) -> void {
  let mut syms = Vec<i32>::new();
  for i in 0..bytes.len() {
    syms.push(unsafe { t.byte_tokens[bytes.get(i)] });
  }
  // merges[p] is the merge of syms[p] and syms[p + 1], or -1.
  let mut merges = Vec<i32>::new();
  for p in 0..syms.len() - 1 {
    merges.push(find_merge(t, syms.get(p), syms.get(p + 1)));
  }
  let mut n = syms.len();
  while n > 1 {
    let mut best = -1;
    let mut best_rank = 2147483647;
    for p in 0..n - 1 {
      let r = rank_of(t, merges.get(p));
      if r < best_rank {
        best_rank = r;
        best = p;
      }
    }
    if best < 0 {
      break;
    }
    syms.set(best, unsafe { t.merge_tokens[merges.get(best)] });
    for p in best + 1..n - 1 {
      syms.set(p, syms.get(p + 1));
    }
    for p in best + 1..n - 2 {
      merges.set(p, merges.get(p + 1));
    }
    n = n - 1;
    if best + 1 < n {
      merges.set(best, find_merge(t, syms.get(best), syms.get(best + 1)));
    }
    if best > 0 {
      merges.set(best - 1, find_merge(t, syms.get(best - 1), syms.get(best)));
    }
  }
  for i in 0..n {
    out.push(syms.get(i));
  }
  return;
}

// ------------------------------------------------------------ encode ---

/// Appends the tokens of text[start..end], which has no added token, to `out`.
fn encode_ordinary(t : &Tokenizer, text : *const i8, start : i64, end : i64, out : &mut Vec<i32>) -> void {
  if start >= end {
    return;
  }
  let decoded = decode_utf8(text, start, end);
  // No code point below U+0300 changes under NFC or composes with one before it.
  let mut low = true;
  for i in 0..decoded.len() {
    if decoded.get(i) >= 768 {
      low = false;
    }
  }
  let cps = if low {
    decoded
  } else {
    nfc(t, &decoded)
  };
  let n = cps.len();
  let mut i = 0;
  while i < n {
    let end_of_piece = piece_end(t, &cps, i, n);
    assert(end_of_piece > i, "the pre-tokenizer made an empty piece");
    let mut bytes = Vec<i32>::new();
    for k in i..end_of_piece {
      push_utf8(&mut bytes, cps.get(k));
    }
    bpe(t, &bytes, out);
    i = end_of_piece;
  }
  return;
}

/// The number of bytes of token `id`.
fn token_length(t : &Tokenizer, id : i32) -> i64 {
  let first = unsafe { t.token_starts[id] };
  let last = unsafe { t.token_starts[id + 1] };
  return (last - first) as i64;
}

/// The added token whose bytes start at text[at], the longest if several do, or -1.
fn added_at(t : &Tokenizer, text : *const i8, at : i64, length : i64) -> i32 {
  let mut best = -1;
  let mut best_length : i64 = 0;
  for k in 0..t.n_added {
    let id = unsafe { t.added_tokens[k] };
    let first = unsafe { t.token_starts[id] } as i64;
    let size = token_length(t, id);
    if size > best_length && at + size <= length {
      let mut same = true;
      let mut j : i64 = 0;
      while same && j < size {
        same = unsafe { text[at + j] } == unsafe { t.token_bytes[first + j] };
        j = j + 1;
      }
      if same {
        best = id;
        best_length = size;
      }
    }
  }
  return best;
}

/// The token ids of the `length` bytes of UTF-8 text at `text`.
fn encode(t : &Tokenizer, text : *const i8, length : i64) -> Vec<i32> {
  let mut out = Vec<i32>::new();
  let mut segment : i64 = 0;
  let mut i : i64 = 0;
  while i < length {
    let id = added_at(t, text, i, length);
    if id >= 0 {
      encode_ordinary(t, text, segment, i, &mut out);
      out.push(id);
      i = i + token_length(t, id);
      segment = i;
    } else {
      i = i + 1;
    }
  }
  encode_ordinary(t, text, segment, length, &mut out);
  return out;
}

/// The token ids of the NUL-terminated UTF-8 text at `text`.
fn encode_c_str(t : &Tokenizer, text : *const i8) -> Vec<i32> {
  return encode(t, text, unsafe { strlen(text) });
}

// ------------------------------------------------------------ decode ---

/// Whether `id` is a special added token, such as <|im_end|>.
fn is_special(t : &Tokenizer, id : i32) -> bool {
  for k in 0..t.n_added {
    if unsafe { t.added_tokens[k] } == id {
      return unsafe { t.added_special[k] } != 0;
    }
  }
  return false;
}

/// The id of the added token whose text is `name`, such as "<|im_end|>", or -1.
fn added_token(t : &Tokenizer, name : *const i8) -> i32 {
  let length = unsafe { strlen(name) };
  let id = added_at(t, name, 0, length);
  if id >= 0 && token_length(t, id) == length {
    return id;
  }
  return -1;
}

/// Writes the bytes of token `id` to standard output. A token can hold part of a UTF-8
/// character, so the bytes of the next tokens complete it.
fn write_token(t : &Tokenizer, id : i32) -> void {
  assert(id >= 0 && id < t.n_tokens, "the token is not in the vocabulary");
  let first = unsafe { t.token_starts[id] } as i64;
  let size = token_length(t, id);
  if size > 0 {
    unsafe { write(1, offset_mut(t.token_bytes, first), size); }
  }
  return;
}

/// Writes the `length` bytes at `text` to standard output.
fn write_bytes(text : *const i8, length : i64) -> void {
  if length > 0 {
    unsafe { write(1, text, length); }
  }
  return;
}

// -------------------------------------------------------------- text ---

/// `length` bytes of text at `bytes`.
struct Text {
  bytes : *mut i8,
  length : i64,
}

/// The bytes of the file at `path`, mapped into memory. An empty file has no bytes.
fn read_text_file(path : *const i8) -> Text {
  let fd : i32 = unsafe { open(path, 0) };
  assert(fd >= 0, "cannot open the text file");
  let size : i64 = unsafe { lseek(fd, 0, 2) };
  assert(size >= 0, "cannot read the size of the text file");
  if size == 0 {
    unsafe { close(fd); }
    return Text {
      bytes: unsafe { 0 as *mut i8 }, length: 0
    };
  }
  let base : *mut i8 = unsafe { mmap(0 as *mut i8, size, 1, 1, fd, 0) };
  assert(!tokenizer_map_failed(base), "cannot map the text file into memory");
  unsafe { close(fd); }
  return Text {
    bytes: base, length: size
  };
}

/// The NUL-terminated text at `text`.
fn c_text(text : *const i8) -> Text {
  return Text {
    bytes: text as *mut i8, length: unsafe { strlen(text) }
  };
}

/// Copies `length` bytes from `from` to `to`.
fn copy_bytes(to : *mut i8, from : *const i8, length : i64) -> void {
  let mut i : i64 = 0;
  while i < length {
    unsafe { to[i] = from[i]; }
    i = i + 1;
  }
  return;
}

/// The request `text` in the chat format of the Qwen Instruct models, with no system message:
/// <|im_start|>user, a new line, the text, <|im_end|>, a new line, <|im_start|>assistant and a new
/// line. The tokens of the whole are not always the tokens of the parts, so this makes one text.
fn chat_text(text : &Text) -> Text {
  let before = c_text("<|im_start|>user
");
  let after = c_text("<|im_end|>
<|im_start|>assistant
");
  let length = before.length + text.length + after.length;
  let bytes : *mut i8 = unsafe { malloc((length + 1) as usize) };
  copy_bytes(bytes, before.bytes, before.length);
  copy_bytes(offset_mut(bytes, before.length), text.bytes, text.length);
  copy_bytes(offset_mut(bytes, before.length + text.length), after.bytes, after.length);
  return Text {
    bytes: bytes, length: length
  };
}
