//===----------------------------------------------------------------------===//
// The prompt of a Qwen3.5 or Qwen3.6 model (arch 1, #89) in chunks, as src/prefill.vx does for
// arch 0. A chunk reads each weight once for all its tokens: the products are those of
// src/prefill.vx (`pf_mm`), and the experts are sorted by expert in the same way. The parts that
// are new here:
//
// - The DeltaNet of a chunk. The convolution and the norms run for all the tokens at once. The
//   update of the state runs the tokens in order, in one kernel that keeps S in registers.
// - The gated attention of a chunk: a flash attention for heads of 256 values, as
//   `pf_flash_attention`, with the gate in its last step.
// - The shared expert, as a dense SwiGLU over the chunk, times sigmoid(its gate).
import core::convert;
import core::num;
import std::nn;
import std::vec;
import qwen::deltanet;
import qwen::model;
import qwen::prefill;
import qwen::qwen35;
import qwen::simd;
import qwen::weights;

/// The tensors of a chunk, made once. `rows`, `zeros` and the `e_` tensors are those of `Prefill`.
/// `proj` is the output of `qkv` or `linear_in` for each token, and `y` the input of `attn_out` or
/// `linear_out`. The `d` tensors are those of the DeltaNet, and the `s_` tensors those of the shared
/// expert. `router` has the logits of the experts, then that of the gate of the shared expert, and zeros to a whole number of blocks of 64.
struct Prefill35 {
  chunk : i32,
  tokens : Tensor<i32, [?], Memory::HBM>,
  rows : Tensor<i32, [?], Memory::HBM>,
  zeros : Tensor<i32, [?], Memory::HBM>,
  no_bias : Tensor<bf16, [?], Memory::HBM>,
  x : Tensor<f32, [?, ?], Memory::HBM>,
  xn : Tensor<f32, [?, ?], Memory::HBM>,
  proj : Tensor<f32, [?, ?], Memory::HBM>,
  y : Tensor<f32, [?, ?], Memory::HBM>,
  q : Tensor<f32, [?, ?, ?], Memory::HBM>,
  dq : Tensor<f32, [?, ?, ?], Memory::HBM>,
  dk : Tensor<f32, [?, ?, ?], Memory::HBM>,
  dv : Tensor<f32, [?, ?, ?], Memory::HBM>,
  beta : Tensor<f32, [?, ?], Memory::HBM>,
  decay : Tensor<f32, [?, ?], Memory::HBM>,
  o : Tensor<f32, [?, ?, ?, ?], Memory::HBM>,
  router : Tensor<f32, [?, ?], Memory::HBM>,
  ids : Tensor<i32, [?, ?], Memory::HBM>,
  wts : Tensor<f32, [?, ?], Memory::HBM>,
  e_rows : Tensor<i32, [?], Memory::HBM>,
  e_ident : Tensor<i32, [?], Memory::HBM>,
  e_bases : Tensor<i32, [?], Memory::HBM>,
  slot : Tensor<i32, [?], Memory::HBM>,
  e_counts : Tensor<i32, [?], Memory::HBM>,
  e_lane_counts : Tensor<i32, [?], Memory::HBM>,
  e_gu : Tensor<f32, [?, ?], Memory::HBM>,
  e_h : Tensor<f32, [?, ?], Memory::HBM>,
  e_out : Tensor<f32, [?, ?], Memory::HBM>,
  s_gu : Tensor<f32, [?, ?], Memory::HBM>,
  s_h : Tensor<f32, [?, ?], Memory::HBM>,
  s_out : Tensor<f32, [?, ?], Memory::HBM>,
}

/// The tensors for chunks of up to `chunk` tokens.
pub fn new_prefill35(c : &Config, chunk : i32) -> Prefill35 {
  assert(chunk > 0 && chunk % 16 == 0, "new_prefill35: the chunk must be a multiple of 16");
  let k = c.experts_per_token;
  let experts = c.num_experts;
  let positions = expert_positions(c, chunk);
  let cap = (chunk + 63) / 64 * 64;
  let mut ident = Tensor<i32>([positions]);
  for p in 0..positions {
    ident[p] = p;
  }
  let qkv_rows = (2 * c.num_q_heads + 2 * c.num_kv_heads) * 256;
  let in_rows = (2 * c.linear_k_heads + 2 * c.linear_v_heads) * 128 + 2 * c.linear_v_heads;
  let kh = c.linear_k_heads;
  let vh = c.linear_v_heads;
  return Prefill35 {
    chunk: chunk,
    tokens: transfer(Tensor<i32>([chunk]), Memory::HBM),
    rows: transfer(Tensor<i32>([cap]), Memory::HBM),
    zeros: transfer(Tensor<i32>([cap / 16]), Memory::HBM),
    no_bias: transfer(Tensor<bf16>([1]), Memory::HBM),
    x: transfer(Tensor<f32>([cap, c.hidden_size]), Memory::HBM),
    xn: transfer(Tensor<f32>([cap, c.hidden_size]), Memory::HBM),
    proj: transfer(Tensor<f32>([cap, i32::max(qkv_rows, in_rows)]), Memory::HBM),
    y: transfer(Tensor<f32>([cap, i32::max(c.num_q_heads * 256, vh * 128)]), Memory::HBM),
    q: transfer(Tensor<f32>([chunk, c.num_q_heads, 256]), Memory::HBM),
    dq: transfer(Tensor<f32>([chunk, kh, 128]), Memory::HBM),
    dk: transfer(Tensor<f32>([chunk, kh, 128]), Memory::HBM),
    dv: transfer(Tensor<f32>([chunk, vh, 128]), Memory::HBM),
    beta: transfer(Tensor<f32>([chunk, vh]), Memory::HBM),
    decay: transfer(Tensor<f32>([chunk, vh]), Memory::HBM),
    o: transfer(Tensor<f32>([chunk, vh, 16, 8]), Memory::HBM),
    router: transfer(Tensor<f32>([cap, (experts + 1 + 63) / 64 * 64]), Memory::HBM),
    ids: transfer(Tensor<i32>([chunk, k]), Memory::HBM),
    wts: transfer(Tensor<f32>([chunk, k]), Memory::HBM),
    e_rows: transfer(Tensor<i32>([positions]), Memory::HBM),
    e_ident: transfer(ident, Memory::HBM),
    e_bases: transfer(Tensor<i32>([positions / 16]), Memory::HBM),
    slot: transfer(Tensor<i32>([chunk * k]), Memory::HBM),
    e_counts: transfer(Tensor<i32>([experts]), Memory::HBM),
    e_lane_counts: transfer(Tensor<i32>([experts * 32]), Memory::HBM),
    e_gu: transfer(Tensor<f32>([positions, 2 * c.moe_intermediate_size]), Memory::HBM),
    e_h: transfer(Tensor<f32>([positions, c.moe_intermediate_size]), Memory::HBM),
    e_out: transfer(Tensor<f32>([positions, c.hidden_size]), Memory::HBM),
    s_gu: transfer(Tensor<f32>([cap, 2 * c.shared_expert_inter]), Memory::HBM),
    s_h: transfer(Tensor<f32>([cap, c.shared_expert_inter]), Memory::HBM),
    s_out: transfer(Tensor<f32>([cap, c.hidden_size]), Memory::HBM),
  };
}

// ------------------------------------------------------------------------------ norms ---

/// `pf_rms_norm` with f32 weights.
pkg fn pf35_rms_norm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, x : &Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<f32, [?], Memory::HBM>, n : i32, dim : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
      for l in 0..1024 across lanes {
        let mut s : f32 = 0.0;
        let mut i = l;
        while i < dim {
          s = s + x[t][i] * x[t][i];
          i = i + 1024;
        }
        part[l] = s;
      }
      let ss = lanes::sum(&part, 1024);
      let inv = 1.0 / (ss / (dim as f32) + eps).sqrt();
      for l in 0..1024 across lanes {
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            y[t][i] = x[t][i] * inv * w[i];
          }
        }
      }
    }
  }
  return;
}

/// `pf_add_rms_norm` with f32 weights: x[t] += y[t], then y[t] = the RMSNorm of x[t] times w.
pkg fn pf35_add_rms_norm(x : &mut Tensor<f32, [?, ?], Memory::HBM>, y : &mut Tensor<f32, [?, ?], Memory::HBM>, w : &Tensor<f32, [?], Memory::HBM>, n : i32, dim : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      let mut part = unsafe { Tensor<f32, [1024], Memory::SMEM>::uninit() };
      for l in 0..1024 across lanes {
        let mut s : f32 = 0.0;
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            let v = x[t][i] + y[t][i];
            x[t][i] = v;
            s = s + v * v;
          }
        }
        part[l] = s;
      }
      let ss = lanes::sum(&part, 1024);
      let inv = 1.0 / (ss / (dim as f32) + eps).sqrt();
      for l in 0..1024 across lanes {
        for j in 0..(dim + 1023) / 1024 {
          let i = j * 1024 + l;
          if i < dim {
            y[t][i] = x[t][i] * inv * w[i];
          }
        }
      }
    }
  }
  return;
}

// --------------------------------------------------------------------------- DeltaNet ---

/// The convolution, the SiLU and the L2 norms of the n tokens of the chunk, as `deltanet_conv` for
/// each. Block (t, h) is one SIMD group for head h of token t, and lane l does its channels 4 l to
/// 4 l + 3. The inputs before the chunk come from `conv_state`, which this kernel does not change.
fn pf_dn_conv(qn : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, kn : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, vv : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, conv_state : &Tensor<f32, [?, ?, ?], Memory::HBM>, proj : &Tensor<f32, [?, ?], Memory::HBM>, conv : &Tensor<f32, [?], Memory::HBM>, n : i32, k_heads : i32, v_heads : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..2 * k_heads + v_heads across blocks {
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let mut y = unsafe { Tensor<f32, [4]>::uninit() };
            for j in 0..4 {
              let i = 4 * l + j;
              let c = h * 128 + i;
              let mut x0 : f32 = 0.0;
              if t >= 3 {
                x0 = proj[t - 3][c];
              } else {
                x0 = conv_state[h][i][t];
              }
              let mut x1 : f32 = 0.0;
              if t >= 2 {
                x1 = proj[t - 2][c];
              } else {
                x1 = conv_state[h][i][t + 1];
              }
              let mut x2 : f32 = 0.0;
              if t >= 1 {
                x2 = proj[t - 1][c];
              } else {
                x2 = conv_state[h][i][2];
              }
              let a = conv[c * 4] * x0 + conv[c * 4 + 1] * x1 + conv[c * 4 + 2] * x2 + conv[c * 4 + 3] * proj[t][c];
              y[j] = a / (1.0 + (0.0 - a).fast_exp());
            }
            let ss = simd_sum(y[0] * y[0] + y[1] * y[1] + y[2] * y[2] + y[3] * y[3]);
            let inv = 1.0 / (ss + 0.000001).sqrt();
            for j in 0..4 {
              if h < k_heads {
                qn[t][h][4 * l + j] = y[j] * inv * 0.08838834764831845;
              } else if h < 2 * k_heads {
                kn[t][h - k_heads][4 * l + j] = y[j] * inv;
              } else {
                vv[t][h - 2 * k_heads][4 * l + j] = y[j];
              }
            }
          }
        }
      }
    }
  }
  return;
}

/// The inputs of the convolution after the chunk: the last 3 of the chunk and of the state before.
fn pf_dn_conv_state(conv_state : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, proj : &Tensor<f32, [?, ?], Memory::HBM>, n : i32, heads : i32) -> void {
  spawn on(Topology::Device) {
    for h in 0..heads across blocks {
      for i in 0..128 across lanes {
        let c = h * 128 + i;
        let mut x = unsafe { Tensor<f32, [3]>::uninit() };
        for j in 0..3 {
          // Input n - 3 + j of the chunk: an input of the chunk, or one of the state before it.
          let at = n - 3 + j;
          if at >= 0 {
            x[j] = proj[at][c];
          } else {
            x[j] = conv_state[h][i][3 + at];
          }
        }
        conv_state[h][i][0] = x[0];
        conv_state[h][i][1] = x[1];
        conv_state[h][i][2] = x[2];
      }
    }
  }
  return;
}

/// beta and the decay of each head of v, for each token of the chunk, as `deltanet_gates`.
fn pf_dn_gates(beta : &mut Tensor<f32, [?, ?], Memory::HBM>, decay : &mut Tensor<f32, [?, ?], Memory::HBM>, proj : &Tensor<f32, [?, ?], Memory::HBM>, neg_a : &Tensor<f32, [?], Memory::HBM>, dt_bias : &Tensor<f32, [?], Memory::HBM>, b_at : i32, a_at : i32, n : i32, v_heads : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for j in 0..64 across lanes {
        if j < v_heads {
          let b = proj[t][b_at + j];
          beta[t][j] = 1.0 / (1.0 + (0.0 - b).fast_exp());
          let x = proj[t][a_at + j] + dt_bias[j];
          let mut sp = x;
          if x <= 20.0 {
            sp = simd_log(1.0 + x.fast_exp());
          }
          decay[t][j] = (neg_a[j] * sp).fast_exp();
        }
      }
    }
  }
  return;
}

/// y[t] = rms_norm(o[t]) * norm * silu(z[t]) for each head of v, as `deltanet_gated_norm`.
fn pf_dn_gated_norm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, o : &Tensor<f32, [?, ?, ?, ?], Memory::HBM>, proj : &Tensor<f32, [?, ?], Memory::HBM>, norm : &Tensor<f32, [?], Memory::HBM>, z_at : i32, n : i32, v_heads : i32, eps : f32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..v_heads across blocks {
        let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        for i in 0..128 across lanes {
          let a = o[t][h][i / 8][i % 8];
          part[i] = a * a;
        }
        let ss = lanes::sum(&part, 128);
        let inv = 1.0 / (ss / 128.0 + eps).sqrt();
        for i in 0..128 across lanes {
          let z = proj[t][z_at + h * 128 + i];
          y[t][h * 128 + i] = o[t][h][i / 8][i % 8] * inv * norm[i] * (z / (1.0 + (0.0 - z).fast_exp()));
        }
      }
    }
  }
  return;
}

/// The update of the state and the output q . S for the n tokens of the chunk, in order. Block (h, vq)
/// is one SIMD group for values vq * 8 to vq * 8 + 7 of v of head h. Lane l owns values 4 l to 4 l + 3
/// of k, and keeps its 32 values of S in registers for the whole chunk: S is read and written once.
/// For each token and value of v, the operations are those of `deltanet_recur`, in the same order.
/// o[t][h][vq][m] is the output of value vq * 8 + m.
fn pf_dn_recur(o : &mut Tensor<f32, [?, ?, ?, ?], Memory::HBM>, state : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, qn : &Tensor<f32, [?, ?, ?], Memory::HBM>, kn : &Tensor<f32, [?, ?, ?], Memory::HBM>, vv : &Tensor<f32, [?, ?, ?], Memory::HBM>, beta : &Tensor<f32, [?, ?], Memory::HBM>, decay : &Tensor<f32, [?, ?], Memory::HBM>, group : i32, n : i32, v_heads : i32) -> void {
  spawn on(Topology::Device) {
    for h in 0..v_heads across blocks {
      for vq in 0..16 across blocks {
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let mut s0_0 = state[h][vq * 8 + 0][d + 0];
            let mut s0_1 = state[h][vq * 8 + 0][d + 1];
            let mut s0_2 = state[h][vq * 8 + 0][d + 2];
            let mut s0_3 = state[h][vq * 8 + 0][d + 3];
            let mut s1_0 = state[h][vq * 8 + 1][d + 0];
            let mut s1_1 = state[h][vq * 8 + 1][d + 1];
            let mut s1_2 = state[h][vq * 8 + 1][d + 2];
            let mut s1_3 = state[h][vq * 8 + 1][d + 3];
            let mut s2_0 = state[h][vq * 8 + 2][d + 0];
            let mut s2_1 = state[h][vq * 8 + 2][d + 1];
            let mut s2_2 = state[h][vq * 8 + 2][d + 2];
            let mut s2_3 = state[h][vq * 8 + 2][d + 3];
            let mut s3_0 = state[h][vq * 8 + 3][d + 0];
            let mut s3_1 = state[h][vq * 8 + 3][d + 1];
            let mut s3_2 = state[h][vq * 8 + 3][d + 2];
            let mut s3_3 = state[h][vq * 8 + 3][d + 3];
            let mut s4_0 = state[h][vq * 8 + 4][d + 0];
            let mut s4_1 = state[h][vq * 8 + 4][d + 1];
            let mut s4_2 = state[h][vq * 8 + 4][d + 2];
            let mut s4_3 = state[h][vq * 8 + 4][d + 3];
            let mut s5_0 = state[h][vq * 8 + 5][d + 0];
            let mut s5_1 = state[h][vq * 8 + 5][d + 1];
            let mut s5_2 = state[h][vq * 8 + 5][d + 2];
            let mut s5_3 = state[h][vq * 8 + 5][d + 3];
            let mut s6_0 = state[h][vq * 8 + 6][d + 0];
            let mut s6_1 = state[h][vq * 8 + 6][d + 1];
            let mut s6_2 = state[h][vq * 8 + 6][d + 2];
            let mut s6_3 = state[h][vq * 8 + 6][d + 3];
            let mut s7_0 = state[h][vq * 8 + 7][d + 0];
            let mut s7_1 = state[h][vq * 8 + 7][d + 1];
            let mut s7_2 = state[h][vq * 8 + 7][d + 2];
            let mut s7_3 = state[h][vq * 8 + 7][d + 3];
            for t in 0..n {
              let q0 = qn[t][g][d + 0];
              let q1 = qn[t][g][d + 1];
              let q2 = qn[t][g][d + 2];
              let q3 = qn[t][g][d + 3];
              let k0 = kn[t][g][d + 0];
              let k1 = kn[t][g][d + 1];
              let k2 = kn[t][g][d + 2];
              let k3 = kn[t][g][d + 3];
              let b = beta[t][h];
              let dec = decay[t][h];
              let mut mine : f32 = 0.0;
              let a0_0 = s0_0 * dec;
              let a0_1 = s0_1 * dec;
              let a0_2 = s0_2 * dec;
              let a0_3 = s0_3 * dec;
              let kv0 = simd_sum(a0_0 * k0 + a0_1 * k1 + a0_2 * k2 + a0_3 * k3);
              let delta0 = (vv[t][h][vq * 8 + 0] - kv0) * b;
              s0_0 = a0_0 + k0 * delta0;
              s0_1 = a0_1 + k1 * delta0;
              s0_2 = a0_2 + k2 * delta0;
              s0_3 = a0_3 + k3 * delta0;
              let out0 = simd_sum(s0_0 * q0 + s0_1 * q1 + s0_2 * q2 + s0_3 * q3);
              if l == 0 {
                mine = out0;
              }
              let a1_0 = s1_0 * dec;
              let a1_1 = s1_1 * dec;
              let a1_2 = s1_2 * dec;
              let a1_3 = s1_3 * dec;
              let kv1 = simd_sum(a1_0 * k0 + a1_1 * k1 + a1_2 * k2 + a1_3 * k3);
              let delta1 = (vv[t][h][vq * 8 + 1] - kv1) * b;
              s1_0 = a1_0 + k0 * delta1;
              s1_1 = a1_1 + k1 * delta1;
              s1_2 = a1_2 + k2 * delta1;
              s1_3 = a1_3 + k3 * delta1;
              let out1 = simd_sum(s1_0 * q0 + s1_1 * q1 + s1_2 * q2 + s1_3 * q3);
              if l == 1 {
                mine = out1;
              }
              let a2_0 = s2_0 * dec;
              let a2_1 = s2_1 * dec;
              let a2_2 = s2_2 * dec;
              let a2_3 = s2_3 * dec;
              let kv2 = simd_sum(a2_0 * k0 + a2_1 * k1 + a2_2 * k2 + a2_3 * k3);
              let delta2 = (vv[t][h][vq * 8 + 2] - kv2) * b;
              s2_0 = a2_0 + k0 * delta2;
              s2_1 = a2_1 + k1 * delta2;
              s2_2 = a2_2 + k2 * delta2;
              s2_3 = a2_3 + k3 * delta2;
              let out2 = simd_sum(s2_0 * q0 + s2_1 * q1 + s2_2 * q2 + s2_3 * q3);
              if l == 2 {
                mine = out2;
              }
              let a3_0 = s3_0 * dec;
              let a3_1 = s3_1 * dec;
              let a3_2 = s3_2 * dec;
              let a3_3 = s3_3 * dec;
              let kv3 = simd_sum(a3_0 * k0 + a3_1 * k1 + a3_2 * k2 + a3_3 * k3);
              let delta3 = (vv[t][h][vq * 8 + 3] - kv3) * b;
              s3_0 = a3_0 + k0 * delta3;
              s3_1 = a3_1 + k1 * delta3;
              s3_2 = a3_2 + k2 * delta3;
              s3_3 = a3_3 + k3 * delta3;
              let out3 = simd_sum(s3_0 * q0 + s3_1 * q1 + s3_2 * q2 + s3_3 * q3);
              if l == 3 {
                mine = out3;
              }
              let a4_0 = s4_0 * dec;
              let a4_1 = s4_1 * dec;
              let a4_2 = s4_2 * dec;
              let a4_3 = s4_3 * dec;
              let kv4 = simd_sum(a4_0 * k0 + a4_1 * k1 + a4_2 * k2 + a4_3 * k3);
              let delta4 = (vv[t][h][vq * 8 + 4] - kv4) * b;
              s4_0 = a4_0 + k0 * delta4;
              s4_1 = a4_1 + k1 * delta4;
              s4_2 = a4_2 + k2 * delta4;
              s4_3 = a4_3 + k3 * delta4;
              let out4 = simd_sum(s4_0 * q0 + s4_1 * q1 + s4_2 * q2 + s4_3 * q3);
              if l == 4 {
                mine = out4;
              }
              let a5_0 = s5_0 * dec;
              let a5_1 = s5_1 * dec;
              let a5_2 = s5_2 * dec;
              let a5_3 = s5_3 * dec;
              let kv5 = simd_sum(a5_0 * k0 + a5_1 * k1 + a5_2 * k2 + a5_3 * k3);
              let delta5 = (vv[t][h][vq * 8 + 5] - kv5) * b;
              s5_0 = a5_0 + k0 * delta5;
              s5_1 = a5_1 + k1 * delta5;
              s5_2 = a5_2 + k2 * delta5;
              s5_3 = a5_3 + k3 * delta5;
              let out5 = simd_sum(s5_0 * q0 + s5_1 * q1 + s5_2 * q2 + s5_3 * q3);
              if l == 5 {
                mine = out5;
              }
              let a6_0 = s6_0 * dec;
              let a6_1 = s6_1 * dec;
              let a6_2 = s6_2 * dec;
              let a6_3 = s6_3 * dec;
              let kv6 = simd_sum(a6_0 * k0 + a6_1 * k1 + a6_2 * k2 + a6_3 * k3);
              let delta6 = (vv[t][h][vq * 8 + 6] - kv6) * b;
              s6_0 = a6_0 + k0 * delta6;
              s6_1 = a6_1 + k1 * delta6;
              s6_2 = a6_2 + k2 * delta6;
              s6_3 = a6_3 + k3 * delta6;
              let out6 = simd_sum(s6_0 * q0 + s6_1 * q1 + s6_2 * q2 + s6_3 * q3);
              if l == 6 {
                mine = out6;
              }
              let a7_0 = s7_0 * dec;
              let a7_1 = s7_1 * dec;
              let a7_2 = s7_2 * dec;
              let a7_3 = s7_3 * dec;
              let kv7 = simd_sum(a7_0 * k0 + a7_1 * k1 + a7_2 * k2 + a7_3 * k3);
              let delta7 = (vv[t][h][vq * 8 + 7] - kv7) * b;
              s7_0 = a7_0 + k0 * delta7;
              s7_1 = a7_1 + k1 * delta7;
              s7_2 = a7_2 + k2 * delta7;
              s7_3 = a7_3 + k3 * delta7;
              let out7 = simd_sum(s7_0 * q0 + s7_1 * q1 + s7_2 * q2 + s7_3 * q3);
              if l == 7 {
                mine = out7;
              }
              if l < 8 {
                o[t][h][vq][l] = mine;
              }
            }
            state[h][vq * 8 + 0][d + 0] = s0_0;
            state[h][vq * 8 + 0][d + 1] = s0_1;
            state[h][vq * 8 + 0][d + 2] = s0_2;
            state[h][vq * 8 + 0][d + 3] = s0_3;
            state[h][vq * 8 + 1][d + 0] = s1_0;
            state[h][vq * 8 + 1][d + 1] = s1_1;
            state[h][vq * 8 + 1][d + 2] = s1_2;
            state[h][vq * 8 + 1][d + 3] = s1_3;
            state[h][vq * 8 + 2][d + 0] = s2_0;
            state[h][vq * 8 + 2][d + 1] = s2_1;
            state[h][vq * 8 + 2][d + 2] = s2_2;
            state[h][vq * 8 + 2][d + 3] = s2_3;
            state[h][vq * 8 + 3][d + 0] = s3_0;
            state[h][vq * 8 + 3][d + 1] = s3_1;
            state[h][vq * 8 + 3][d + 2] = s3_2;
            state[h][vq * 8 + 3][d + 3] = s3_3;
            state[h][vq * 8 + 4][d + 0] = s4_0;
            state[h][vq * 8 + 4][d + 1] = s4_1;
            state[h][vq * 8 + 4][d + 2] = s4_2;
            state[h][vq * 8 + 4][d + 3] = s4_3;
            state[h][vq * 8 + 5][d + 0] = s5_0;
            state[h][vq * 8 + 5][d + 1] = s5_1;
            state[h][vq * 8 + 5][d + 2] = s5_2;
            state[h][vq * 8 + 5][d + 3] = s5_3;
            state[h][vq * 8 + 6][d + 0] = s6_0;
            state[h][vq * 8 + 6][d + 1] = s6_1;
            state[h][vq * 8 + 6][d + 2] = s6_2;
            state[h][vq * 8 + 6][d + 3] = s6_3;
            state[h][vq * 8 + 7][d + 0] = s7_0;
            state[h][vq * 8 + 7][d + 1] = s7_1;
            state[h][vq * 8 + 7][d + 2] = s7_2;
            state[h][vq * 8 + 7][d + 3] = s7_3;
          }
        }
      }
    }
  }
  return;
}

// --------------------------------------------------------------------- full attention ---

/// The norms and RoPE of q and k, and the store of k and v, for the n tokens of the chunk, as
/// `gated_norm_rope_and_store`: token t is at position start + t. Block (t, h) does head h of q,
/// then the heads of k.
pkg fn pf_gated_norm_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, qkvg : &Tensor<f32, [?, ?], Memory::HBM>, q_norm : &Tensor<f32, [?], Memory::HBM>, k_norm : &Tensor<f32, [?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, rot : i32, eps : f32) -> void {
  let half = rot / 2;
  assert(k_cache.extent(0) >= start + n && v_cache.extent(0) >= start + n && cos.extent(0) >= start + n && sin.extent(0) >= start + n, "pf_gated_norm_rope_and_store: the caches and the angles need rows for the chunk");
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        let mut x = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
        let mut part = unsafe { Tensor<f32, [256], Memory::SMEM>::uninit() };
        for i in 0..256 across lanes {
          let a = qkvg[t][h * 256 + i];
          x[i] = a;
          part[i] = a * a;
        }
        let ss = lanes::sum(&part, 256);
        let inv = 1.0 / (ss / 256.0 + eps).sqrt();
        for i in 0..256 across lanes {
          let pos = start + t;
          let mut w = q_norm[i];
          if h >= q_heads {
            w = k_norm[i];
          }
          let a = x[i] * inv * w;
          let mut r = a;
          if i < rot {
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let mut wp = q_norm[partner];
            if h >= q_heads {
              wp = k_norm[partner];
            }
            let b = x[partner] * inv * wp;
            r = a * cos[pos][j] + sign * b * sin[pos][j];
          }
          if h < q_heads {
            q_out[t][h][i] = r;
          } else {
            k_cache[pos][h - q_heads][i] = r as f16;
            v_cache[pos][h - q_heads][i] = qkvg[t][(kv_heads + h) * 256 + i] as f16;
          }
        }
      }
    }
  }
  return;
}

/// y[t][h * 256 + d] = the attention of query head h of token t (at position start + t) over the
/// positions up to start + t, times sigmoid(qkvg[t][gate_at + h * 256 + d]), for t below n: the
/// gated attention of `gated_attention`. A threadgroup does 8 tokens of one query head, in steps of 64
/// positions, as `pf_flash_attention` and llama.cpp's kernel_flash_attn_ext. The caches are
/// [position, kv_heads, 256] f16, with a multiple of 64 positions. K and V go from the cache straight
/// into simdgroup matrices, K transposed; Q (as f16), the scores, the weights (as f16) and the sums
/// of the 8 tokens are in shared memory. The softmax is online, in all the lanes of a subgroup.
///
/// The design is that of llama.cpp (ggml/src/ggml-metal/kernels/fa_common.metal), MIT License,
/// Copyright (c) 2023-2026 The ggml authors.
///
/// scripts/mlir_kernels/gated_flash_attention.py writes this function: change that script, not the
/// MLIR.
pkg fn pf_gated_flash_attention(y : &mut Tensor<f32, [?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, qkvg : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, group : i32, gate_at : i32, scale : f32) -> void {
  assert(q.extent(2) == 256 && k_cache.extent(2) == 256 && k_cache.extent(0) % 64 == 0 && start + n <= k_cache.extent(0), "pf_gated_flash_attention: heads of 256 values, and a KV cache of a multiple of 64 positions");
  spawn on(Topology::Device) {
    for qb in 0..(n + 7) / 8 across blocks {
      for h in 0..q_heads across blocks {
        let mut sq = unsafe { Tensor<f16, [2048], Memory::SMEM>::uninit() };
        let mut so = unsafe { Tensor<f32, [2048], Memory::SMEM>::uninit() };
        let mut ss = unsafe { Tensor<f32, [512], Memory::SMEM>::uninit() };
        let mut sp = unsafe { Tensor<f16, [512], Memory::SMEM>::uninit() };
        let _d = unsafe { mlir!( threads : 128, inputs : (%sq = &mut sq : memref<2048xf16, 3>, %so = &mut so : memref<2048xf32, 3>, %ss = &mut ss : memref<512xf32, 3>, %sp = &mut sp : memref<512xf16, 3>, %y = y : memref<?x?xf32>, %q = q : memref<?x?x?xf32>, %k3 = k_cache : memref<?x?x?xf16>, %v3 = v_cache : memref<?x?x?xf16>, %qkvg = qkvg : memref<?x?xf32>, %start = start : i32, %n = n : i32, %group = group : i32, %gate_at = gate_at : i32, %scale = scale : f32, %qb = qb : i32, %h = h : i32), returns : i32, dialects : ["arith", "memref", "scf", "gpu", "vector", "math"], ensures : [writes_only(sq), writes_only(so), writes_only(ss), writes_only(sp), reads_only(q), reads_only(k_cache), reads_only(v_cache), reads_only(qkvg), writes_only(y[qb * 8..qb * 8 + 8][h * 256..h * 256 + 256])]) {
          %c0 = arith.constant 0 : index
          %c1 = arith.constant 1 : index
          %c2 = arith.constant 2 : index
          %c4 = arith.constant 4 : index
          %c8 = arith.constant 8 : index
          %c12 = arith.constant 12 : index
          %c16 = arith.constant 16 : index
          %c32 = arith.constant 32 : index
          %c64 = arith.constant 64 : index
          %c256 = arith.constant 256 : index
          %tid = gpu.thread_id x
          %sg = arith.divui %tid, %c32 : index
          %l = arith.remui %tid, %c32 : index
          %qbi = arith.index_cast %qb : i32 to index
          %hi = arith.index_cast %h : i32 to index
          %ni = arith.index_cast %n : i32 to index
          %starti = arith.index_cast %start : i32 to index
          %groupi = arith.index_cast %group : i32 to index
          %gatei = arith.index_cast %gate_at : i32 to index
          %g = arith.divui %hi, %groupi : index
          %gD = arith.muli %g, %c256 : index
          %P = memref.dim %k3, %c0 : memref<?x?x?xf16>
          %KH = memref.dim %k3, %c1 : memref<?x?x?xf16>
          %Wd = arith.muli %KH, %c256 : index
          %k = memref.reinterpret_cast %k3 to offset: [0], sizes: [%P, %Wd], strides: [%Wd, 1] : memref<?x?x?xf16> to memref<?x?xf16, strided<[?, 1]>>
          %v = memref.reinterpret_cast %v3 to offset: [0], sizes: [%P, %Wd], strides: [%Wd, 1] : memref<?x?x?xf16> to memref<?x?xf16, strided<[?, 1]>>
          %t0 = arith.muli %qbi, %c8 : index
          %qj = arith.divui %tid, %c16 : index
          %qm = arith.remui %tid, %c16 : index
          %qc = arith.muli %qm, %c16 : index
          %qt = arith.addi %t0, %qj : index
          %nm1 = arith.subi %ni, %c1 : index
          %qtc = arith.minui %qt, %nm1 : index
          %qlive = arith.cmpi ult, %qt, %ni : index
          %vz4 = arith.constant dense<0.0> : vector<4xf32>
          %sqo = arith.muli %qj, %c256 : index
          %sqa = arith.addi %sqo, %qc : index
          %qc0 = arith.addi %qc, %c0 : index
          %sq0 = arith.addi %sqa, %c0 : index
          %q0r = vector.load %q[%qtc, %hi, %qc0] : memref<?x?x?xf32>, vector<4xf32>
          %q0 = arith.select %qlive, %q0r, %vz4 : vector<4xf32>
          %q0h = arith.truncf %q0 : vector<4xf32> to vector<4xf16>
          vector.store %q0h, %sq[%sq0] : memref<2048xf16, 3>, vector<4xf16>
          vector.store %vz4, %so[%sq0] : memref<2048xf32, 3>, vector<4xf32>
          %qc1 = arith.addi %qc, %c4 : index
          %sq1 = arith.addi %sqa, %c4 : index
          %q1r = vector.load %q[%qtc, %hi, %qc1] : memref<?x?x?xf32>, vector<4xf32>
          %q1 = arith.select %qlive, %q1r, %vz4 : vector<4xf32>
          %q1h = arith.truncf %q1 : vector<4xf32> to vector<4xf16>
          vector.store %q1h, %sq[%sq1] : memref<2048xf16, 3>, vector<4xf16>
          vector.store %vz4, %so[%sq1] : memref<2048xf32, 3>, vector<4xf32>
          %qc2 = arith.addi %qc, %c8 : index
          %sq2 = arith.addi %sqa, %c8 : index
          %q2r = vector.load %q[%qtc, %hi, %qc2] : memref<?x?x?xf32>, vector<4xf32>
          %q2 = arith.select %qlive, %q2r, %vz4 : vector<4xf32>
          %q2h = arith.truncf %q2 : vector<4xf32> to vector<4xf16>
          vector.store %q2h, %sq[%sq2] : memref<2048xf16, 3>, vector<4xf16>
          vector.store %vz4, %so[%sq2] : memref<2048xf32, 3>, vector<4xf32>
          %qc3 = arith.addi %qc, %c12 : index
          %sq3 = arith.addi %sqa, %c12 : index
          %q3r = vector.load %q[%qtc, %hi, %qc3] : memref<?x?x?xf32>, vector<4xf32>
          %q3 = arith.select %qlive, %q3r, %vz4 : vector<4xf32>
          %q3h = arith.truncf %q3 : vector<4xf32> to vector<4xf16>
          vector.store %q3h, %sq[%sq3] : memref<2048xf16, 3>, vector<4xf16>
          vector.store %vz4, %so[%sq3] : memref<2048xf32, 3>, vector<4xf32>
          gpu.barrier
          %tl = arith.addi %t0, %c8 : index
          %tlc = arith.minui %tl, %ni : index
          %lastq = arith.subi %tlc, %c1 : index
          %lastp = arith.addi %starti, %lastq : index
          %nblk0 = arith.divui %lastp, %c64 : index
          %nblk = arith.addi %nblk0, %c1 : index
          %j0 = arith.addi %sg, %c0 : index
          %j1 = arith.addi %sg, %c4 : index
          %qt0 = arith.addi %t0, %j0 : index
          %qp0 = arith.addi %starti, %qt0 : index
          %qt1 = arith.addi %t0, %j1 : index
          %qp1 = arith.addi %starti, %qt1 : index
          %neg = arith.constant -3.0e38 : f32
          %zero = arith.constant 0.0 : f32
          %l2 = arith.muli %l, %c2 : index
          %l8 = arith.muli %l, %c8 : index
          %zacc = gpu.subgroup_mma_constant_matrix %zero : !gpu.mma_matrix<8x8xf32, "COp">
          %st:4 = scf.for %kb = %c0 to %nblk step %c1 iter_args(%M0 = %neg, %S0 = %zero, %M1 = %neg, %S1 = %zero) -> (f32, f32, f32, f32) {
            %p0 = arith.muli %kb, %c64 : index
            %sg8 = arith.muli %sg, %c8 : index
            %kc0 = arith.addi %sg8, %c0 : index
            %kp0 = arith.addi %p0, %kc0 : index
            %qk0 = scf.for %i = %c0 to %c32 step %c1 iter_args(%a = %zacc) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %d0 = arith.muli %i, %c8 : index
              %mq = gpu.subgroup_mma_load_matrix %sq[%d0] {leadDimension = 256 : index} : memref<2048xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %kd = arith.addi %gD, %d0 : index
              %mk = gpu.subgroup_mma_load_matrix %k[%kp0, %kd] {leadDimension = 0 : index, transpose} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %a2 = gpu.subgroup_mma_compute %mq, %mk, %a : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %a2 : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %qk0, %ss[%kc0] {leadDimension = 64 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<512xf32, 3>
            %kc1 = arith.addi %sg8, %c32 : index
            %kp1 = arith.addi %p0, %kc1 : index
            %qk1 = scf.for %i = %c0 to %c32 step %c1 iter_args(%a = %zacc) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %d0 = arith.muli %i, %c8 : index
              %mq = gpu.subgroup_mma_load_matrix %sq[%d0] {leadDimension = 256 : index} : memref<2048xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %kd = arith.addi %gD, %d0 : index
              %mk = gpu.subgroup_mma_load_matrix %k[%kp1, %kd] {leadDimension = 0 : index, transpose} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %a2 = gpu.subgroup_mma_compute %mq, %mk, %a : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %a2 : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %qk1, %ss[%kc1] {leadDimension = 64 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<512xf32, 3>
            gpu.barrier
            %r0 = arith.muli %j0, %c64 : index
            %ia0 = arith.addi %r0, %l2 : index
            %ib0 = arith.addi %ia0, %c1 : index
            %sa0r = memref.load %ss[%ia0] : memref<512xf32, 3>
            %sb0r = memref.load %ss[%ib0] : memref<512xf32, 3>
            %sa0s = arith.mulf %sa0r, %scale : f32
            %sb0s = arith.mulf %sb0r, %scale : f32
            %pa0 = arith.addi %p0, %l2 : index
            %pb0 = arith.addi %pa0, %c1 : index
            %oka0 = arith.cmpi ule, %pa0, %qp0 : index
            %okb0 = arith.cmpi ule, %pb0, %qp0 : index
            %sa0 = arith.select %oka0, %sa0s, %neg : f32
            %sb0 = arith.select %okb0, %sb0s, %neg : f32
            %mx0 = arith.maxnumf %sa0, %sb0 : f32
            %bm0 = gpu.subgroup_reduce maxnumf %mx0 : (f32) -> f32
            %Mn0 = arith.maxnumf %M0, %bm0 : f32
            %dm0 = arith.subf %M0, %Mn0 : f32
            %ms0 = math.exp %dm0 : f32
            %ea0 = arith.subf %sa0, %Mn0 : f32
            %eb0 = arith.subf %sb0, %Mn0 : f32
            %xa0 = math.exp %ea0 : f32
            %xb0 = math.exp %eb0 : f32
            %xs0 = arith.addf %xa0, %xb0 : f32
            %bs0 = gpu.subgroup_reduce add %xs0 : (f32) -> f32
            %Ss0 = arith.mulf %S0, %ms0 : f32
            %Sn0 = arith.addf %Ss0, %bs0 : f32
            %ha0 = arith.truncf %xa0 : f32 to f16
            %hb0 = arith.truncf %xb0 : f32 to f16
            memref.store %ha0, %sp[%ia0] : memref<512xf16, 3>
            memref.store %hb0, %sp[%ib0] : memref<512xf16, 3>
            %or0 = arith.muli %j0, %c256 : index
            %oi0 = arith.addi %or0, %l8 : index
            %oj0 = arith.addi %oi0, %c4 : index
            %msv0 = vector.broadcast %ms0 : f32 to vector<4xf32>
            %ov0a = vector.load %so[%oi0] : memref<2048xf32, 3>, vector<4xf32>
            %ow0a = arith.mulf %ov0a, %msv0 : vector<4xf32>
            vector.store %ow0a, %so[%oi0] : memref<2048xf32, 3>, vector<4xf32>
            %ov0b = vector.load %so[%oj0] : memref<2048xf32, 3>, vector<4xf32>
            %ow0b = arith.mulf %ov0b, %msv0 : vector<4xf32>
            vector.store %ow0b, %so[%oj0] : memref<2048xf32, 3>, vector<4xf32>
            %r1 = arith.muli %j1, %c64 : index
            %ia1 = arith.addi %r1, %l2 : index
            %ib1 = arith.addi %ia1, %c1 : index
            %sa1r = memref.load %ss[%ia1] : memref<512xf32, 3>
            %sb1r = memref.load %ss[%ib1] : memref<512xf32, 3>
            %sa1s = arith.mulf %sa1r, %scale : f32
            %sb1s = arith.mulf %sb1r, %scale : f32
            %pa1 = arith.addi %p0, %l2 : index
            %pb1 = arith.addi %pa1, %c1 : index
            %oka1 = arith.cmpi ule, %pa1, %qp1 : index
            %okb1 = arith.cmpi ule, %pb1, %qp1 : index
            %sa1 = arith.select %oka1, %sa1s, %neg : f32
            %sb1 = arith.select %okb1, %sb1s, %neg : f32
            %mx1 = arith.maxnumf %sa1, %sb1 : f32
            %bm1 = gpu.subgroup_reduce maxnumf %mx1 : (f32) -> f32
            %Mn1 = arith.maxnumf %M1, %bm1 : f32
            %dm1 = arith.subf %M1, %Mn1 : f32
            %ms1 = math.exp %dm1 : f32
            %ea1 = arith.subf %sa1, %Mn1 : f32
            %eb1 = arith.subf %sb1, %Mn1 : f32
            %xa1 = math.exp %ea1 : f32
            %xb1 = math.exp %eb1 : f32
            %xs1 = arith.addf %xa1, %xb1 : f32
            %bs1 = gpu.subgroup_reduce add %xs1 : (f32) -> f32
            %Ss1 = arith.mulf %S1, %ms1 : f32
            %Sn1 = arith.addf %Ss1, %bs1 : f32
            %ha1 = arith.truncf %xa1 : f32 to f16
            %hb1 = arith.truncf %xb1 : f32 to f16
            memref.store %ha1, %sp[%ia1] : memref<512xf16, 3>
            memref.store %hb1, %sp[%ib1] : memref<512xf16, 3>
            %or1 = arith.muli %j1, %c256 : index
            %oi1 = arith.addi %or1, %l8 : index
            %oj1 = arith.addi %oi1, %c4 : index
            %msv1 = vector.broadcast %ms1 : f32 to vector<4xf32>
            %ov1a = vector.load %so[%oi1] : memref<2048xf32, 3>, vector<4xf32>
            %ow1a = arith.mulf %ov1a, %msv1 : vector<4xf32>
            vector.store %ow1a, %so[%oi1] : memref<2048xf32, 3>, vector<4xf32>
            %ov1b = vector.load %so[%oj1] : memref<2048xf32, 3>, vector<4xf32>
            %ow1b = arith.mulf %ov1b, %msv1 : vector<4xf32>
            vector.store %ow1b, %so[%oj1] : memref<2048xf32, 3>, vector<4xf32>
            gpu.barrier
            %dv0c = arith.constant 0 : index
            %dv0 = arith.addi %sg8, %dv0c : index
            %o0i = gpu.subgroup_mma_load_matrix %so[%dv0] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd0 = arith.addi %gD, %dv0 : index
            %o0 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o0i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd0] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o0, %so[%dv0] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv1c = arith.constant 32 : index
            %dv1 = arith.addi %sg8, %dv1c : index
            %o1i = gpu.subgroup_mma_load_matrix %so[%dv1] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd1 = arith.addi %gD, %dv1 : index
            %o1 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o1i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd1] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o1, %so[%dv1] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv2c = arith.constant 64 : index
            %dv2 = arith.addi %sg8, %dv2c : index
            %o2i = gpu.subgroup_mma_load_matrix %so[%dv2] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd2 = arith.addi %gD, %dv2 : index
            %o2 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o2i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd2] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o2, %so[%dv2] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv3c = arith.constant 96 : index
            %dv3 = arith.addi %sg8, %dv3c : index
            %o3i = gpu.subgroup_mma_load_matrix %so[%dv3] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd3 = arith.addi %gD, %dv3 : index
            %o3 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o3i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd3] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o3, %so[%dv3] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv4c = arith.constant 128 : index
            %dv4 = arith.addi %sg8, %dv4c : index
            %o4i = gpu.subgroup_mma_load_matrix %so[%dv4] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd4 = arith.addi %gD, %dv4 : index
            %o4 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o4i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd4] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o4, %so[%dv4] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv5c = arith.constant 160 : index
            %dv5 = arith.addi %sg8, %dv5c : index
            %o5i = gpu.subgroup_mma_load_matrix %so[%dv5] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd5 = arith.addi %gD, %dv5 : index
            %o5 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o5i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd5] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o5, %so[%dv5] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv6c = arith.constant 192 : index
            %dv6 = arith.addi %sg8, %dv6c : index
            %o6i = gpu.subgroup_mma_load_matrix %so[%dv6] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd6 = arith.addi %gD, %dv6 : index
            %o6 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o6i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd6] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o6, %so[%dv6] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            %dv7c = arith.constant 224 : index
            %dv7 = arith.addi %sg8, %dv7c : index
            %o7i = gpu.subgroup_mma_load_matrix %so[%dv7] {leadDimension = 256 : index} : memref<2048xf32, 3> -> !gpu.mma_matrix<8x8xf32, "COp">
            %vd7 = arith.addi %gD, %dv7 : index
            %o7 = scf.for %kk = %c0 to %c8 step %c1 iter_args(%o = %o7i) -> (!gpu.mma_matrix<8x8xf32, "COp">) {
              %k8 = arith.muli %kk, %c8 : index
              %mp = gpu.subgroup_mma_load_matrix %sp[%k8] {leadDimension = 64 : index} : memref<512xf16, 3> -> !gpu.mma_matrix<8x8xf16, "AOp">
              %vp = arith.addi %p0, %k8 : index
              %mv = gpu.subgroup_mma_load_matrix %v[%vp, %vd7] {leadDimension = 0 : index} : memref<?x?xf16, strided<[?, 1]>> -> !gpu.mma_matrix<8x8xf16, "BOp">
              %onx = gpu.subgroup_mma_compute %mp, %mv, %o : !gpu.mma_matrix<8x8xf16, "AOp">, !gpu.mma_matrix<8x8xf16, "BOp"> -> !gpu.mma_matrix<8x8xf32, "COp">
              scf.yield %onx : !gpu.mma_matrix<8x8xf32, "COp">
            }
            gpu.subgroup_mma_store_matrix %o7, %so[%dv7] {leadDimension = 256 : index} : !gpu.mma_matrix<8x8xf32, "COp">, memref<2048xf32, 3>
            gpu.barrier
            scf.yield %Mn0, %Sn0, %Mn1, %Sn1 : f32, f32, f32, f32
          }
          %hD = arith.muli %hi, %c256 : index
          %gh = arith.addi %gatei, %hD : index
          %one = arith.constant 1.0 : f32
          %one4 = arith.constant dense<1.0> : vector<4xf32>
          %inv0 = arith.divf %one, %st#1 : f32
          %iv0 = vector.broadcast %inv0 : f32 to vector<4xf32>
          %fr0 = arith.muli %j0, %c256 : index
          %live0 = arith.cmpi ult, %qt0, %ni : index
          scf.if %live0 {
            %fl0a = arith.addi %l8, %c0 : index
            %fi0a = arith.addi %fr0, %fl0a : index
            %fv0a = vector.load %so[%fi0a] : memref<2048xf32, 3>, vector<4xf32>
            %fw0a = arith.mulf %fv0a, %iv0 : vector<4xf32>
            %gi0a = arith.addi %gh, %fl0a : index
            %gv0a = vector.load %qkvg[%qt0, %gi0a] : memref<?x?xf32>, vector<4xf32>
            %gn0a = arith.negf %gv0a : vector<4xf32>
            %ge0a = math.exp %gn0a : vector<4xf32>
            %gd0a = arith.addf %ge0a, %one4 : vector<4xf32>
            %fg0a = arith.divf %fw0a, %gd0a : vector<4xf32>
            %yc0a = arith.addi %hD, %fl0a : index
            vector.store %fg0a, %y[%qt0, %yc0a] : memref<?x?xf32>, vector<4xf32>
            %fl0b = arith.addi %l8, %c4 : index
            %fi0b = arith.addi %fr0, %fl0b : index
            %fv0b = vector.load %so[%fi0b] : memref<2048xf32, 3>, vector<4xf32>
            %fw0b = arith.mulf %fv0b, %iv0 : vector<4xf32>
            %gi0b = arith.addi %gh, %fl0b : index
            %gv0b = vector.load %qkvg[%qt0, %gi0b] : memref<?x?xf32>, vector<4xf32>
            %gn0b = arith.negf %gv0b : vector<4xf32>
            %ge0b = math.exp %gn0b : vector<4xf32>
            %gd0b = arith.addf %ge0b, %one4 : vector<4xf32>
            %fg0b = arith.divf %fw0b, %gd0b : vector<4xf32>
            %yc0b = arith.addi %hD, %fl0b : index
            vector.store %fg0b, %y[%qt0, %yc0b] : memref<?x?xf32>, vector<4xf32>
          }
          %inv1 = arith.divf %one, %st#3 : f32
          %iv1 = vector.broadcast %inv1 : f32 to vector<4xf32>
          %fr1 = arith.muli %j1, %c256 : index
          %live1 = arith.cmpi ult, %qt1, %ni : index
          scf.if %live1 {
            %fl1a = arith.addi %l8, %c0 : index
            %fi1a = arith.addi %fr1, %fl1a : index
            %fv1a = vector.load %so[%fi1a] : memref<2048xf32, 3>, vector<4xf32>
            %fw1a = arith.mulf %fv1a, %iv1 : vector<4xf32>
            %gi1a = arith.addi %gh, %fl1a : index
            %gv1a = vector.load %qkvg[%qt1, %gi1a] : memref<?x?xf32>, vector<4xf32>
            %gn1a = arith.negf %gv1a : vector<4xf32>
            %ge1a = math.exp %gn1a : vector<4xf32>
            %gd1a = arith.addf %ge1a, %one4 : vector<4xf32>
            %fg1a = arith.divf %fw1a, %gd1a : vector<4xf32>
            %yc1a = arith.addi %hD, %fl1a : index
            vector.store %fg1a, %y[%qt1, %yc1a] : memref<?x?xf32>, vector<4xf32>
            %fl1b = arith.addi %l8, %c4 : index
            %fi1b = arith.addi %fr1, %fl1b : index
            %fv1b = vector.load %so[%fi1b] : memref<2048xf32, 3>, vector<4xf32>
            %fw1b = arith.mulf %fv1b, %iv1 : vector<4xf32>
            %gi1b = arith.addi %gh, %fl1b : index
            %gv1b = vector.load %qkvg[%qt1, %gi1b] : memref<?x?xf32>, vector<4xf32>
            %gn1b = arith.negf %gv1b : vector<4xf32>
            %ge1b = math.exp %gn1b : vector<4xf32>
            %gd1b = arith.addf %ge1b, %one4 : vector<4xf32>
            %fg1b = arith.divf %fw1b, %gd1b : vector<4xf32>
            %yc1b = arith.addi %hD, %fl1b : index
            vector.store %fg1b, %y[%qt1, %yc1b] : memref<?x?xf32>, vector<4xf32>
          }
          macro.yield %qb : i32
        } };
      }
    }
  }
  return;
}

// ------------------------------------------------------------------------------ experts ---

/// A dense product of the chunk: `pf_mm` with no bias and no `add`, or, for a Q4_0 matrix of whole
/// blocks of 64 rows, `pf_mm_q4_mlir64`, whose blocks of 64 tokens decode each weight for 64 tokens
/// in place of 32. `new_prefill35` makes the tensors of the chunk for whole blocks of 64 tokens.
pkg fn pf35_mm(y : &mut Tensor<f32, [?, ?], Memory::HBM>, m : &WeightMatrix, x : &Tensor<f32, [?, ?], Memory::HBM>, list : &Tensor<i32, [?], Memory::HBM>, zeros : &Tensor<i32, [?], Memory::HBM>, no_bias : &Tensor<bf16, [?], Memory::HBM>, rows : i32, cols : i32, tiles : i32) -> void {
  if m.dtype == U4 && rows % 64 == 0 {
    pf_mm_q4_mlir64(y, &m.codes, &m.group_scales, x, list, zeros, 0, rows, cols, tiles);
  } else {
    pf_mm(y, m, x, list, zeros, 0, no_bias, false, false, rows, cols, tiles);
  }
  return;
}

/// x[t] += sigmoid(router[t][at]) * out[t], for t below n: the shared expert times its gate.
fn pf35_add_shared(x : &mut Tensor<f32, [?, ?], Memory::HBM>, out : &Tensor<f32, [?, ?], Memory::HBM>, router : &Tensor<f32, [?, ?], Memory::HBM>, at : i32, n : i32, dim : i32) -> void {
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for b in 0..(dim + 255) / 256 across blocks {
        for l in 0..256 across lanes {
          let i = b * 256 + l;
          if i < dim {
            let g = 1.0 / (1.0 + (0.0 - router[t][at]).fast_exp());
            x[t][i] = x[t][i] + g * out[t][i];
          }
        }
      }
    }
  }
  return;
}

/// The experts and the shared expert of a layer, for the n tokens of the chunk: x += the experts of
/// each token, for the norm of x in xn, as `pf_experts`, and the shared expert times its gate.
pkg fn pf35_experts(p : &mut Prefill35, layer : &Qwen35Layer, c : &Config, n : i32, tiles : i32) -> void {
  let k = c.experts_per_token;
  let experts = c.num_experts;
  let inter = c.moe_intermediate_size;
  let shared = c.shared_expert_inter;
  // With Q4_0 experts, whose products round to f16, the router rounds to f16 too, in the faster
  // kernel. A bf16 file keeps the f32 products.
  if layer.gate_up.dtype == U4 {
    pf_mm_bf16_mlir(&mut p.router, &layer.router, &p.xn, &p.rows, &p.zeros, 0, experts + 1, c.hidden_size, tiles);
  } else {
    pf_mm_bf16(&mut p.router, &layer.router, &p.xn, &p.rows, &p.zeros, 0, &p.no_bias, false, false, experts + 1, c.hidden_size, tiles);
  }
  pf_top_k(&mut p.ids, &mut p.wts, &p.router, n, experts, k);
  let e_tiles = p.e_rows.len() / 16;
  pf_count_experts(&mut p.e_counts, &mut p.e_lane_counts, &p.ids, n, k, experts);
  pf_place_experts(&p.e_rows, &p.slot, &p.e_counts, &p.e_lane_counts, &p.ids, n, k, experts);
  pf_expert_bases(&mut p.e_bases, &p.e_counts, experts, e_tiles);
  pf_live_positions(&mut p.e_ident, &p.e_rows);
  pf_mm(&mut p.e_gu, &layer.gate_up, &p.xn, &p.e_rows, &p.e_bases, 2 * inter, &p.no_bias, false, false, 2 * inter, c.hidden_size, e_tiles);
  pf_silu_mul_live(&mut p.e_h, &p.e_gu, &p.e_ident, e_tiles * 16, inter);
  pf_mm(&mut p.e_out, &layer.down, &p.e_h, &p.e_ident, &p.e_bases, c.hidden_size, &p.no_bias, false, false, c.hidden_size, inter, e_tiles);
  pf_combine(&mut p.x, &p.e_out, &p.wts, &p.slot, n, k, c.hidden_size);
  pf35_mm(&mut p.s_gu, &layer.shared_gate_up, &p.xn, &p.rows, &p.zeros, &p.no_bias, 2 * shared, c.hidden_size, tiles);
  pf_silu_mul(&mut p.s_h, &p.s_gu, n, shared);
  pf35_mm(&mut p.s_out, &layer.shared_down, &p.s_h, &p.rows, &p.zeros, &p.no_bias, c.hidden_size, shared, tiles);
  pf35_add_shared(&mut p.x, &p.s_out, &p.router, experts, n, c.hidden_size);
  return;
}

// ------------------------------------------------------------------------------- chunk ---

/// Runs tokens start to start + n - 1 of the prompt, in `p.tokens`, through every layer. The state
/// of each layer is updated, and the hidden states go to p.x.
pkg fn pf35_chunk(w : &Qwen35Weights, s : &mut Qwen35State, p : &mut Prefill35, start : i32, n : i32) -> void {
  let c = &w.config;
  let eps = c.rms_norm_eps as f32;
  let tiles = (n + 15) / 16;
  let kh = c.linear_k_heads;
  let vh = c.linear_v_heads;
  let z_at = (2 * kh + vh) * 128;
  let b_at = z_at + vh * 128;
  let a_at = b_at + vh;
  let qkv_rows = (2 * c.num_q_heads + 2 * c.num_kv_heads) * 256;
  pf_embed(&mut p.x, &w.embed, &p.tokens, n, c.hidden_size);
  let mut l = 0;
  for ls in s.layers.iter_mut() {
    let layer = &w.layers[l];
    pf35_rms_norm(&mut p.xn, &p.x, &layer.attn_norm, n, c.hidden_size, eps);
    if layer.full_attention {
      pf35_mm(&mut p.proj, &layer.qkv, &p.xn, &p.rows, &p.zeros, &p.no_bias, qkv_rows, c.hidden_size, tiles);
      pf_gated_norm_rope_and_store(&mut p.q, &mut ls.k, &mut ls.v, &p.proj, &layer.q_norm, &layer.k_norm, &s.cos, &s.sin, start, n, c.num_q_heads, c.num_kv_heads, c.rotary_dim, eps);
      pf_gated_flash_attention(&mut p.y, &p.q, &ls.k, &ls.v, &p.proj, start, n, c.num_q_heads, c.num_q_heads / c.num_kv_heads, qkv_rows - c.num_q_heads * 256, 0.0625);
      // The product goes to xn, which is free until the norm, as in `pf_chunk`.
      pf35_mm(&mut p.xn, &layer.attn_out, &p.y, &p.rows, &p.zeros, &p.no_bias, c.hidden_size, c.num_q_heads * 256, tiles);
    } else {
      pf35_mm(&mut p.proj, &layer.linear_in, &p.xn, &p.rows, &p.zeros, &p.no_bias, a_at + vh, c.hidden_size, tiles);
      pf_dn_conv(&mut p.dq, &mut p.dk, &mut p.dv, &ls.conv, &p.proj, &layer.conv, n, kh, vh);
      pf_dn_conv_state(&mut ls.conv, &p.proj, n, 2 * kh + vh);
      pf_dn_gates(&mut p.beta, &mut p.decay, &p.proj, &layer.neg_a, &layer.dt_bias, b_at, a_at, n, vh);
      pf_dn_recur(&mut p.o, &mut ls.s, &p.dq, &p.dk, &p.dv, &p.beta, &p.decay, vh / kh, n, vh);
      pf_dn_gated_norm(&mut p.y, &p.o, &p.proj, &layer.linear_norm, z_at, n, vh, eps);
      pf35_mm(&mut p.xn, &layer.linear_out, &p.y, &p.rows, &p.zeros, &p.no_bias, c.hidden_size, vh * 128, tiles);
    }
    pf35_add_rms_norm(&mut p.x, &mut p.xn, &layer.mlp_norm, n, c.hidden_size, eps);
    pf35_experts(p, layer, c, n, tiles);
    l = l + 1;
  }
  return;
}

/// The chunk of `prefill_qwen35` for a prompt of `count` tokens: CHUNK, or fewer for a shorter
/// prompt.
pub fn prefill35_chunk(count : i32) -> i32 {
  return i32::min(CHUNK, (count + 15) / 16 * 16);
}

/// Runs the prompt through every layer, in chunks of up to CHUNK tokens, from position 0. The
/// hidden state of the last token is then in `s.x`, as after `run_qwen35_layers`, so
/// `predict_qwen35` gives the next token.
pub fn prefill_qwen35(w : &Qwen35Weights, s : &mut Qwen35State, prompt : &Vec<i32>) -> void {
  let mut p = new_prefill35(&w.config, prefill35_chunk(prompt.len()));
  prefill_qwen35_with(w, s, &mut p, prompt);
  return;
}

/// `prefill_qwen35` with the tensors of `p`, from `new_prefill35`, so that more prompts can use the
/// same tensors. Each chunk writes the parts of them that it reads.
pub fn prefill_qwen35_with(w : &Qwen35Weights, s : &mut Qwen35State, p : &mut Prefill35, prompt : &Vec<i32>) -> void {
  let c = &w.config;
  let count = prompt.len();
  assert(count > 0 && count <= s.max_seq, "prefill_qwen35: the prompt must have tokens and fit in the state");
  let chunk = p.tokens.len();
  let mut start = 0;
  let mut last = 0;
  while start < count {
    let n = i32::min(chunk, count - start);
    let mut ids = Tensor<i32>([chunk]);
    let mut rows = Tensor<i32>([p.rows.len()]);
    for t in 0..p.rows.len() {
      rows[t] = -1;
      if t < n {
        rows[t] = t;
      }
    }
    for t in 0..chunk {
      if t < n {
        ids[t] = prompt[start + t];
      } else {
        ids[t] = 0;
      }
    }
    p.tokens = transfer(ids, Memory::HBM);
    p.rows = transfer(rows, Memory::HBM);
    pf35_chunk(w, s, p, start, n);
    last = n;
    start = start + n;
  }
  pf_take_row(&mut s.x, &p.x, last - 1, c.hidden_size);
  return;
}
