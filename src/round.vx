              %scm1 = arith.select %live1, %sc1, %neg : f32
              %mm1 = arith.select %mine, %scm1, %m1 : f32
              %pr2 = arith.mulf %kf, %qs2 : vector<4xf32>
              %pl2 = vector.reduction <add>, %pr2 : vector<4xf32> into f32
              %sc2 = gpu.subgroup_reduce add %pl2 : (f32) -> f32
              %live2 = arith.cmpi ule, %row, %pos2 : index
              %scm2 = arith.select %live2, %sc2, %neg : f32
              %mm2 = arith.select %mine, %scm2, %m2 : f32
              %pr3 = arith.mulf %kf, %qs3 : vector<4xf32>
              %pl3 = vector.reduction <add>, %pr3 : vector<4xf32> into f32
              %sc3 = gpu.subgroup_reduce add %pl3 : (f32) -> f32
              %live3 = arith.cmpi ule, %row, %pos3 : index
              %scm3 = arith.select %live3, %sc3, %neg : f32
              %mm3 = arith.select %mine, %scm3, %m3 : f32
              %pr4 = arith.mulf %kf, %qs4 : vector<4xf32>
              %pl4 = vector.reduction <add>, %pr4 : vector<4xf32> into f32
              %sc4 = gpu.subgroup_reduce add %pl4 : (f32) -> f32
              %live4 = arith.cmpi ule, %row, %pos4 : index
              %scm4 = arith.select %live4, %sc4, %neg : f32
              %mm4 = arith.select %mine, %scm4, %m4 : f32
              %pr5 = arith.mulf %kf, %qs5 : vector<4xf32>
              %pl5 = vector.reduction <add>, %pr5 : vector<4xf32> into f32
              %sc5 = gpu.subgroup_reduce add %pl5 : (f32) -> f32
              %live5 = arith.cmpi ule, %row, %pos5 : index
              %scm5 = arith.select %live5, %sc5, %neg : f32
              %mm5 = arith.select %mine, %scm5, %m5 : f32
              %pr6 = arith.mulf %kf, %qs6 : vector<4xf32>
              %pl6 = vector.reduction <add>, %pr6 : vector<4xf32> into f32
              %sc6 = gpu.subgroup_reduce add %pl6 : (f32) -> f32
              %live6 = arith.cmpi ule, %row, %pos6 : index
              %scm6 = arith.select %live6, %sc6, %neg : f32
              %mm6 = arith.select %mine, %scm6, %m6 : f32
              %pr7 = arith.mulf %kf, %qs7 : vector<4xf32>
              %pl7 = vector.reduction <add>, %pr7 : vector<4xf32> into f32
              %sc7 = gpu.subgroup_reduce add %pl7 : (f32) -> f32
              %live7 = arith.cmpi ule, %row, %pos7 : index
              %scm7 = arith.select %live7, %sc7, %neg : f32
              %mm7 = arith.select %mine, %scm7, %m7 : f32
              scf.yield %mm0, %mm1, %mm2, %mm3, %mm4, %mm5, %mm6, %mm7 : f32, f32, f32, f32, f32, f32, f32, f32
            }
            %act0 = arith.cmpi ult, %ic, %chunks0 : index
            %u0:4 = scf.if %act0 -> (f32, f32, vector<4xf32>, f32) {
              %bm0 = gpu.subgroup_reduce maxnumf %my#0 : (f32) -> f32
              %Mn0 = arith.maxnumf %M0, %bm0 : f32
              %dm0 = arith.subf %M0, %Mn0 : f32
              %ms0 = math.exp %dm0 : f32
              %dp0 = arith.subf %my#0, %Mn0 : f32
              %p0 = math.exp %dp0 : f32
              %bs0 = gpu.subgroup_reduce add %p0 : (f32) -> f32
              %Ss0 = arith.mulf %S0, %ms0 : f32
              %Sn0 = arith.addf %Ss0, %bs0 : f32
              %msv0 = vector.broadcast %ms0 : f32 to vector<4xf32>
              %ox0 = arith.mulf %o0, %msv0 : vector<4xf32>
              scf.yield %Mn0, %Sn0, %ox0, %p0 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M0, %S0, %o0, %zero : f32, f32, vector<4xf32>, f32
            }
            %act1 = arith.cmpi ult, %ic, %chunks1 : index
            %u1:4 = scf.if %act1 -> (f32, f32, vector<4xf32>, f32) {
              %bm1 = gpu.subgroup_reduce maxnumf %my#1 : (f32) -> f32
              %Mn1 = arith.maxnumf %M1, %bm1 : f32
              %dm1 = arith.subf %M1, %Mn1 : f32
              %ms1 = math.exp %dm1 : f32
              %dp1 = arith.subf %my#1, %Mn1 : f32
              %p1 = math.exp %dp1 : f32
              %bs1 = gpu.subgroup_reduce add %p1 : (f32) -> f32
              %Ss1 = arith.mulf %S1, %ms1 : f32
              %Sn1 = arith.addf %Ss1, %bs1 : f32
              %msv1 = vector.broadcast %ms1 : f32 to vector<4xf32>
              %ox1 = arith.mulf %o1, %msv1 : vector<4xf32>
              scf.yield %Mn1, %Sn1, %ox1, %p1 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M1, %S1, %o1, %zero : f32, f32, vector<4xf32>, f32
            }
            %act2 = arith.cmpi ult, %ic, %chunks2 : index
            %u2:4 = scf.if %act2 -> (f32, f32, vector<4xf32>, f32) {
              %bm2 = gpu.subgroup_reduce maxnumf %my#2 : (f32) -> f32
              %Mn2 = arith.maxnumf %M2, %bm2 : f32
              %dm2 = arith.subf %M2, %Mn2 : f32
              %ms2 = math.exp %dm2 : f32
              %dp2 = arith.subf %my#2, %Mn2 : f32
              %p2 = math.exp %dp2 : f32
              %bs2 = gpu.subgroup_reduce add %p2 : (f32) -> f32
              %Ss2 = arith.mulf %S2, %ms2 : f32
              %Sn2 = arith.addf %Ss2, %bs2 : f32
              %msv2 = vector.broadcast %ms2 : f32 to vector<4xf32>
              %ox2 = arith.mulf %o2, %msv2 : vector<4xf32>
              scf.yield %Mn2, %Sn2, %ox2, %p2 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M2, %S2, %o2, %zero : f32, f32, vector<4xf32>, f32
            }
            %act3 = arith.cmpi ult, %ic, %chunks3 : index
            %u3:4 = scf.if %act3 -> (f32, f32, vector<4xf32>, f32) {
              %bm3 = gpu.subgroup_reduce maxnumf %my#3 : (f32) -> f32
              %Mn3 = arith.maxnumf %M3, %bm3 : f32
              %dm3 = arith.subf %M3, %Mn3 : f32
              %ms3 = math.exp %dm3 : f32
              %dp3 = arith.subf %my#3, %Mn3 : f32
              %p3 = math.exp %dp3 : f32
              %bs3 = gpu.subgroup_reduce add %p3 : (f32) -> f32
              %Ss3 = arith.mulf %S3, %ms3 : f32
              %Sn3 = arith.addf %Ss3, %bs3 : f32
              %msv3 = vector.broadcast %ms3 : f32 to vector<4xf32>
              %ox3 = arith.mulf %o3, %msv3 : vector<4xf32>
              scf.yield %Mn3, %Sn3, %ox3, %p3 : f32, f32, vector<4xf32>, f32
            } else {
