          %qv7 = vector.load %q[%qt7, %hi, %l4] {alignment = 16} : memref<?x?x?xf32>, vector<4xf32>
          %qs7 = arith.mulf %qv7, %scv : vector<4xf32>
          %st:24 = scf.for %ic = %wi to %chunks7 step %nwgi iter_args(%M0 = %neg, %S0 = %zero, %o0 = %vz4, %M1 = %neg, %S1 = %zero, %o1 = %vz4, %M2 = %neg, %S2 = %zero, %o2 = %vz4, %M3 = %neg, %S3 = %zero, %o3 = %vz4, %M4 = %neg, %S4 = %zero, %o4 = %vz4, %M5 = %neg, %S5 = %zero, %o5 = %vz4, %M6 = %neg, %S6 = %zero, %o6 = %vz4, %M7 = %neg, %S7 = %zero, %o7 = %vz4) -> (f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>) {
            %r0 = arith.muli %ic, %c32 : index
            %my:8 = scf.for %cc = %c0 to %c32 step %c1 iter_args(%m0 = %neg, %m1 = %neg, %m2 = %neg, %m3 = %neg, %m4 = %neg, %m5 = %neg, %m6 = %neg, %m7 = %neg) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
              %row = arith.addi %r0, %cc : index
              %rowc = arith.minui %row, %pos7 : index
              %kh = vector.load %k[%rowc, %kd] {alignment = 8} : memref<?x?xf16, strided<[?, 1]>>, vector<4xf16>
              %kf = arith.extf %kh : vector<4xf16> to vector<4xf32>
              %mine = arith.cmpi eq, %cc, %l : index
              %pr0 = arith.mulf %kf, %qs0 : vector<4xf32>
              %pl0 = vector.reduction <add>, %pr0 : vector<4xf32> into f32
              %sc0 = gpu.subgroup_reduce add %pl0 : (f32) -> f32
              %live0 = arith.cmpi ule, %row, %pos0 : index
              %scm0 = arith.select %live0, %sc0, %neg : f32
              %mm0 = arith.select %mine, %scm0, %m0 : f32
              %pr1 = arith.mulf %kf, %qs1 : vector<4xf32>
              %pl1 = vector.reduction <add>, %pr1 : vector<4xf32> into f32
              %sc1 = gpu.subgroup_reduce add %pl1 : (f32) -> f32
