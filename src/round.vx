              %dp4 = arith.subf %my#4, %Mn4 : f32
              %p4 = math.exp %dp4 : f32
              %bs4 = gpu.subgroup_reduce add %p4 : (f32) -> f32
              %Ss4 = arith.mulf %S4, %ms4 : f32
              %Sn4 = arith.addf %Ss4, %bs4 : f32
              %msv4 = vector.broadcast %ms4 : f32 to vector<4xf32>
              %ox4 = arith.mulf %o4, %msv4 : vector<4xf32>
              scf.yield %Mn4, %Sn4, %ox4, %p4 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M4, %S4, %o4, %zero : f32, f32, vector<4xf32>, f32
            }
            %act5 = arith.cmpi ult, %ic, %chunks5 : index
            %u5:4 = scf.if %act5 -> (f32, f32, vector<4xf32>, f32) {
              %bm5 = gpu.subgroup_reduce maxnumf %my#5 : (f32) -> f32
              %Mn5 = arith.maxnumf %M5, %bm5 : f32
              %dm5 = arith.subf %M5, %Mn5 : f32
              %ms5 = math.exp %dm5 : f32
              %dp5 = arith.subf %my#5, %Mn5 : f32
              %p5 = math.exp %dp5 : f32
              %bs5 = gpu.subgroup_reduce add %p5 : (f32) -> f32
              %Ss5 = arith.mulf %S5, %ms5 : f32
              %Sn5 = arith.addf %Ss5, %bs5 : f32
              %msv5 = vector.broadcast %ms5 : f32 to vector<4xf32>
              %ox5 = arith.mulf %o5, %msv5 : vector<4xf32>
              scf.yield %Mn5, %Sn5, %ox5, %p5 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M5, %S5, %o5, %zero : f32, f32, vector<4xf32>, f32
            }
            %act6 = arith.cmpi ult, %ic, %chunks6 : index
            %u6:4 = scf.if %act6 -> (f32, f32, vector<4xf32>, f32) {
              %bm6 = gpu.subgroup_reduce maxnumf %my#6 : (f32) -> f32
              %Mn6 = arith.maxnumf %M6, %bm6 : f32
              %dm6 = arith.subf %M6, %Mn6 : f32
              %ms6 = math.exp %dm6 : f32
              %dp6 = arith.subf %my#6, %Mn6 : f32
              %p6 = math.exp %dp6 : f32
              %bs6 = gpu.subgroup_reduce add %p6 : (f32) -> f32
              %Ss6 = arith.mulf %S6, %ms6 : f32
              %Sn6 = arith.addf %Ss6, %bs6 : f32
              %msv6 = vector.broadcast %ms6 : f32 to vector<4xf32>
              %ox6 = arith.mulf %o6, %msv6 : vector<4xf32>
              scf.yield %Mn6, %Sn6, %ox6, %p6 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M6, %S6, %o6, %zero : f32, f32, vector<4xf32>, f32
            }
            %act7 = arith.cmpi ult, %ic, %chunks7 : index
            %u7:4 = scf.if %act7 -> (f32, f32, vector<4xf32>, f32) {
              %bm7 = gpu.subgroup_reduce maxnumf %my#7 : (f32) -> f32
              %Mn7 = arith.maxnumf %M7, %bm7 : f32
              %dm7 = arith.subf %M7, %Mn7 : f32
              %ms7 = math.exp %dm7 : f32
              %dp7 = arith.subf %my#7, %Mn7 : f32
              %p7 = math.exp %dp7 : f32
              %bs7 = gpu.subgroup_reduce add %p7 : (f32) -> f32
              %Ss7 = arith.mulf %S7, %ms7 : f32
              %Sn7 = arith.addf %Ss7, %bs7 : f32
              %msv7 = vector.broadcast %ms7 : f32 to vector<4xf32>
              %ox7 = arith.mulf %o7, %msv7 : vector<4xf32>
              scf.yield %Mn7, %Sn7, %ox7, %p7 : f32, f32, vector<4xf32>, f32
            } else {
              scf.yield %M7, %S7, %o7, %zero : f32, f32, vector<4xf32>, f32
            }
            %ov:8 = scf.for %cc = %c0 to %c32 step %c1 iter_args(%oa0 = %u0#2, %oa1 = %u1#2, %oa2 = %u2#2, %oa3 = %u3#2, %oa4 = %u4#2, %oa5 = %u5#2, %oa6 = %u6#2, %oa7 = %u7#2) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
              %row = arith.addi %r0, %cc : index
              %rowc = arith.minui %row, %pos7 : index
              %vh = vector.load %v[%rowc, %kd] {alignment = 8} : memref<?x?xf16, strided<[?, 1]>>, vector<4xf16>
              %vf = arith.extf %vh : vector<4xf16> to vector<4xf32>
              %cci = arith.index_cast %cc : index to i32
              %pc0, %pv0 = gpu.shuffle idx %u0#3, %cci, %c32i : f32
              %pcv0 = vector.broadcast %pc0 : f32 to vector<4xf32>
              %on0 = vector.fma %vf, %pcv0, %oa0 : vector<4xf32>
              %pc1, %pv1 = gpu.shuffle idx %u1#3, %cci, %c32i : f32
              %pcv1 = vector.broadcast %pc1 : f32 to vector<4xf32>
              %on1 = vector.fma %vf, %pcv1, %oa1 : vector<4xf32>
              %pc2, %pv2 = gpu.shuffle idx %u2#3, %cci, %c32i : f32
              %pcv2 = vector.broadcast %pc2 : f32 to vector<4xf32>
              %on2 = vector.fma %vf, %pcv2, %oa2 : vector<4xf32>
              %pc3, %pv3 = gpu.shuffle idx %u3#3, %cci, %c32i : f32
              %pcv3 = vector.broadcast %pc3 : f32 to vector<4xf32>
              %on3 = vector.fma %vf, %pcv3, %oa3 : vector<4xf32>
              %pc4, %pv4 = gpu.shuffle idx %u4#3, %cci, %c32i : f32
              %pcv4 = vector.broadcast %pc4 : f32 to vector<4xf32>
              %on4 = vector.fma %vf, %pcv4, %oa4 : vector<4xf32>
              %pc5, %pv5 = gpu.shuffle idx %u5#3, %cci, %c32i : f32
              %pcv5 = vector.broadcast %pc5 : f32 to vector<4xf32>
              %on5 = vector.fma %vf, %pcv5, %oa5 : vector<4xf32>
              %pc6, %pv6 = gpu.shuffle idx %u6#3, %cci, %c32i : f32
              %pcv6 = vector.broadcast %pc6 : f32 to vector<4xf32>
              %on6 = vector.fma %vf, %pcv6, %oa6 : vector<4xf32>
              %pc7, %pv7 = gpu.shuffle idx %u7#3, %cci, %c32i : f32
              %pcv7 = vector.broadcast %pc7 : f32 to vector<4xf32>
              %on7 = vector.fma %vf, %pcv7, %oa7 : vector<4xf32>
              scf.yield %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
            }
            scf.yield %u0#0, %u0#1, %ov#0, %u1#0, %u1#1, %ov#1, %u2#0, %u2#1, %ov#2, %u3#0, %u3#1, %ov#3, %u4#0, %u4#1, %ov#4, %u5#0, %u5#1, %ov#5, %u6#0, %u6#1, %ov#6, %u7#0, %u7#1, %ov#7 : f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>, f32, f32, vector<4xf32>
          }
          %lane0 = arith.cmpi eq, %l, %c0 : index
          %base0 = arith.muli %qt0, %c132 : index
          %at0 = arith.addi %base0, %l4 : index
          vector.store %st#2, %part[%hi, %wi, %at0] : memref<?x?x?xf32>, vector<4xf32>
          %am0 = arith.addi %base0, %c128 : index
          %as0 = arith.addi %base0, %c129 : index
          scf.if %lane0 {
            memref.store %st#0, %part[%hi, %wi, %am0] : memref<?x?x?xf32>
            memref.store %st#1, %part[%hi, %wi, %as0] : memref<?x?x?xf32>
          }
          %base1 = arith.muli %qt1, %c132 : index
          %at1 = arith.addi %base1, %l4 : index
          vector.store %st#5, %part[%hi, %wi, %at1] : memref<?x?x?xf32>, vector<4xf32>
          %am1 = arith.addi %base1, %c128 : index
          %as1 = arith.addi %base1, %c129 : index
          scf.if %lane0 {
            memref.store %st#3, %part[%hi, %wi, %am1] : memref<?x?x?xf32>
            memref.store %st#4, %part[%hi, %wi, %as1] : memref<?x?x?xf32>
          }
          %base2 = arith.muli %qt2, %c132 : index
          %at2 = arith.addi %base2, %l4 : index
          vector.store %st#8, %part[%hi, %wi, %at2] : memref<?x?x?xf32>, vector<4xf32>
          %am2 = arith.addi %base2, %c128 : index
          %as2 = arith.addi %base2, %c129 : index
          scf.if %lane0 {
            memref.store %st#6, %part[%hi, %wi, %am2] : memref<?x?x?xf32>
            memref.store %st#7, %part[%hi, %wi, %as2] : memref<?x?x?xf32>
          }
          %base3 = arith.muli %qt3, %c132 : index
          %at3 = arith.addi %base3, %l4 : index
          vector.store %st#11, %part[%hi, %wi, %at3] : memref<?x?x?xf32>, vector<4xf32>
          %am3 = arith.addi %base3, %c128 : index
          %as3 = arith.addi %base3, %c129 : index
          scf.if %lane0 {
            memref.store %st#9, %part[%hi, %wi, %am3] : memref<?x?x?xf32>
            memref.store %st#10, %part[%hi, %wi, %as3] : memref<?x?x?xf32>
          }
          %base4 = arith.muli %qt4, %c132 : index
          %at4 = arith.addi %base4, %l4 : index
          vector.store %st#14, %part[%hi, %wi, %at4] : memref<?x?x?xf32>, vector<4xf32>
          %am4 = arith.addi %base4, %c128 : index
          %as4 = arith.addi %base4, %c129 : index
          scf.if %lane0 {
            memref.store %st#12, %part[%hi, %wi, %am4] : memref<?x?x?xf32>
            memref.store %st#13, %part[%hi, %wi, %as4] : memref<?x?x?xf32>
          }
          %base5 = arith.muli %qt5, %c132 : index
          %at5 = arith.addi %base5, %l4 : index
          vector.store %st#17, %part[%hi, %wi, %at5] : memref<?x?x?xf32>, vector<4xf32>
          %am5 = arith.addi %base5, %c128 : index
          %as5 = arith.addi %base5, %c129 : index
          scf.if %lane0 {
            memref.store %st#15, %part[%hi, %wi, %am5] : memref<?x?x?xf32>
            memref.store %st#16, %part[%hi, %wi, %as5] : memref<?x?x?xf32>
          }
          %base6 = arith.muli %qt6, %c132 : index
          %at6 = arith.addi %base6, %l4 : index
          vector.store %st#20, %part[%hi, %wi, %at6] : memref<?x?x?xf32>, vector<4xf32>
          %am6 = arith.addi %base6, %c128 : index
          %as6 = arith.addi %base6, %c129 : index
          scf.if %lane0 {
            memref.store %st#18, %part[%hi, %wi, %am6] : memref<?x?x?xf32>
            memref.store %st#19, %part[%hi, %wi, %as6] : memref<?x?x?xf32>
          }
          %base7 = arith.muli %qt7, %c132 : index
          %at7 = arith.addi %base7, %l4 : index
          vector.store %st#23, %part[%hi, %wi, %at7] : memref<?x?x?xf32>, vector<4xf32>
          %am7 = arith.addi %base7, %c128 : index
          %as7 = arith.addi %base7, %c129 : index
          scf.if %lane0 {
            memref.store %st#21, %part[%hi, %wi, %am7] : memref<?x?x?xf32>
            memref.store %st#22, %part[%hi, %wi, %as7] : memref<?x?x?xf32>
          }
          macro.yield %h : i32
        };
      }
    }
  }
  return;
}

/// `vec_attention_merge` for queries t0 to t0 + n - 1, whose parts are at part[h][w][132 t ..]: out[t][h]
/// gets the attention of head h of query t. The code is that of `vec_attention_merge`, with the parts of query
/// t at 132 t, so a query gives the same bits in both.
fn round_attention_merge(out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, part : &Tensor<f32, [?, ?, ?], Memory::HBM>, parts : i32, t0 : i32, n : i32, q_heads : i32) -> void {
  spawn on(Topology::Device) {
    for i in 0..n across blocks {
      for h in 0..q_heads across blocks {
        for dq in 0..4 across blocks {
          let t = t0 + i;
          let b = 132 * t;
          let mut top = unsafe {
            Tensor<f32, [1, 32], Memory::SMEM>::uninit()
          };
          for s in 0..1 across subgroups {
            for l in 0..32 across lanes(32) {
              let mut m : f32 = -3.0e38;
              let mut c = l;
              while c < parts {
                m = m.max(part[h][c][b + 128]);
                c = c + 32;
              }
              top[s][l] = m;
            }
            let big = lanes::max(&top[s], 32);
            for l in 0..32 across lanes(32) {
              let d = dq * 32 + l;
              let mut total : f32 = 0.0;
              let mut acc : f32 = 0.0;
              for c in 0..parts {
                let w = (part[h][c][b + 128] - big).fast_exp();
                total = total + w * part[h][c][b + 129];
                acc = acc + w * part[h][c][b + d];
              }
              out[t][h][d] = acc / total;
            }
          }
        }
      }
    }
  }
  return;
}
