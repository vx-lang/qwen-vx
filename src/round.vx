            }
            %act4 = arith.cmpi ult, %ic, %chunks4 : index
            %u4:4 = scf.if %act4 -> (f32, f32, vector<4xf32>, f32) {
              %bm4 = gpu.subgroup_reduce maxnumf %my#4 : (f32) -> f32
              %Mn4 = arith.maxnumf %M4, %bm4 : f32
              %dm4 = arith.subf %M4, %Mn4 : f32
