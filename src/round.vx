//===----------------------------------------------------------------------===//
// The kernels of a round: n positions in a row, start to start + n - 1, with one read of the
// weights. Each position gets the result of the kernel of a generated token bit for bit, so that a
// round gives the tokens that plain decoding gives. Tensors of a round have the position first:
// q of [n, q_heads, head_dim].
//
// scripts/round_attention.py writes the kernels of `round_attention`, one for each number of queries:
// change that script, not the kernels.
import core::num;
import std::nn;
import qwen::attention;

/// The largest n of a round.
const ROUND_MAX : i32 = 16;

/// The number of SIMD groups of `vec_attention` for each head of Q, for the token at `pos`.
fn vec_attention_groups(pos : i32) -> i32 {
  let mut nwg = 32;
  if 2 * nwg * 32 < pos + 1 {
    nwg = nwg * 2;
  }
  return nwg;
}

/// The scratch space of `round_attention`, on the CPU.
fn round_attention_scratch(q_heads : i32) -> Tensor<f32, [?, ?, ?]> {
  return Tensor<f32>([q_heads, 128, ROUND_MAX * 132]);
}

/// `vec_attention` for the n queries in q, for the tokens at positions start to start + n - 1:
/// out[t] gets the attention of the token at start + t, over rows 0 to start + t of the KV cache.
/// The rows of all n tokens must be in the cache. `part` is scratch space from
/// `round_attention_scratch`. Up to 4 queries that use the same number of SIMD groups share one
/// kernel: for 8 queries, pieces of 4 are about 20% faster than one kernel at position 2,000, and 7%
/// at 8,000, since each query costs the same work in a kernel for more queries.
fn round_attention(out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32) -> void {
  assert(n >= 1 && n <= ROUND_MAX && q.extent(0) >= n && out.extent(0) >= n, "round_attention: n must be 1 to ROUND_MAX, and q and out need n rows");
  nn_check_heads(q.extent(1), q.extent(2), q_heads, head_dim);
  nn_check_heads(out.extent(1), out.extent(2), q_heads, head_dim);
  nn_check_cache(k_cache.extent(0), k_cache.extent(1), k_cache.extent(2), start + n - 1, kv_heads, head_dim);
  nn_check_cache(v_cache.extent(0), v_cache.extent(1), v_cache.extent(2), start + n - 1, kv_heads, head_dim);
  assert(q_heads % kv_heads == 0 && head_dim == 128, "round_attention: q_heads must be a multiple of kv_heads, and head_dim 128");
  assert(part.extent(0) >= q_heads && part.extent(1) >= 128 && part.extent(2) == ROUND_MAX * 132, "round_attention: `part` is too small. Make it with round_attention_scratch");
  let scale = 1.0 / (head_dim as f32).sqrt();
  let mut t0 = 0;
  while t0 < n {
    let nwg = vec_attention_groups(start + t0);
    let mut t1 = t0 + 1;
    while t1 < n && t1 - t0 < 4 && vec_attention_groups(start + t1) == nwg {
      t1 = t1 + 1;
    }
    round_attention_parts(part, q, k_cache, v_cache, start + t0, t0, t1 - t0, q_heads, q_heads / kv_heads, nwg, scale);
    round_attention_merge(out, part, nwg, t0, t1 - t0, q_heads);
    t0 = t1;
  }
  return;
}

/// `norm_rope_and_store` of src/attention.vx for n tokens at positions start to start + n - 1: q,
/// k and v are [n, heads, head_dim], and q_out gets [n, q_heads, head_dim].
fn round_norm_rope_and_store(q_out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &mut Tensor<f16, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k : &Tensor<f32, [?, ?, ?], Memory::HBM>, v : &Tensor<f32, [?, ?, ?], Memory::HBM>, q_norm : &Tensor<bf16, [?], Memory::HBM>, k_norm : &Tensor<bf16, [?], Memory::HBM>, cos : &Tensor<f32, [?, ?], Memory::HBM>, sin : &Tensor<f32, [?, ?], Memory::HBM>, start : i32, n : i32, q_heads : i32, kv_heads : i32, head_dim : i32, eps : f32) -> void {
  let half = head_dim / 2;
  assert(n >= 1 && q.extent(0) >= n && k.extent(0) >= n && v.extent(0) >= n && q_out.extent(0) >= n, "round_norm_rope_and_store: q, k, v and q_out need n rows");
  nn_check_heads(q.extent(1), q.extent(2), q_heads, head_dim);
  nn_check_heads(q_out.extent(1), q_out.extent(2), q_heads, head_dim);
  nn_check_heads(k.extent(1), k.extent(2), kv_heads, head_dim);
  nn_check_heads(v.extent(1), v.extent(2), kv_heads, head_dim);
  nn_check_cache(k_cache.extent(0), k_cache.extent(1), k_cache.extent(2), start + n - 1, kv_heads, head_dim);
  nn_check_cache(v_cache.extent(0), v_cache.extent(1), v_cache.extent(2), start + n - 1, kv_heads, head_dim);
  assert(head_dim <= 128 && q_norm.len() >= head_dim && k_norm.len() >= head_dim, "round_norm_rope_and_store: head_dim must be at most 128, and `q_norm` and `k_norm` need head_dim values");
  assert(start + n - 1 < cos.extent(0) && start + n - 1 < sin.extent(0) && half <= cos.extent(1) && half <= sin.extent(1), "round_norm_rope_and_store: `cos` and `sin` need a row for each position with head_dim / 2 values");
  spawn on(Topology::Device) {
    for t in 0..n across blocks {
      for h in 0..q_heads + kv_heads across blocks {
        let pos = start + t;
        let mut x = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        for i in 0..128 across lanes {
          let mut a : f32 = 0.0;
          if i < head_dim {
            if h < q_heads {
              a = q[t][h][i];
            } else {
              a = k[t][h - q_heads][i];
            }
          }
          x[i] = a;
          part[i] = a * a;
        }
        let ss = lanes::sum(&part, 128);
        let inv = 1.0 / (ss / (head_dim as f32) + eps).sqrt();
        for i in 0..128 across lanes {
          if i < head_dim {
            // Value i of the head, its partner, and the angle that they share.
            let mut j = i;
            let mut sign : f32 = -1.0;
            let mut partner = i + half;
            if i >= half {
              j = i - half;
              sign = 1.0;
              partner = i - half;
            }
            let c = cos[pos][j];
            let s = sin[pos][j];
            if h < q_heads {
              let a = x[i] * inv * (q_norm[i] as f32);
              let b = x[partner] * inv * (q_norm[partner] as f32);
              q_out[t][h][i] = a * c + sign * b * s;
            } else {
              let a = x[i] * inv * (k_norm[i] as f32);
              let b = x[partner] * inv * (k_norm[partner] as f32);
              k_cache[pos][h - q_heads][i] = (a * c + sign * b * s) as f16;
              v_cache[pos][h - q_heads][i] = v[t][h - q_heads][i] as f16;
            }
          }
        }
      }
    }
  }
  return;
}

/// The parts of queries t0 to t0 + n - 1, with the kernel for n queries. n is 1 to 8.
fn round_attention_parts(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, n : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  assert(n >= 1 && n <= 8, "round_attention_parts: n must be 1 to 8");
  if n == 1 {
    round_attention_parts_1(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 2 {
    round_attention_parts_2(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 3 {
    round_attention_parts_3(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 4 {
    round_attention_parts_4(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 5 {
    round_attention_parts_5(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 6 {
    round_attention_parts_6(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else if n == 7 {
    round_attention_parts_7(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  } else {
    round_attention_parts_8(part, q, k_cache, v_cache, pos, t0, q_heads, group, nwg, scale);
  }
  return;
}

/// `vec_attention_parts` for 1 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_1(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 1, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 0;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 2 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_2(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 2, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 1;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 3 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_3(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 3, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 2;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 4 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_4(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 4, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 3;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let q3_0 = q[t0 + 3][h][d + 0] * scale;
            let q3_1 = q[t0 + 3][h][d + 1] * scale;
            let q3_2 = q[t0 + 3][h][d + 2] * scale;
            let q3_3 = q[t0 + 3][h][d + 3] * scale;
            let mut big3 : f32 = -3.0e38;
            let mut total3 : f32 = 0.0;
            let mut o3_0 : f32 = 0.0;
            let mut o3_1 : f32 = 0.0;
            let mut o3_2 : f32 = 0.0;
            let mut o3_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              let mut mine3 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                let mut score3 = lane_sum(k0 * q3_0 + k1 * q3_1 + k2 * q3_2 + k3 * q3_3);
                if row > pos + 3 {
                  score3 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                  mine3 = score3;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              let mut p3 : f32 = 0.0;
              if c < (pos + 3 + 32) / 32 {
                let top = big3.max(lane_max(mine3));
                let shrink = (big3 - top).fast_exp();
                p3 = (mine3 - top).fast_exp();
                total3 = total3 * shrink + lane_sum(p3);
                o3_0 = o3_0 * shrink;
                o3_1 = o3_1 * shrink;
                o3_2 = o3_2 * shrink;
                o3_3 = o3_3 * shrink;
                big3 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
                let pr3 = lane_value(p3, r);
                o3_0 = fused(half_at(v_cache, kept, g, d, 0), pr3, o3_0);
                o3_1 = fused(half_at(v_cache, kept, g, d, 1), pr3, o3_1);
                o3_2 = fused(half_at(v_cache, kept, g, d, 2), pr3, o3_2);
                o3_3 = fused(half_at(v_cache, kept, g, d, 3), pr3, o3_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            let b3 = 132 * (t0 + 3);
            part[h][w][b3 + d + 0] = o3_0;
            part[h][w][b3 + d + 1] = o3_1;
            part[h][w][b3 + d + 2] = o3_2;
            part[h][w][b3 + d + 3] = o3_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
              let mut x3 = big3;
              if l == 1 {
                x3 = total3;
              }
              stats[s][3][l] = x3;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
            part[h][w][132 * (t0 + 3) + 128 + l] = stats[s][3][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 5 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_5(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 5, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 4;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let q3_0 = q[t0 + 3][h][d + 0] * scale;
            let q3_1 = q[t0 + 3][h][d + 1] * scale;
            let q3_2 = q[t0 + 3][h][d + 2] * scale;
            let q3_3 = q[t0 + 3][h][d + 3] * scale;
            let mut big3 : f32 = -3.0e38;
            let mut total3 : f32 = 0.0;
            let mut o3_0 : f32 = 0.0;
            let mut o3_1 : f32 = 0.0;
            let mut o3_2 : f32 = 0.0;
            let mut o3_3 : f32 = 0.0;
            let q4_0 = q[t0 + 4][h][d + 0] * scale;
            let q4_1 = q[t0 + 4][h][d + 1] * scale;
            let q4_2 = q[t0 + 4][h][d + 2] * scale;
            let q4_3 = q[t0 + 4][h][d + 3] * scale;
            let mut big4 : f32 = -3.0e38;
            let mut total4 : f32 = 0.0;
            let mut o4_0 : f32 = 0.0;
            let mut o4_1 : f32 = 0.0;
            let mut o4_2 : f32 = 0.0;
            let mut o4_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              let mut mine3 : f32 = -3.0e38;
              let mut mine4 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                let mut score3 = lane_sum(k0 * q3_0 + k1 * q3_1 + k2 * q3_2 + k3 * q3_3);
                if row > pos + 3 {
                  score3 = -3.0e38;
                }
                let mut score4 = lane_sum(k0 * q4_0 + k1 * q4_1 + k2 * q4_2 + k3 * q4_3);
                if row > pos + 4 {
                  score4 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                  mine3 = score3;
                  mine4 = score4;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              let mut p3 : f32 = 0.0;
              if c < (pos + 3 + 32) / 32 {
                let top = big3.max(lane_max(mine3));
                let shrink = (big3 - top).fast_exp();
                p3 = (mine3 - top).fast_exp();
                total3 = total3 * shrink + lane_sum(p3);
                o3_0 = o3_0 * shrink;
                o3_1 = o3_1 * shrink;
                o3_2 = o3_2 * shrink;
                o3_3 = o3_3 * shrink;
                big3 = top;
              }
              let mut p4 : f32 = 0.0;
              if c < (pos + 4 + 32) / 32 {
                let top = big4.max(lane_max(mine4));
                let shrink = (big4 - top).fast_exp();
                p4 = (mine4 - top).fast_exp();
                total4 = total4 * shrink + lane_sum(p4);
                o4_0 = o4_0 * shrink;
                o4_1 = o4_1 * shrink;
                o4_2 = o4_2 * shrink;
                o4_3 = o4_3 * shrink;
                big4 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
                let pr3 = lane_value(p3, r);
                o3_0 = fused(half_at(v_cache, kept, g, d, 0), pr3, o3_0);
                o3_1 = fused(half_at(v_cache, kept, g, d, 1), pr3, o3_1);
                o3_2 = fused(half_at(v_cache, kept, g, d, 2), pr3, o3_2);
                o3_3 = fused(half_at(v_cache, kept, g, d, 3), pr3, o3_3);
                let pr4 = lane_value(p4, r);
                o4_0 = fused(half_at(v_cache, kept, g, d, 0), pr4, o4_0);
                o4_1 = fused(half_at(v_cache, kept, g, d, 1), pr4, o4_1);
                o4_2 = fused(half_at(v_cache, kept, g, d, 2), pr4, o4_2);
                o4_3 = fused(half_at(v_cache, kept, g, d, 3), pr4, o4_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            let b3 = 132 * (t0 + 3);
            part[h][w][b3 + d + 0] = o3_0;
            part[h][w][b3 + d + 1] = o3_1;
            part[h][w][b3 + d + 2] = o3_2;
            part[h][w][b3 + d + 3] = o3_3;
            let b4 = 132 * (t0 + 4);
            part[h][w][b4 + d + 0] = o4_0;
            part[h][w][b4 + d + 1] = o4_1;
            part[h][w][b4 + d + 2] = o4_2;
            part[h][w][b4 + d + 3] = o4_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
              let mut x3 = big3;
              if l == 1 {
                x3 = total3;
              }
              stats[s][3][l] = x3;
              let mut x4 = big4;
              if l == 1 {
                x4 = total4;
              }
              stats[s][4][l] = x4;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
            part[h][w][132 * (t0 + 3) + 128 + l] = stats[s][3][l];
            part[h][w][132 * (t0 + 4) + 128 + l] = stats[s][4][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 6 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_6(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 6, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 5;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let q3_0 = q[t0 + 3][h][d + 0] * scale;
            let q3_1 = q[t0 + 3][h][d + 1] * scale;
            let q3_2 = q[t0 + 3][h][d + 2] * scale;
            let q3_3 = q[t0 + 3][h][d + 3] * scale;
            let mut big3 : f32 = -3.0e38;
            let mut total3 : f32 = 0.0;
            let mut o3_0 : f32 = 0.0;
            let mut o3_1 : f32 = 0.0;
            let mut o3_2 : f32 = 0.0;
            let mut o3_3 : f32 = 0.0;
            let q4_0 = q[t0 + 4][h][d + 0] * scale;
            let q4_1 = q[t0 + 4][h][d + 1] * scale;
            let q4_2 = q[t0 + 4][h][d + 2] * scale;
            let q4_3 = q[t0 + 4][h][d + 3] * scale;
            let mut big4 : f32 = -3.0e38;
            let mut total4 : f32 = 0.0;
            let mut o4_0 : f32 = 0.0;
            let mut o4_1 : f32 = 0.0;
            let mut o4_2 : f32 = 0.0;
            let mut o4_3 : f32 = 0.0;
            let q5_0 = q[t0 + 5][h][d + 0] * scale;
            let q5_1 = q[t0 + 5][h][d + 1] * scale;
            let q5_2 = q[t0 + 5][h][d + 2] * scale;
            let q5_3 = q[t0 + 5][h][d + 3] * scale;
            let mut big5 : f32 = -3.0e38;
            let mut total5 : f32 = 0.0;
            let mut o5_0 : f32 = 0.0;
            let mut o5_1 : f32 = 0.0;
            let mut o5_2 : f32 = 0.0;
            let mut o5_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              let mut mine3 : f32 = -3.0e38;
              let mut mine4 : f32 = -3.0e38;
              let mut mine5 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                let mut score3 = lane_sum(k0 * q3_0 + k1 * q3_1 + k2 * q3_2 + k3 * q3_3);
                if row > pos + 3 {
                  score3 = -3.0e38;
                }
                let mut score4 = lane_sum(k0 * q4_0 + k1 * q4_1 + k2 * q4_2 + k3 * q4_3);
                if row > pos + 4 {
                  score4 = -3.0e38;
                }
                let mut score5 = lane_sum(k0 * q5_0 + k1 * q5_1 + k2 * q5_2 + k3 * q5_3);
                if row > pos + 5 {
                  score5 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                  mine3 = score3;
                  mine4 = score4;
                  mine5 = score5;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              let mut p3 : f32 = 0.0;
              if c < (pos + 3 + 32) / 32 {
                let top = big3.max(lane_max(mine3));
                let shrink = (big3 - top).fast_exp();
                p3 = (mine3 - top).fast_exp();
                total3 = total3 * shrink + lane_sum(p3);
                o3_0 = o3_0 * shrink;
                o3_1 = o3_1 * shrink;
                o3_2 = o3_2 * shrink;
                o3_3 = o3_3 * shrink;
                big3 = top;
              }
              let mut p4 : f32 = 0.0;
              if c < (pos + 4 + 32) / 32 {
                let top = big4.max(lane_max(mine4));
                let shrink = (big4 - top).fast_exp();
                p4 = (mine4 - top).fast_exp();
                total4 = total4 * shrink + lane_sum(p4);
                o4_0 = o4_0 * shrink;
                o4_1 = o4_1 * shrink;
                o4_2 = o4_2 * shrink;
                o4_3 = o4_3 * shrink;
                big4 = top;
              }
              let mut p5 : f32 = 0.0;
              if c < (pos + 5 + 32) / 32 {
                let top = big5.max(lane_max(mine5));
                let shrink = (big5 - top).fast_exp();
                p5 = (mine5 - top).fast_exp();
                total5 = total5 * shrink + lane_sum(p5);
                o5_0 = o5_0 * shrink;
                o5_1 = o5_1 * shrink;
                o5_2 = o5_2 * shrink;
                o5_3 = o5_3 * shrink;
                big5 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
                let pr3 = lane_value(p3, r);
                o3_0 = fused(half_at(v_cache, kept, g, d, 0), pr3, o3_0);
                o3_1 = fused(half_at(v_cache, kept, g, d, 1), pr3, o3_1);
                o3_2 = fused(half_at(v_cache, kept, g, d, 2), pr3, o3_2);
                o3_3 = fused(half_at(v_cache, kept, g, d, 3), pr3, o3_3);
                let pr4 = lane_value(p4, r);
                o4_0 = fused(half_at(v_cache, kept, g, d, 0), pr4, o4_0);
                o4_1 = fused(half_at(v_cache, kept, g, d, 1), pr4, o4_1);
                o4_2 = fused(half_at(v_cache, kept, g, d, 2), pr4, o4_2);
                o4_3 = fused(half_at(v_cache, kept, g, d, 3), pr4, o4_3);
                let pr5 = lane_value(p5, r);
                o5_0 = fused(half_at(v_cache, kept, g, d, 0), pr5, o5_0);
                o5_1 = fused(half_at(v_cache, kept, g, d, 1), pr5, o5_1);
                o5_2 = fused(half_at(v_cache, kept, g, d, 2), pr5, o5_2);
                o5_3 = fused(half_at(v_cache, kept, g, d, 3), pr5, o5_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            let b3 = 132 * (t0 + 3);
            part[h][w][b3 + d + 0] = o3_0;
            part[h][w][b3 + d + 1] = o3_1;
            part[h][w][b3 + d + 2] = o3_2;
            part[h][w][b3 + d + 3] = o3_3;
            let b4 = 132 * (t0 + 4);
            part[h][w][b4 + d + 0] = o4_0;
            part[h][w][b4 + d + 1] = o4_1;
            part[h][w][b4 + d + 2] = o4_2;
            part[h][w][b4 + d + 3] = o4_3;
            let b5 = 132 * (t0 + 5);
            part[h][w][b5 + d + 0] = o5_0;
            part[h][w][b5 + d + 1] = o5_1;
            part[h][w][b5 + d + 2] = o5_2;
            part[h][w][b5 + d + 3] = o5_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
              let mut x3 = big3;
              if l == 1 {
                x3 = total3;
              }
              stats[s][3][l] = x3;
              let mut x4 = big4;
              if l == 1 {
                x4 = total4;
              }
              stats[s][4][l] = x4;
              let mut x5 = big5;
              if l == 1 {
                x5 = total5;
              }
              stats[s][5][l] = x5;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
            part[h][w][132 * (t0 + 3) + 128 + l] = stats[s][3][l];
            part[h][w][132 * (t0 + 4) + 128 + l] = stats[s][4][l];
            part[h][w][132 * (t0 + 5) + 128 + l] = stats[s][5][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 7 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_7(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 7, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 6;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let q3_0 = q[t0 + 3][h][d + 0] * scale;
            let q3_1 = q[t0 + 3][h][d + 1] * scale;
            let q3_2 = q[t0 + 3][h][d + 2] * scale;
            let q3_3 = q[t0 + 3][h][d + 3] * scale;
            let mut big3 : f32 = -3.0e38;
            let mut total3 : f32 = 0.0;
            let mut o3_0 : f32 = 0.0;
            let mut o3_1 : f32 = 0.0;
            let mut o3_2 : f32 = 0.0;
            let mut o3_3 : f32 = 0.0;
            let q4_0 = q[t0 + 4][h][d + 0] * scale;
            let q4_1 = q[t0 + 4][h][d + 1] * scale;
            let q4_2 = q[t0 + 4][h][d + 2] * scale;
            let q4_3 = q[t0 + 4][h][d + 3] * scale;
            let mut big4 : f32 = -3.0e38;
            let mut total4 : f32 = 0.0;
            let mut o4_0 : f32 = 0.0;
            let mut o4_1 : f32 = 0.0;
            let mut o4_2 : f32 = 0.0;
            let mut o4_3 : f32 = 0.0;
            let q5_0 = q[t0 + 5][h][d + 0] * scale;
            let q5_1 = q[t0 + 5][h][d + 1] * scale;
            let q5_2 = q[t0 + 5][h][d + 2] * scale;
            let q5_3 = q[t0 + 5][h][d + 3] * scale;
            let mut big5 : f32 = -3.0e38;
            let mut total5 : f32 = 0.0;
            let mut o5_0 : f32 = 0.0;
            let mut o5_1 : f32 = 0.0;
            let mut o5_2 : f32 = 0.0;
            let mut o5_3 : f32 = 0.0;
            let q6_0 = q[t0 + 6][h][d + 0] * scale;
            let q6_1 = q[t0 + 6][h][d + 1] * scale;
            let q6_2 = q[t0 + 6][h][d + 2] * scale;
            let q6_3 = q[t0 + 6][h][d + 3] * scale;
            let mut big6 : f32 = -3.0e38;
            let mut total6 : f32 = 0.0;
            let mut o6_0 : f32 = 0.0;
            let mut o6_1 : f32 = 0.0;
            let mut o6_2 : f32 = 0.0;
            let mut o6_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              let mut mine3 : f32 = -3.0e38;
              let mut mine4 : f32 = -3.0e38;
              let mut mine5 : f32 = -3.0e38;
              let mut mine6 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                let mut score3 = lane_sum(k0 * q3_0 + k1 * q3_1 + k2 * q3_2 + k3 * q3_3);
                if row > pos + 3 {
                  score3 = -3.0e38;
                }
                let mut score4 = lane_sum(k0 * q4_0 + k1 * q4_1 + k2 * q4_2 + k3 * q4_3);
                if row > pos + 4 {
                  score4 = -3.0e38;
                }
                let mut score5 = lane_sum(k0 * q5_0 + k1 * q5_1 + k2 * q5_2 + k3 * q5_3);
                if row > pos + 5 {
                  score5 = -3.0e38;
                }
                let mut score6 = lane_sum(k0 * q6_0 + k1 * q6_1 + k2 * q6_2 + k3 * q6_3);
                if row > pos + 6 {
                  score6 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                  mine3 = score3;
                  mine4 = score4;
                  mine5 = score5;
                  mine6 = score6;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              let mut p3 : f32 = 0.0;
              if c < (pos + 3 + 32) / 32 {
                let top = big3.max(lane_max(mine3));
                let shrink = (big3 - top).fast_exp();
                p3 = (mine3 - top).fast_exp();
                total3 = total3 * shrink + lane_sum(p3);
                o3_0 = o3_0 * shrink;
                o3_1 = o3_1 * shrink;
                o3_2 = o3_2 * shrink;
                o3_3 = o3_3 * shrink;
                big3 = top;
              }
              let mut p4 : f32 = 0.0;
              if c < (pos + 4 + 32) / 32 {
                let top = big4.max(lane_max(mine4));
                let shrink = (big4 - top).fast_exp();
                p4 = (mine4 - top).fast_exp();
                total4 = total4 * shrink + lane_sum(p4);
                o4_0 = o4_0 * shrink;
                o4_1 = o4_1 * shrink;
                o4_2 = o4_2 * shrink;
                o4_3 = o4_3 * shrink;
                big4 = top;
              }
              let mut p5 : f32 = 0.0;
              if c < (pos + 5 + 32) / 32 {
                let top = big5.max(lane_max(mine5));
                let shrink = (big5 - top).fast_exp();
                p5 = (mine5 - top).fast_exp();
                total5 = total5 * shrink + lane_sum(p5);
                o5_0 = o5_0 * shrink;
                o5_1 = o5_1 * shrink;
                o5_2 = o5_2 * shrink;
                o5_3 = o5_3 * shrink;
                big5 = top;
              }
              let mut p6 : f32 = 0.0;
              if c < (pos + 6 + 32) / 32 {
                let top = big6.max(lane_max(mine6));
                let shrink = (big6 - top).fast_exp();
                p6 = (mine6 - top).fast_exp();
                total6 = total6 * shrink + lane_sum(p6);
                o6_0 = o6_0 * shrink;
                o6_1 = o6_1 * shrink;
                o6_2 = o6_2 * shrink;
                o6_3 = o6_3 * shrink;
                big6 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
                let pr3 = lane_value(p3, r);
                o3_0 = fused(half_at(v_cache, kept, g, d, 0), pr3, o3_0);
                o3_1 = fused(half_at(v_cache, kept, g, d, 1), pr3, o3_1);
                o3_2 = fused(half_at(v_cache, kept, g, d, 2), pr3, o3_2);
                o3_3 = fused(half_at(v_cache, kept, g, d, 3), pr3, o3_3);
                let pr4 = lane_value(p4, r);
                o4_0 = fused(half_at(v_cache, kept, g, d, 0), pr4, o4_0);
                o4_1 = fused(half_at(v_cache, kept, g, d, 1), pr4, o4_1);
                o4_2 = fused(half_at(v_cache, kept, g, d, 2), pr4, o4_2);
                o4_3 = fused(half_at(v_cache, kept, g, d, 3), pr4, o4_3);
                let pr5 = lane_value(p5, r);
                o5_0 = fused(half_at(v_cache, kept, g, d, 0), pr5, o5_0);
                o5_1 = fused(half_at(v_cache, kept, g, d, 1), pr5, o5_1);
                o5_2 = fused(half_at(v_cache, kept, g, d, 2), pr5, o5_2);
                o5_3 = fused(half_at(v_cache, kept, g, d, 3), pr5, o5_3);
                let pr6 = lane_value(p6, r);
                o6_0 = fused(half_at(v_cache, kept, g, d, 0), pr6, o6_0);
                o6_1 = fused(half_at(v_cache, kept, g, d, 1), pr6, o6_1);
                o6_2 = fused(half_at(v_cache, kept, g, d, 2), pr6, o6_2);
                o6_3 = fused(half_at(v_cache, kept, g, d, 3), pr6, o6_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            let b3 = 132 * (t0 + 3);
            part[h][w][b3 + d + 0] = o3_0;
            part[h][w][b3 + d + 1] = o3_1;
            part[h][w][b3 + d + 2] = o3_2;
            part[h][w][b3 + d + 3] = o3_3;
            let b4 = 132 * (t0 + 4);
            part[h][w][b4 + d + 0] = o4_0;
            part[h][w][b4 + d + 1] = o4_1;
            part[h][w][b4 + d + 2] = o4_2;
            part[h][w][b4 + d + 3] = o4_3;
            let b5 = 132 * (t0 + 5);
            part[h][w][b5 + d + 0] = o5_0;
            part[h][w][b5 + d + 1] = o5_1;
            part[h][w][b5 + d + 2] = o5_2;
            part[h][w][b5 + d + 3] = o5_3;
            let b6 = 132 * (t0 + 6);
            part[h][w][b6 + d + 0] = o6_0;
            part[h][w][b6 + d + 1] = o6_1;
            part[h][w][b6 + d + 2] = o6_2;
            part[h][w][b6 + d + 3] = o6_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
              let mut x3 = big3;
              if l == 1 {
                x3 = total3;
              }
              stats[s][3][l] = x3;
              let mut x4 = big4;
              if l == 1 {
                x4 = total4;
              }
              stats[s][4][l] = x4;
              let mut x5 = big5;
              if l == 1 {
                x5 = total5;
              }
              stats[s][5][l] = x5;
              let mut x6 = big6;
              if l == 1 {
                x6 = total6;
              }
              stats[s][6][l] = x6;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
            part[h][w][132 * (t0 + 3) + 128 + l] = stats[s][3][l];
            part[h][w][132 * (t0 + 4) + 128 + l] = stats[s][4][l];
            part[h][w][132 * (t0 + 5) + 128 + l] = stats[s][5][l];
            part[h][w][132 * (t0 + 6) + 128 + l] = stats[s][6][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_parts` for 8 queries in a row: query t is at position pos + t, in q[t0 + t], and its part
/// w goes to part[h][w][132 (t0 + t) ..].
fn round_attention_parts_8(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, t0 : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe {
          Tensor<f32, [1, 8, 2], Memory::SMEM>::uninit()
        };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let last = pos + 7;
            let q0_0 = q[t0 + 0][h][d + 0] * scale;
            let q0_1 = q[t0 + 0][h][d + 1] * scale;
            let q0_2 = q[t0 + 0][h][d + 2] * scale;
            let q0_3 = q[t0 + 0][h][d + 3] * scale;
            let mut big0 : f32 = -3.0e38;
            let mut total0 : f32 = 0.0;
            let mut o0_0 : f32 = 0.0;
            let mut o0_1 : f32 = 0.0;
            let mut o0_2 : f32 = 0.0;
            let mut o0_3 : f32 = 0.0;
            let q1_0 = q[t0 + 1][h][d + 0] * scale;
            let q1_1 = q[t0 + 1][h][d + 1] * scale;
            let q1_2 = q[t0 + 1][h][d + 2] * scale;
            let q1_3 = q[t0 + 1][h][d + 3] * scale;
            let mut big1 : f32 = -3.0e38;
            let mut total1 : f32 = 0.0;
            let mut o1_0 : f32 = 0.0;
            let mut o1_1 : f32 = 0.0;
            let mut o1_2 : f32 = 0.0;
            let mut o1_3 : f32 = 0.0;
            let q2_0 = q[t0 + 2][h][d + 0] * scale;
            let q2_1 = q[t0 + 2][h][d + 1] * scale;
            let q2_2 = q[t0 + 2][h][d + 2] * scale;
            let q2_3 = q[t0 + 2][h][d + 3] * scale;
            let mut big2 : f32 = -3.0e38;
            let mut total2 : f32 = 0.0;
            let mut o2_0 : f32 = 0.0;
            let mut o2_1 : f32 = 0.0;
            let mut o2_2 : f32 = 0.0;
            let mut o2_3 : f32 = 0.0;
            let q3_0 = q[t0 + 3][h][d + 0] * scale;
            let q3_1 = q[t0 + 3][h][d + 1] * scale;
            let q3_2 = q[t0 + 3][h][d + 2] * scale;
            let q3_3 = q[t0 + 3][h][d + 3] * scale;
            let mut big3 : f32 = -3.0e38;
            let mut total3 : f32 = 0.0;
            let mut o3_0 : f32 = 0.0;
            let mut o3_1 : f32 = 0.0;
            let mut o3_2 : f32 = 0.0;
            let mut o3_3 : f32 = 0.0;
            let q4_0 = q[t0 + 4][h][d + 0] * scale;
            let q4_1 = q[t0 + 4][h][d + 1] * scale;
            let q4_2 = q[t0 + 4][h][d + 2] * scale;
            let q4_3 = q[t0 + 4][h][d + 3] * scale;
            let mut big4 : f32 = -3.0e38;
            let mut total4 : f32 = 0.0;
            let mut o4_0 : f32 = 0.0;
            let mut o4_1 : f32 = 0.0;
            let mut o4_2 : f32 = 0.0;
            let mut o4_3 : f32 = 0.0;
            let q5_0 = q[t0 + 5][h][d + 0] * scale;
            let q5_1 = q[t0 + 5][h][d + 1] * scale;
            let q5_2 = q[t0 + 5][h][d + 2] * scale;
            let q5_3 = q[t0 + 5][h][d + 3] * scale;
            let mut big5 : f32 = -3.0e38;
            let mut total5 : f32 = 0.0;
            let mut o5_0 : f32 = 0.0;
            let mut o5_1 : f32 = 0.0;
            let mut o5_2 : f32 = 0.0;
            let mut o5_3 : f32 = 0.0;
            let q6_0 = q[t0 + 6][h][d + 0] * scale;
            let q6_1 = q[t0 + 6][h][d + 1] * scale;
            let q6_2 = q[t0 + 6][h][d + 2] * scale;
            let q6_3 = q[t0 + 6][h][d + 3] * scale;
            let mut big6 : f32 = -3.0e38;
            let mut total6 : f32 = 0.0;
            let mut o6_0 : f32 = 0.0;
            let mut o6_1 : f32 = 0.0;
            let mut o6_2 : f32 = 0.0;
            let mut o6_3 : f32 = 0.0;
            let q7_0 = q[t0 + 7][h][d + 0] * scale;
            let q7_1 = q[t0 + 7][h][d + 1] * scale;
            let q7_2 = q[t0 + 7][h][d + 2] * scale;
            let q7_3 = q[t0 + 7][h][d + 3] * scale;
            let mut big7 : f32 = -3.0e38;
            let mut total7 : f32 = 0.0;
            let mut o7_0 : f32 = 0.0;
            let mut o7_1 : f32 = 0.0;
            let mut o7_2 : f32 = 0.0;
            let mut o7_3 : f32 = 0.0;
            let chunks = (last + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine0 : f32 = -3.0e38;
              let mut mine1 : f32 = -3.0e38;
              let mut mine2 : f32 = -3.0e38;
              let mut mine3 : f32 = -3.0e38;
              let mut mine4 : f32 = -3.0e38;
              let mut mine5 : f32 = -3.0e38;
              let mut mine6 : f32 = -3.0e38;
              let mut mine7 : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let k0 = half_at(k_cache, kept, g, d, 0);
                let k1 = half_at(k_cache, kept, g, d, 1);
                let k2 = half_at(k_cache, kept, g, d, 2);
                let k3 = half_at(k_cache, kept, g, d, 3);
                let mut score0 = lane_sum(k0 * q0_0 + k1 * q0_1 + k2 * q0_2 + k3 * q0_3);
                if row > pos + 0 {
                  score0 = -3.0e38;
                }
                let mut score1 = lane_sum(k0 * q1_0 + k1 * q1_1 + k2 * q1_2 + k3 * q1_3);
                if row > pos + 1 {
                  score1 = -3.0e38;
                }
                let mut score2 = lane_sum(k0 * q2_0 + k1 * q2_1 + k2 * q2_2 + k3 * q2_3);
                if row > pos + 2 {
                  score2 = -3.0e38;
                }
                let mut score3 = lane_sum(k0 * q3_0 + k1 * q3_1 + k2 * q3_2 + k3 * q3_3);
                if row > pos + 3 {
                  score3 = -3.0e38;
                }
                let mut score4 = lane_sum(k0 * q4_0 + k1 * q4_1 + k2 * q4_2 + k3 * q4_3);
                if row > pos + 4 {
                  score4 = -3.0e38;
                }
                let mut score5 = lane_sum(k0 * q5_0 + k1 * q5_1 + k2 * q5_2 + k3 * q5_3);
                if row > pos + 5 {
                  score5 = -3.0e38;
                }
                let mut score6 = lane_sum(k0 * q6_0 + k1 * q6_1 + k2 * q6_2 + k3 * q6_3);
                if row > pos + 6 {
                  score6 = -3.0e38;
                }
                let mut score7 = lane_sum(k0 * q7_0 + k1 * q7_1 + k2 * q7_2 + k3 * q7_3);
                if row > pos + 7 {
                  score7 = -3.0e38;
                }
                if r == l {
                  mine0 = score0;
                  mine1 = score1;
                  mine2 = score2;
                  mine3 = score3;
                  mine4 = score4;
                  mine5 = score5;
                  mine6 = score6;
                  mine7 = score7;
                }
              }
              let mut p0 : f32 = 0.0;
              if c < (pos + 0 + 32) / 32 {
                let top = big0.max(lane_max(mine0));
                let shrink = (big0 - top).fast_exp();
                p0 = (mine0 - top).fast_exp();
                total0 = total0 * shrink + lane_sum(p0);
                o0_0 = o0_0 * shrink;
                o0_1 = o0_1 * shrink;
                o0_2 = o0_2 * shrink;
                o0_3 = o0_3 * shrink;
                big0 = top;
              }
              let mut p1 : f32 = 0.0;
              if c < (pos + 1 + 32) / 32 {
                let top = big1.max(lane_max(mine1));
                let shrink = (big1 - top).fast_exp();
                p1 = (mine1 - top).fast_exp();
                total1 = total1 * shrink + lane_sum(p1);
                o1_0 = o1_0 * shrink;
                o1_1 = o1_1 * shrink;
                o1_2 = o1_2 * shrink;
                o1_3 = o1_3 * shrink;
                big1 = top;
              }
              let mut p2 : f32 = 0.0;
              if c < (pos + 2 + 32) / 32 {
                let top = big2.max(lane_max(mine2));
                let shrink = (big2 - top).fast_exp();
                p2 = (mine2 - top).fast_exp();
                total2 = total2 * shrink + lane_sum(p2);
                o2_0 = o2_0 * shrink;
                o2_1 = o2_1 * shrink;
                o2_2 = o2_2 * shrink;
                o2_3 = o2_3 * shrink;
                big2 = top;
              }
              let mut p3 : f32 = 0.0;
              if c < (pos + 3 + 32) / 32 {
                let top = big3.max(lane_max(mine3));
                let shrink = (big3 - top).fast_exp();
                p3 = (mine3 - top).fast_exp();
                total3 = total3 * shrink + lane_sum(p3);
                o3_0 = o3_0 * shrink;
                o3_1 = o3_1 * shrink;
                o3_2 = o3_2 * shrink;
                o3_3 = o3_3 * shrink;
                big3 = top;
              }
              let mut p4 : f32 = 0.0;
              if c < (pos + 4 + 32) / 32 {
                let top = big4.max(lane_max(mine4));
                let shrink = (big4 - top).fast_exp();
                p4 = (mine4 - top).fast_exp();
                total4 = total4 * shrink + lane_sum(p4);
                o4_0 = o4_0 * shrink;
                o4_1 = o4_1 * shrink;
                o4_2 = o4_2 * shrink;
                o4_3 = o4_3 * shrink;
                big4 = top;
              }
              let mut p5 : f32 = 0.0;
              if c < (pos + 5 + 32) / 32 {
                let top = big5.max(lane_max(mine5));
                let shrink = (big5 - top).fast_exp();
                p5 = (mine5 - top).fast_exp();
                total5 = total5 * shrink + lane_sum(p5);
                o5_0 = o5_0 * shrink;
                o5_1 = o5_1 * shrink;
                o5_2 = o5_2 * shrink;
                o5_3 = o5_3 * shrink;
                big5 = top;
              }
              let mut p6 : f32 = 0.0;
              if c < (pos + 6 + 32) / 32 {
                let top = big6.max(lane_max(mine6));
                let shrink = (big6 - top).fast_exp();
                p6 = (mine6 - top).fast_exp();
                total6 = total6 * shrink + lane_sum(p6);
                o6_0 = o6_0 * shrink;
                o6_1 = o6_1 * shrink;
                o6_2 = o6_2 * shrink;
                o6_3 = o6_3 * shrink;
                big6 = top;
              }
              let mut p7 : f32 = 0.0;
              if c < (pos + 7 + 32) / 32 {
                let top = big7.max(lane_max(mine7));
                let shrink = (big7 - top).fast_exp();
                p7 = (mine7 - top).fast_exp();
                total7 = total7 * shrink + lane_sum(p7);
                o7_0 = o7_0 * shrink;
                o7_1 = o7_1 * shrink;
                o7_2 = o7_2 * shrink;
                o7_3 = o7_3 * shrink;
                big7 = top;
              }
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > last {
                  kept = last;
                }
                let pr0 = lane_value(p0, r);
                o0_0 = fused(half_at(v_cache, kept, g, d, 0), pr0, o0_0);
                o0_1 = fused(half_at(v_cache, kept, g, d, 1), pr0, o0_1);
                o0_2 = fused(half_at(v_cache, kept, g, d, 2), pr0, o0_2);
                o0_3 = fused(half_at(v_cache, kept, g, d, 3), pr0, o0_3);
                let pr1 = lane_value(p1, r);
                o1_0 = fused(half_at(v_cache, kept, g, d, 0), pr1, o1_0);
                o1_1 = fused(half_at(v_cache, kept, g, d, 1), pr1, o1_1);
                o1_2 = fused(half_at(v_cache, kept, g, d, 2), pr1, o1_2);
                o1_3 = fused(half_at(v_cache, kept, g, d, 3), pr1, o1_3);
                let pr2 = lane_value(p2, r);
                o2_0 = fused(half_at(v_cache, kept, g, d, 0), pr2, o2_0);
                o2_1 = fused(half_at(v_cache, kept, g, d, 1), pr2, o2_1);
                o2_2 = fused(half_at(v_cache, kept, g, d, 2), pr2, o2_2);
                o2_3 = fused(half_at(v_cache, kept, g, d, 3), pr2, o2_3);
                let pr3 = lane_value(p3, r);
                o3_0 = fused(half_at(v_cache, kept, g, d, 0), pr3, o3_0);
                o3_1 = fused(half_at(v_cache, kept, g, d, 1), pr3, o3_1);
                o3_2 = fused(half_at(v_cache, kept, g, d, 2), pr3, o3_2);
                o3_3 = fused(half_at(v_cache, kept, g, d, 3), pr3, o3_3);
                let pr4 = lane_value(p4, r);
                o4_0 = fused(half_at(v_cache, kept, g, d, 0), pr4, o4_0);
                o4_1 = fused(half_at(v_cache, kept, g, d, 1), pr4, o4_1);
                o4_2 = fused(half_at(v_cache, kept, g, d, 2), pr4, o4_2);
                o4_3 = fused(half_at(v_cache, kept, g, d, 3), pr4, o4_3);
                let pr5 = lane_value(p5, r);
                o5_0 = fused(half_at(v_cache, kept, g, d, 0), pr5, o5_0);
                o5_1 = fused(half_at(v_cache, kept, g, d, 1), pr5, o5_1);
                o5_2 = fused(half_at(v_cache, kept, g, d, 2), pr5, o5_2);
                o5_3 = fused(half_at(v_cache, kept, g, d, 3), pr5, o5_3);
                let pr6 = lane_value(p6, r);
                o6_0 = fused(half_at(v_cache, kept, g, d, 0), pr6, o6_0);
                o6_1 = fused(half_at(v_cache, kept, g, d, 1), pr6, o6_1);
                o6_2 = fused(half_at(v_cache, kept, g, d, 2), pr6, o6_2);
                o6_3 = fused(half_at(v_cache, kept, g, d, 3), pr6, o6_3);
                let pr7 = lane_value(p7, r);
                o7_0 = fused(half_at(v_cache, kept, g, d, 0), pr7, o7_0);
                o7_1 = fused(half_at(v_cache, kept, g, d, 1), pr7, o7_1);
                o7_2 = fused(half_at(v_cache, kept, g, d, 2), pr7, o7_2);
                o7_3 = fused(half_at(v_cache, kept, g, d, 3), pr7, o7_3);
              }
              c = c + nwg;
            }
            let b0 = 132 * (t0 + 0);
            part[h][w][b0 + d + 0] = o0_0;
            part[h][w][b0 + d + 1] = o0_1;
            part[h][w][b0 + d + 2] = o0_2;
            part[h][w][b0 + d + 3] = o0_3;
            let b1 = 132 * (t0 + 1);
            part[h][w][b1 + d + 0] = o1_0;
            part[h][w][b1 + d + 1] = o1_1;
            part[h][w][b1 + d + 2] = o1_2;
            part[h][w][b1 + d + 3] = o1_3;
            let b2 = 132 * (t0 + 2);
            part[h][w][b2 + d + 0] = o2_0;
            part[h][w][b2 + d + 1] = o2_1;
            part[h][w][b2 + d + 2] = o2_2;
            part[h][w][b2 + d + 3] = o2_3;
            let b3 = 132 * (t0 + 3);
            part[h][w][b3 + d + 0] = o3_0;
            part[h][w][b3 + d + 1] = o3_1;
            part[h][w][b3 + d + 2] = o3_2;
            part[h][w][b3 + d + 3] = o3_3;
            let b4 = 132 * (t0 + 4);
            part[h][w][b4 + d + 0] = o4_0;
            part[h][w][b4 + d + 1] = o4_1;
            part[h][w][b4 + d + 2] = o4_2;
            part[h][w][b4 + d + 3] = o4_3;
            let b5 = 132 * (t0 + 5);
            part[h][w][b5 + d + 0] = o5_0;
            part[h][w][b5 + d + 1] = o5_1;
            part[h][w][b5 + d + 2] = o5_2;
            part[h][w][b5 + d + 3] = o5_3;
            let b6 = 132 * (t0 + 6);
            part[h][w][b6 + d + 0] = o6_0;
            part[h][w][b6 + d + 1] = o6_1;
            part[h][w][b6 + d + 2] = o6_2;
            part[h][w][b6 + d + 3] = o6_3;
            let b7 = 132 * (t0 + 7);
            part[h][w][b7 + d + 0] = o7_0;
            part[h][w][b7 + d + 1] = o7_1;
            part[h][w][b7 + d + 2] = o7_2;
            part[h][w][b7 + d + 3] = o7_3;
            // Every lane has the same largest score and sum of the weights of a query. Lanes 0 and 1 keep them
            // for the next loop.
            if l < 2 {
              let mut x0 = big0;
              if l == 1 {
                x0 = total0;
              }
              stats[s][0][l] = x0;
              let mut x1 = big1;
              if l == 1 {
                x1 = total1;
              }
              stats[s][1][l] = x1;
              let mut x2 = big2;
              if l == 1 {
                x2 = total2;
              }
              stats[s][2][l] = x2;
              let mut x3 = big3;
              if l == 1 {
                x3 = total3;
              }
              stats[s][3][l] = x3;
              let mut x4 = big4;
              if l == 1 {
                x4 = total4;
              }
              stats[s][4][l] = x4;
              let mut x5 = big5;
              if l == 1 {
                x5 = total5;
              }
              stats[s][5][l] = x5;
              let mut x6 = big6;
              if l == 1 {
                x6 = total6;
              }
              stats[s][6][l] = x6;
              let mut x7 = big7;
              if l == 1 {
                x7 = total7;
              }
              stats[s][7][l] = x7;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][132 * (t0 + 0) + 128 + l] = stats[s][0][l];
            part[h][w][132 * (t0 + 1) + 128 + l] = stats[s][1][l];
            part[h][w][132 * (t0 + 2) + 128 + l] = stats[s][2][l];
            part[h][w][132 * (t0 + 3) + 128 + l] = stats[s][3][l];
            part[h][w][132 * (t0 + 4) + 128 + l] = stats[s][4][l];
            part[h][w][132 * (t0 + 5) + 128 + l] = stats[s][5][l];
            part[h][w][132 * (t0 + 6) + 128 + l] = stats[s][6][l];
            part[h][w][132 * (t0 + 7) + 128 + l] = stats[s][7][l];
          }
        }
      }
    }
  }
  return;
}

/// `vec_attention_merge` for queries t0 to t0 + n - 1, whose parts are at part[h][w][132 t ..]: out[t][h]
/// gets the attention of head h of query t. The code is that of `vec_attention_merge`, with the parts of query
/// t at 132 t, so a query gives the same bits in both.
fn round_attention_merge(out : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, part : &Tensor<f32, [?, ?, ?], Memory::HBM>, parts : i32, t0 : i32, n : i32, q_heads : i32) -> void {
  spawn on(Topology::Device) {
    for i in 0..n across blocks {
      for h in 0..q_heads across blocks {
        for dq in 0..4 across blocks {
          let t = t0 + i;
          let b = 132 * t;
          let mut top = unsafe {
            Tensor<f32, [1, 32], Memory::SMEM>::uninit()
          };
          for s in 0..1 across subgroups {
            for l in 0..32 across lanes(32) {
              let mut m : f32 = -3.0e38;
              let mut c = l;
              while c < parts {
                m = m.max(part[h][c][b + 128]);
                c = c + 32;
              }
              top[s][l] = m;
            }
            let big = lanes::max(&top[s], 32);
            for l in 0..32 across lanes(32) {
              let d = dq * 32 + l;
              let mut total : f32 = 0.0;
              let mut acc : f32 = 0.0;
              for c in 0..parts {
                let w = (part[h][c][b + 128] - big).fast_exp();
                total = total + w * part[h][c][b + 129];
                acc = acc + w * part[h][c][b + d];
              }
              out[t][h][d] = acc / total;
            }
          }
        }
      }
    }
  }
  return;
}
