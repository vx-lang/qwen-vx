// Encodes texts with `src/tokenizer.vx`, or decodes token ids, for the tests of the tokenizer:
//
//   vxc tests/tokenize.vx --package qwen=src --host default --machine m4-uma.vx -- TOKENIZER TEXTS
//   vxc tests/tokenize.vx ... -- TOKENIZER IDS --decode
//
// TEXTS holds texts separated by a NUL byte. For each text, the program prints its ids on one
// line, separated by commas. IDS holds one line of comma-separated ids for each text, and the
// program writes the bytes of each line's tokens, each text followed by a NUL byte.
// `scripts/test_tokenizer.py` compares both with the `tokenizers` package. The RUN lines check a
// tiny tokenizer against the ids that `tokenizers` gave for it. The decoded bytes have NUL bytes,
// so `grep -a` reads them as text: GNU grep prints no line of an input that it takes as binary.
//
// RUN: python3 %S/../scripts/make_tiny_tokenizer.py %t.json > /dev/null
// RUN: python3 %S/../scripts/convert_tokenizer.py --any-unicode %t.json %t.vxt > /dev/null
// RUN: python3 %S/../scripts/make_tiny_tokenizer.py --texts %t.texts
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx -- %t.vxt %t.texts | FileCheck %s
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx -- %t.vxt %t.texts | grep -v '^\[JIT\]' | sed '/^texts=/,$d' > %t.ids
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx -- %t.vxt %t.ids --decode | grep -a -v '^\[JIT\]' > %t.decoded
// RUN: python3 %S/../scripts/make_tiny_tokenizer.py --check-decoded %t.decoded | FileCheck %s --check-prefix=DECODE
//
// The ids that the `tokenizers` package gave for the texts of `make_tiny_tokenizer.py --texts`:
// CHECK: {{^}}383,274,276,389,259,295,296{{$}}
// CHECK-NEXT: {{^}}386,393,362,46,32,84,72,69,89,39,82,69,32,39,76,76,32,39,86,101,32,39,100,32,39,109,32,39,116,32,39,83,301,260,356,111,110,103,290,39,398,114,44,32,120,39,83,263,116,117,114,110,32,120,393,116,258{{$}}
// CHECK-NEXT: {{^}}120,61,49,59,121,61,61,50,33,33,304,10,122,32,49,97,98,99,345,296,372,32,49,347{{$}}
// CHECK-NEXT: {{^}}256,314,263,101,323,266,265,44,313,299,321,98,9,97,110,100,257,119,111,299,116,260,363,110,100,256{{$}}
// CHECK-NEXT: {{^}}97,13,10,13,10,32,366,32,304,32,32,99,10{{$}}
// CHECK-NEXT: {{^}}401,117,115,275,10,87,114,105,116,101,32,82,117,115,116,46,402,10,401,97,115,115,105,115,116,97,110,116,10,403{{$}}
// CHECK-NEXT: {{^}}60,124,105,109,95,115,116,97,114,116,32,402,402,120,400{{$}}
// CHECK-NEXT: {{^}}99,97,102,195,169,32,99,97,102,195,169,32,225,186,173,32,225,186,173,299,204,133,204,129,32,195,133,32,234,176,129,32,234,176,129,32,224,164,149,224,164,188{{$}}
// CHECK-NEXT: {{^}}230,151,165,230,156,172,232,170,158,32,49,50,51,32,217,161,217,162,217,163,32,226,133,167,32,120,194,178,32,240,159,152,128,240,159,145,141,240,159,143,189,32,194,160,227,128,128,101,110,100{{$}}
// CHECK-NEXT: {{^}}206,145,206,184,206,174,206,189,206,177,32,208,156,208,190,209,129,208,186,208,178,208,176,32,215,169,215,156,215,149,215,157,32,217,133,216,177,216,173,216,168,216,167{{$}}
// CHECK-EMPTY:
// CHECK-NEXT: {{^}}texts=11;{{$}}
//
// DECODE: {{^}}decoded 11 texts, 11 equal to the NFC form of the text{{$}}
import core::convert;
import core::ptr;
import std::vec;
import qwen::tokenizer;

/// Whether the C string `a` is `b`.
fn same_text(a : *const i8, b : *const i8) -> bool {
  let n = unsafe { strlen(a) };
  if n != unsafe { strlen(b) } {
    return false;
  }
  let mut i : i64 = 0;
  while i < n {
    if unsafe { a[i] } != unsafe { b[i] } {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// Prints the ids of each text of `input`. A file with n NUL bytes holds n + 1 texts.
fn encode_all(t : &Tokenizer, input : &Text) -> i32 {
  let mut texts = 0;
  let mut start : i64 = 0;
  let mut i : i64 = 0;
  while i <= input.length {
    let at_end = i == input.length;
    let mut separator = at_end;
    if !at_end {
      separator = unsafe { input.bytes[i] } == 0 as i8;
    }
    if separator {
      let ids = encode(t, offset_mut(input.bytes, start), i - start);
      for k in 0..ids.len() {
        if k > 0 {
          print!(",");
        }
        print!("{}", ids.get(k));
      }
      println!("");
      texts = texts + 1;
      start = i + 1;
    }
    i = i + 1;
  }
  println!("texts={};", texts);
  return 0;
}

/// Writes the bytes of the tokens of each line of `input`, and a NUL byte after each line.
fn decode_all(t : &Tokenizer, input : &Text) -> i32 {
  let mut value = 0;
  let mut digits = 0;
  let mut i : i64 = 0;
  while i < input.length {
    let ch : i32 = i32::from(unsafe { input.bytes[i] });
    if ch >= 48 && ch <= 57 {
      value = value * 10 + (ch - 48);
      digits = digits + 1;
    } else {
      if digits > 0 {
        write_token(t, value);
      }
      value = 0;
      digits = 0;
      if ch == 10 {
        // The one byte of the empty C string is its NUL.
        write_bytes("", 1);
      }
    }
    i = i + 1;
  }
  return 0;
}

fn main(argc : i32, argv : *mut *mut i8) -> i32 {
  assert(argc == 3 || argc == 4, "give: TOKENIZER TEXTS, or TOKENIZER IDS --decode");
  let t = load_tokenizer(unsafe { argv[1] });
  let input = read_text_file(unsafe { argv[2] });
  if argc == 4 {
    assert(same_text(unsafe { argv[3] }, "--decode"), "give: TOKENIZER IDS --decode");
    return decode_all(&t, &input);
  }
  return encode_all(&t, &input);
}
