// Throwaway: broken copies of vec_attention_parts, each run through the checks of
// tests/decode_attention.vx. Each line must show some values off.
//
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx | grep off; false
import core::num;
import qwen::attention;

fn parts_no_mask(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe { Tensor<f32, [1, 2], Memory::SMEM>::uninit() };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let q0 = q[h][d] * scale;
            let q1 = q[h][d + 1] * scale;
            let q2 = q[h][d + 2] * scale;
            let q3 = q[h][d + 3] * scale;
            let mut big : f32 = -3.0e38;
            let mut total : f32 = 0.0;
            let mut o0 : f32 = 0.0;
            let mut o1 : f32 = 0.0;
            let mut o2 : f32 = 0.0;
            let mut o3 : f32 = 0.0;
            let chunks = (pos + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > pos {
                  kept = pos;
                }
                let mut score = lane_sum(dot4(k_cache, kept, g, d, q0, q1, q2, q3));
                if r == l {
                  mine = score;
                }
              }
              let top = big.max(lane_max(mine));
              let shrink = (big - top).fast_exp();
              let p = (mine - top).fast_exp();
              total = total * shrink + lane_sum(p);
              o0 = o0 * shrink;
              o1 = o1 * shrink;
              o2 = o2 * shrink;
              o3 = o3 * shrink;
              for r in 0..32 {
                let row = r0 + r;
                let mut kept = row;
                if row > pos {
                  kept = pos;
                }
                let pr = lane_value(p, r);
                o0 = fused(half_at(v_cache, kept, g, d, 0), pr, o0);
                o1 = fused(half_at(v_cache, kept, g, d, 1), pr, o1);
                o2 = fused(half_at(v_cache, kept, g, d, 2), pr, o2);
                o3 = fused(half_at(v_cache, kept, g, d, 3), pr, o3);
              }
              big = top;
              c = c + nwg;
            }
            part[h][w][d] = o0;
            part[h][w][d + 1] = o1;
            part[h][w][d + 2] = o2;
            part[h][w][d + 3] = o3;
            // Every lane has the same largest score and sum of the weights. Lanes 0 and 1 keep them for the
            // next loop.
            if l < 2 {
              let mut x = big;
              if l == 1 {
                x = total;
              }
              stats[s][l] = x;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][128 + l] = stats[s][l];
          }
        }
      }
    }
  }
  return;
}

fn parts_no_clamp(part : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, q : &Tensor<f32, [?, ?], Memory::HBM>, k_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, v_cache : &Tensor<f16, [?, ?, ?], Memory::HBM>, pos : i32, q_heads : i32, group : i32, nwg : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..q_heads across blocks {
      for w in 0..nwg across blocks {
        let mut stats = unsafe { Tensor<f32, [1, 2], Memory::SMEM>::uninit() };
        for s in 0..1 across subgroups {
          for l in 0..32 across lanes(32) {
            let g = h / group;
            let d = 4 * l;
            let q0 = q[h][d] * scale;
            let q1 = q[h][d + 1] * scale;
            let q2 = q[h][d + 2] * scale;
            let q3 = q[h][d + 3] * scale;
            let mut big : f32 = -3.0e38;
            let mut total : f32 = 0.0;
            let mut o0 : f32 = 0.0;
            let mut o1 : f32 = 0.0;
            let mut o2 : f32 = 0.0;
            let mut o3 : f32 = 0.0;
            let chunks = (pos + 32) / 32;
            let mut c = w;
            while c < chunks {
              let r0 = c * 32;
              let mut mine : f32 = -3.0e38;
              for r in 0..32 {
                let row = r0 + r;
                let kept = row;
                let mut score = lane_sum(dot4(k_cache, kept, g, d, q0, q1, q2, q3));
                if row > pos {
                  score = -3.0e38;
                }
                if r == l {
                  mine = score;
                }
              }
              let top = big.max(lane_max(mine));
              let shrink = (big - top).fast_exp();
              let p = (mine - top).fast_exp();
              total = total * shrink + lane_sum(p);
              o0 = o0 * shrink;
              o1 = o1 * shrink;
              o2 = o2 * shrink;
              o3 = o3 * shrink;
              for r in 0..32 {
                let row = r0 + r;
                let kept = row;
                let pr = lane_value(p, r);
                o0 = fused(half_at(v_cache, kept, g, d, 0), pr, o0);
                o1 = fused(half_at(v_cache, kept, g, d, 1), pr, o1);
                o2 = fused(half_at(v_cache, kept, g, d, 2), pr, o2);
                o3 = fused(half_at(v_cache, kept, g, d, 3), pr, o3);
              }
              big = top;
              c = c + nwg;
            }
            part[h][w][d] = o0;
            part[h][w][d + 1] = o1;
            part[h][w][d + 2] = o2;
            part[h][w][d + 3] = o3;
            // Every lane has the same largest score and sum of the weights. Lanes 0 and 1 keep them for the
            // next loop.
            if l < 2 {
              let mut x = big;
              if l == 1 {
                x = total;
              }
              stats[s][l] = x;
            }
          }
          for l in 0..2 across lanes(32) {
            part[h][w][128 + l] = stats[s][l];
          }
        }
      }
    }
  }
  return;
}

