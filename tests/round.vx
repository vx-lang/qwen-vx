// The kernels of a round (src/round.vx) against the kernels of a generated token, on random
// values with the shapes of Qwen3-30B-A3B: 32 heads of Q, 4 of K and V, and head_dim 128. Each
// value of a round must equal the value of the kernel of one token bit for bit. The rounds start
// at position 0, in the first 32 positions, after 1,000 positions, and across position 2,048,
// where `vec_attention` goes from 32 to 64 SIMD groups. Rounds of more than 8 positions run their
// attention in pieces of at most 4. Then `matvec_q6_rows` and
// `matvec_q6_rows4` against `matvec_q6`.
//
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx | FileCheck %s
//
// CHECK: {{^}}rope start 0 n 8: 0 differ{{$}}
// CHECK: {{^}}attention start 0 n 8: 0 differ{{$}}
// CHECK: {{^}}rope start 21 n 3: 0 differ{{$}}
// CHECK: {{^}}attention start 21 n 3: 0 differ{{$}}
// CHECK: {{^}}rope start 1000 n 5: 0 differ{{$}}
// CHECK: {{^}}attention start 1000 n 5: 0 differ{{$}}
// CHECK: {{^}}rope start 2044 n 8: 0 differ{{$}}
// CHECK: {{^}}attention start 2044 n 8: 0 differ{{$}}
// CHECK: {{^}}rope start 2100 n 1: 0 differ{{$}}
// CHECK: {{^}}attention start 2100 n 1: 0 differ{{$}}
// CHECK: {{^}}rope start 500 n 16: 0 differ{{$}}
// CHECK: {{^}}attention start 500 n 16: 0 differ{{$}}
// CHECK: {{^}}rope start 2035 n 16: 0 differ{{$}}
// CHECK: {{^}}attention start 2035 n 16: 0 differ{{$}}
// CHECK: {{^}}q6 n 1: 0 differ{{$}}
// CHECK: {{^}}q6 rows4 n 1: 0 differ{{$}}
// CHECK: {{^}}q6 n 5: 0 differ{{$}}
// CHECK: {{^}}q6 rows4 n 5: 0 differ{{$}}
// CHECK: {{^}}q6 n 8: 0 differ{{$}}
// CHECK: {{^}}q6 rows4 n 8: 0 differ{{$}}
// CHECK: {{^}}q6 n 13: 0 differ{{$}}
// CHECK: {{^}}q6 rows4 n 13: 0 differ{{$}}
// CHECK: {{^}}q6 n 16: 0 differ{{$}}
// CHECK: {{^}}q6 rows4 n 16: 0 differ{{$}}
import core::convert;
import std::nn;
import std::vec;
import qwen::attention;
import qwen::round;
import qwen::q6;

const Q_HEADS : i32 = 32;
const KV_HEADS : i32 = 4;
const HEAD_DIM : i32 = 128;
const MAX_SEQ : i32 = 2112;

/// A number in [-1, 1) from the state `s` of a linear congruential generator.
fn random(s : &mut i64) -> f32 {
  *s = (*s * 1103515245 + 12345) % 2147483648;
  return (*s as f32) / 1073741824.0 - 1.0;
}

fn random_3d(s : &mut i64, a : i32, b : i32, c : i32) -> Tensor<f32, [?, ?, ?]> {
  let mut x = Tensor<f32>([a, b, c]);
  for i in 0..a {
    for j in 0..b {
      for k in 0..c {
        x[i][j][k] = random(s);
      }
    }
  }
  return x;
}

/// Row t of x, as a tensor of [b, c].
fn row(x : &Tensor<f32, [?, ?, ?]>, t : i32) -> Tensor<f32, [?, ?], Memory::HBM> {
  let mut y = Tensor<f32>([x.extent(1), x.extent(2)]);
  for j in 0..x.extent(1) {
    for k in 0..x.extent(2) {
      y[j][k] = x[t][j][k];
    }
  }
  return transfer(y, Memory::HBM);
}

/// The values of a and b at [t, h, i] that differ, for t below n.
fn differ_f32(a : &Tensor<f32, [?, ?, ?], Memory::HBM>, b : &Vec<f32>, n : i32, heads : i32) -> i32 {
  let h = transfer(a, Memory::CPU_DRAM);
  let mut count = 0;
  for t in 0..n {
    for j in 0..heads {
      for i in 0..HEAD_DIM {
        if h[t][j][i] != b[(t * heads + j) * HEAD_DIM + i] {
          count = count + 1;
        }
      }
    }
  }
  return count;
}

/// The values of two KV caches at positions start to start + n - 1 that differ.
fn differ_cache(a : &Tensor<f16, [?, ?, ?], Memory::HBM>, b : &Tensor<f16, [?, ?, ?], Memory::HBM>, start : i32, n : i32) -> i32 {
  let ha = transfer(a, Memory::CPU_DRAM);
  let hb = transfer(b, Memory::CPU_DRAM);
  let mut count = 0;
  for t in 0..n {
    for j in 0..KV_HEADS {
      for i in 0..HEAD_DIM {
        if (ha[start + t][j][i] as f32) != (hb[start + t][j][i] as f32) {
          count = count + 1;
        }
      }
    }
  }
  return count;
}

/// x in f16, in GPU memory.
fn to_cache(x : &Tensor<f32, [?, ?, ?]>) -> Tensor<f16, [?, ?, ?], Memory::HBM> {
  let mut h = Tensor<f16>([x.extent(0), x.extent(1), x.extent(2)]);
  for p in 0..x.extent(0) {
    for j in 0..x.extent(1) {
      for i in 0..x.extent(2) {
        h[p][j][i] = x[p][j][i] as f16;
      }
    }
  }
  return transfer(h, Memory::HBM);
}

fn push_all(out : &mut Vec<f32>, x : &Tensor<f32, [?, ?], Memory::HBM>) -> void {
  let h = transfer(x, Memory::CPU_DRAM);
  for j in 0..x.extent(0) {
    for i in 0..x.extent(1) {
      out.push(h[j][i]);
    }
  }
  return;
}

fn check(s : &mut i64, start : i32, n : i32) -> void {
  // The caches hold random rows before `start`. The kernels write the rows of the n positions.
  let cache_k = random_3d(s, MAX_SEQ, KV_HEADS, HEAD_DIM);
  let cache_v = random_3d(s, MAX_SEQ, KV_HEADS, HEAD_DIM);
  let mut k1 = to_cache(&cache_k);
  let mut v1 = to_cache(&cache_v);
  let mut kn = to_cache(&cache_k);
  let mut vn = to_cache(&cache_v);
  let q = random_3d(s, n, Q_HEADS, HEAD_DIM);
  let k = random_3d(s, n, KV_HEADS, HEAD_DIM);
  let v = random_3d(s, n, KV_HEADS, HEAD_DIM);
  let mut hq_norm = Tensor<bf16>([HEAD_DIM]);
  let mut hk_norm = Tensor<bf16>([HEAD_DIM]);
  for i in 0..HEAD_DIM {
    hq_norm[i] = (1.0 + random(s)) as bf16;
    hk_norm[i] = (1.0 + random(s)) as bf16;
  }
  let q_norm = transfer(hq_norm, Memory::HBM);
  let k_norm = transfer(hk_norm, Memory::HBM);
  let mut hcos = Tensor<f32>([MAX_SEQ, HEAD_DIM / 2]);
  let mut hsin = Tensor<f32>([MAX_SEQ, HEAD_DIM / 2]);
  for p in 0..MAX_SEQ {
    for i in 0..HEAD_DIM / 2 {
      hcos[p][i] = random(s);
      hsin[p][i] = random(s);
    }
  }
  let cos = transfer(hcos, Memory::HBM);
  let sin = transfer(hsin, Memory::HBM);
  let eps : f32 = 0.000001;

  // One token at a time.
  let mut q_turned = transfer(Tensor<f32>([Q_HEADS, HEAD_DIM]), Memory::HBM);
  let mut out = transfer(Tensor<f32>([Q_HEADS, HEAD_DIM]), Memory::HBM);
  let mut parts = transfer(vec_attention_scratch(Q_HEADS), Memory::HBM);
  let mut turned_one = Vec<f32>::new();
  let mut att_one = Vec<f32>::new();
  for t in 0..n {
    let qt = row(&q, t);
    let kt = row(&k, t);
    let vt = row(&v, t);
    norm_rope_and_store(&mut q_turned, &mut k1, &mut v1, &qt, &kt, &vt, &q_norm, &k_norm, &cos, &sin, start + t, Q_HEADS, KV_HEADS, HEAD_DIM, eps);
    push_all(&mut turned_one, &q_turned);
  }
  for t in 0..n {
    // The attention of each token over the rows of all n tokens' K and V that the round writes, as
    // the round sees them: the rows after the token do not count.
    let mut hq = Tensor<f32>([Q_HEADS, HEAD_DIM]);
    for j in 0..Q_HEADS {
      for i in 0..HEAD_DIM {
        hq[j][i] = turned_one[(t * Q_HEADS + j) * HEAD_DIM + i];
      }
    }
    let qt = transfer(hq, Memory::HBM);
    vec_attention(&mut out, &mut parts, &qt, &k1, &v1, start + t, Q_HEADS, KV_HEADS, HEAD_DIM);
    push_all(&mut att_one, &out);
  }

  // The round.
  let mut q_round = transfer(Tensor<f32>([n, Q_HEADS, HEAD_DIM]), Memory::HBM);
  let mut out_round = transfer(Tensor<f32>([n, Q_HEADS, HEAD_DIM]), Memory::HBM);
  let mut round_parts = transfer(round_attention_scratch(Q_HEADS), Memory::HBM);
  let qd = transfer(q, Memory::HBM);
  let kd = transfer(k, Memory::HBM);
  let vd = transfer(v, Memory::HBM);
  round_norm_rope_and_store(&mut q_round, &mut kn, &mut vn, &qd, &kd, &vd, &q_norm, &k_norm, &cos, &sin, start, n, Q_HEADS, KV_HEADS, HEAD_DIM, eps);
  round_attention(&mut out_round, &mut round_parts, &q_round, &kn, &vn, start, n, Q_HEADS, KV_HEADS, HEAD_DIM);

  let rope = differ_f32(&q_round, &turned_one, n, Q_HEADS) + differ_cache(&k1, &kn, start, n) + differ_cache(&v1, &vn, start, n);
  println!("rope start {} n {}: {} differ", start, n, rope);
  println!("attention start {} n {}: {} differ", start, n, differ_f32(&out_round, &att_one, n, Q_HEADS));
  return;
}

/// A random u32 from the state `s`.
fn random_word(s : &mut i64) -> u32 {
  *s = (*s * 1103515245 + 12345) % 2147483648;
  let lo = *s;
  *s = (*s * 1103515245 + 12345) % 2147483648;
  return ((lo % 65536) * 65536 + *s % 65536) as u32;
}

/// matvec_q6_rows of n random vectors against matvec_q6 of each, for a random matrix.
fn check_q6(s : &mut i64, n : i32) -> void {
  let rows = 64;
  let cols = 2048;
  let mut codes = Tensor<u32>([rows * cols / 8]);
  let mut high = Tensor<u32>([rows * cols / 16]);
  let mut scales = Tensor<f16>([rows * cols / 32]);
  for i in 0..rows * cols / 8 {
    codes[i] = random_word(s);
  }
  for i in 0..rows * cols / 16 {
    high[i] = random_word(s);
  }
  for i in 0..rows * cols / 32 {
    scales[i] = (random(s) * 0.01) as f16;
  }
  let dc = transfer(codes, Memory::HBM);
  let dh = transfer(high, Memory::HBM);
  let ds = transfer(scales, Memory::HBM);
  let mut hx = Tensor<f32>([n, cols]);
  for p in 0..n {
    for i in 0..cols {
      hx[p][i] = random(s);
    }
  }
  let mut y = transfer(Tensor<f32>([rows]), Memory::HBM);
  let mut one = Vec<f32>::new();
  for p in 0..n {
    let mut xp = Tensor<f32>([cols]);
    for i in 0..cols {
      xp[i] = hx[p][i];
    }
    let dx = transfer(xp, Memory::HBM);
    matvec_q6(&mut y, &dc, &dh, &ds, &dx, rows, cols);
    let h = transfer(&y, Memory::CPU_DRAM);
    for r in 0..rows {
      one.push(h[r]);
    }
  }
  let x = transfer(hx, Memory::HBM);
  let mut yn = transfer(Tensor<f32>([n, rows]), Memory::HBM);
  matvec_q6_rows(&mut yn, &dc, &dh, &ds, &x, n, rows, cols);
  let h = transfer(&yn, Memory::CPU_DRAM);
  let mut count = 0;
  for p in 0..n {
    for r in 0..rows {
      if h[p][r] != one[p * rows + r] {
        count = count + 1;
      }
    }
  }
  println!("q6 n {}: {} differ", n, count);
  matvec_q6_rows4(&mut yn, &dc, &dh, &ds, &x, n, rows, cols);
  let h4 = transfer(&yn, Memory::CPU_DRAM);
  let mut count4 = 0;
  for p in 0..n {
    for r in 0..rows {
      if h4[p][r].to_bits() != one[p * rows + r].to_bits() {
        count4 = count4 + 1;
      }
    }
  }
  println!("q6 rows4 n {}: {} differ", n, count4);
  return;
}

fn main() -> i32 {
  let mut s : i64 = 7;
  check(&mut s, 0, 8);
  check(&mut s, 21, 3);
  check(&mut s, 1000, 5);
  check(&mut s, 2044, 8);
  check(&mut s, 2100, 1);
  check(&mut s, 500, 16);
  check(&mut s, 2035, 16);
  check_q6(&mut s, 1);
  check_q6(&mut s, 5);
  check_q6(&mut s, 8);
  check_q6(&mut s, 13);
  check_q6(&mut s, 16);
  return 0;
}
