//===----------------------------------------------------------------------===//
// The merge of the attention parts, on random parts with the shapes of Qwen3-30B-A3B: 32 heads of Q,
// head_dim 128, and 32 or 64 parts. `vec_attention_merge` must match a merge in f64 on the CPU, to
// within 1e-5 of 1 + |value|. `round_attention_merge` must give the same bits as
// `vec_attention_merge` for each query of a round, also for a query that is not the first.
//
// RUN: vxc %s --package qwen=%S/../src --host default --machine $VX_FLEET/m4-uma.vx | FileCheck %s
//
// CHECK: {{^}}merge parts 32: 0 off{{$}}
// CHECK: {{^}}merge parts 64: 0 off{{$}}
// CHECK: {{^}}round merge parts 32 n 3: 0 differ{{$}}
// CHECK: {{^}}round merge parts 64 n 16: 0 differ{{$}}
import qwen::attention;
import qwen::round;

const Q_HEADS : i32 = 32;

/// A number in [-1, 1) from the state `s` of a linear congruential generator.
fn random(s : &mut i64) -> f32 {
  *s = (*s * 1103515245 + 12345) % 2147483648;
  return (*s as f32) / 1073741824.0 - 1.0;
}

/// Parts for `parts` SIMD groups of each head: the sum of V, then the largest score, then the sum of the
/// weights, which is above 0. The scores go from -60 to 60. In the even heads, the last part has the score
/// 150, so a merge that misses that part when it finds the largest score overflows.
fn random_parts(s : &mut i64, parts : i32) -> Tensor<f32, [?, ?, ?]> {
  let mut x = Tensor<f32>([Q_HEADS, 128, 132]);
  for h in 0..Q_HEADS {
    for c in 0..parts {
      for d in 0..128 {
        x[h][c][d] = 8.0 * random(s);
      }
      x[h][c][128] = 60.0 * random(s);
      x[h][c][129] = 1.5 + random(s);
    }
    if h % 2 == 0 {
      x[h][parts - 1][128] = 150.0;
    }
  }
  return x;
}

/// The merged attention of head h, value d, in f64.
fn merged(x : &Tensor<f32, [?, ?, ?]>, parts : i32, h : i32, d : i32) -> f64 {
  let mut big : f64 = -1.0e300;
  for c in 0..parts {
    big = big.max(x[h][c][128] as f64);
  }
  let mut total : f64 = 0.0;
  let mut acc : f64 = 0.0;
  for c in 0..parts {
    let w = ((x[h][c][128] as f64) - big).exp();
    total = total + w * (x[h][c][129] as f64);
    acc = acc + w * (x[h][c][d] as f64);
  }
  return acc / total;
}

fn check_merge(s : &mut i64, parts : i32) -> void {
  let x = random_parts(s, parts);
  let part = transfer(&x, Memory::HBM);
  let mut out = transfer(Tensor<f32>([Q_HEADS, 128]), Memory::HBM);
  vec_attention_merge(&mut out, &part, parts, Q_HEADS);
  let got = transfer(&out, Memory::CPU_DRAM);
  let mut off = 0;
  for h in 0..Q_HEADS {
    for d in 0..128 {
      let want = merged(&x, parts, h, d);
      // Written so that a NaN counts as off.
      if !(((got[h][d] as f64) - want).abs() <= 1.0e-5 * (1.0 + want.abs())) {
        off = off + 1;
      }
    }
  }
  println!("merge parts {}: {} off", parts, off);
  return;
}

/// n queries with parts of their own, merged by `round_attention_merge` in one call, against
/// `vec_attention_merge` for each query.
fn check_round(s : &mut i64, parts : i32, n : i32) -> void {
  let mut all = Tensor<f32>([Q_HEADS, 128, 16 * 132]);
  let mut want = Tensor<f32>([n, Q_HEADS, 128]);
  for t in 0..n {
    let x = random_parts(s, parts);
    for h in 0..Q_HEADS {
      for c in 0..parts {
        for k in 0..132 {
          all[h][c][132 * t + k] = x[h][c][k];
        }
      }
    }
    let part = transfer(&x, Memory::HBM);
    let mut out = transfer(Tensor<f32>([Q_HEADS, 128]), Memory::HBM);
    vec_attention_merge(&mut out, &part, parts, Q_HEADS);
    let one = transfer(&out, Memory::CPU_DRAM);
    for h in 0..Q_HEADS {
      for d in 0..128 {
        want[t][h][d] = one[h][d];
      }
    }
  }
  let part = transfer(&all, Memory::HBM);
  let mut out = transfer(Tensor<f32>([n, Q_HEADS, 128]), Memory::HBM);
  round_attention_merge(&mut out, &part, parts, 0, n, Q_HEADS);
  let got = transfer(&out, Memory::CPU_DRAM);
  let mut differ = 0;
  for t in 0..n {
    for h in 0..Q_HEADS {
      for d in 0..128 {
        if got[t][h][d] != want[t][h][d] {
          differ = differ + 1;
        }
      }
    }
  }
  println!("round merge parts {} n {}: {} differ", parts, n, differ);
  return;
}

fn main() -> i32 {
  let mut s : i64 = 7;
  check_merge(&mut s, 32);
  check_merge(&mut s, 64);
  check_round(&mut s, 32, 3);
  check_round(&mut s, 64, 16);
  return 0;
}
